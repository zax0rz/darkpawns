{
	auto_https off
}

:80 {
	# Route soviet to The Soviet
	@soviet {
		host soviet.labz0rz.com
	}
	handle @soviet {
		reverse_proxy localhost:4000
	}

	# Dark Pawns game (served by Go server)
	handle /game {
		redir /game/ permanent
	}
	handle /game/* {
		uri strip_prefix /game
		reverse_proxy localhost:4350
	}

	# Go game server routes
	handle /ws {
		reverse_proxy localhost:4350
	}
	handle /api/* {
		reverse_proxy localhost:4350
	}
	handle /openapi.json {
		reverse_proxy localhost:4350
	}
	handle /admin/* {
		reverse_proxy localhost:4350
	}
	handle /health {
		reverse_proxy localhost:4350
	}
	handle /metrics {
		reverse_proxy localhost:4350
	}

	# Serve the Markdown representation generated alongside each Hugo page.
	@markdown header Accept *text/markdown*
	handle @markdown {
		root * /srv/hugo/
		header Vary "Accept, Accept-Encoding"
		header Content-Type "text/markdown; charset=utf-8"
		try_files {path}index.md {path}/index.md {path}.md
		file_server
	}

	# Hugo static files (catch-all).
	handle {
		root * /srv/hugo/
		# Discovery headers for AI agents & crawlers (specification.website: HTTP Link headers)
		header Link "</llms.txt>; rel=\"llms-txt\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </index.xml>; rel=\"alternate\"; type=\"application/rss+xml\""
		header Vary "Accept, Accept-Encoding"
		try_files {path} {path}/index.html
		file_server
	}

	# Serve 404.html for unmatched routes
	handle_errors {
		root * /srv/hugo/
		@markdownError header Accept *text/markdown*
		handle @markdownError {
			header Content-Type "text/markdown; charset=utf-8"
			header Vary "Accept, Accept-Encoding"
			rewrite /404.md
			file_server
		}
		handle {
			header Vary "Accept, Accept-Encoding"
			rewrite /404.html
			file_server
		}
	}
}
