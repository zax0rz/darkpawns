{
	auto_https off
}

:80 {
	# Route soviet to The Soviet
	@soviet {
		host soviet.labz0rz.com
	}
	handle @soviet {
		reverse_proxy localhost:4000
	}

	# Dark Pawns game (served by Go server)
	handle /game {
		redir /game/ permanent
	}
	handle /game/* {
		uri strip_prefix /game
		reverse_proxy localhost:4350
	}

	# Go game server routes
	handle /ws {
		reverse_proxy localhost:4350
	}
	handle /api/* {
		reverse_proxy localhost:4350
	}
	handle /admin/* {
		reverse_proxy localhost:4350
	}
	handle /health {
		reverse_proxy localhost:4350
	}
	handle /metrics {
		reverse_proxy localhost:4350
	}

	# Hugo static files (catch-all)
	handle {
		root * /srv/hugo/
		try_files {path} {path}/index.html
		file_server
	}

	# Serve 404.html for unmatched routes
	handle_errors {
		root * /srv/hugo/
		rewrite /404.html
		file_server
	}
}
