{

}

darkpawns.org, www.darkpawns.org {
	encode zstd gzip
	import redirects.caddy

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://challenges.cloudflare.com; connect-src 'self' wss://darkpawns.org https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	@fingerprinted path /_astro/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	# Dark Pawns game (served by Go server)
	handle /game {
		redir /game/ permanent
	}
	handle /game/* {
		uri strip_prefix /game
		reverse_proxy 127.0.0.1:4350
	}

	# Go game server routes
	handle /ws {
		reverse_proxy 127.0.0.1:4350
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:4350
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:4350
	}
	handle /admin {
		reverse_proxy 127.0.0.1:4350
	}
	# The admin console's Vite bundle is emitted at /assets/* and served by Go
	# from admin-ui-dist. Without this the console's HTML loads and the page
	# stays blank, because the bundle 404s at the Astro root. Astro emits its
	# own assets under /_astro/, so there is no collision.
	handle /assets/* {
		reverse_proxy 127.0.0.1:4350
	}
	handle /admin/* {
		reverse_proxy 127.0.0.1:4350
	}
	handle /health {
		reverse_proxy 127.0.0.1:4350
	}

	# Mudlet client package — deployed with the game, same commit as the binary
	# (server announces mudlet/VERSION via GMCP Client.GUI; keep file in lockstep).
	# 404s harmlessly until the first game deploy ships the file.
	handle /darkpawns.xml {
		root * /opt/darkpawns/mudlet
		header Cache-Control "no-cache"
		file_server
	}

	# World map for the Mudlet package — served by the Go server (offered over GMCP).
	handle /darkpawns-map.xml {
		reverse_proxy 127.0.0.1:4350
	}

	# Serve the Markdown representation generated alongside each page. Handle
	# trailing-slash canonical URLs separately because Astro emits siblings
	# such as /docs/agents/protocol.md.
	@markdownTrailing {
		header Accept *text/markdown*
		path_regexp trailing ^(.+)/$
	}
	handle @markdownTrailing {
		root * /srv/darkpawns/
		header Vary "Accept, Accept-Encoding"
		header Content-Type "text/markdown; charset=utf-8"
		try_files {re.trailing.1}.md {path}index.md {path}/index.md
		file_server
	}

	@markdown header Accept *text/markdown*
	handle @markdown {
		root * /srv/darkpawns/
		header Vary "Accept, Accept-Encoding"
		header Content-Type "text/markdown; charset=utf-8"
		try_files {path}.md {path}index.md {path}/index.md
		file_server
	}

	# Static files (catch-all)
	handle {
		root * /srv/darkpawns/
		# Discovery headers for agents and crawlers.
		header Link "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", </sitemap-index.xml>; rel=\"sitemap\"; type=\"application/xml\", </rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\""
		header Vary "Accept, Accept-Encoding"
		try_files {path} {path}/index.html
		file_server
	}

	# Serve 404.html for unmatched routes
	handle_errors {
		root * /srv/darkpawns/
		@markdownError header Accept *text/markdown*
		handle @markdownError {
			header Content-Type "text/markdown; charset=utf-8"
			header Vary "Accept, Accept-Encoding"
			rewrite /404.md
			file_server
		}
		handle {
			header Vary "Accept, Accept-Encoding"
			rewrite /404.html
			file_server
		}
	}
}
