{
	auto_https off
}

:80 {
	encode zstd gzip
	import redirects.caddy

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://challenges.cloudflare.com; connect-src 'self' wss://darkpawns.labz0rz.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	@fingerprinted path /_astro/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	# Route soviet to The Soviet
	@soviet {
		host soviet.labz0rz.com
	}
	handle @soviet {
		reverse_proxy localhost:4000
	}

	# Dark Pawns game (served by Go server)
	handle /game {
		redir /game/ permanent
	}
	handle /game/* {
		uri strip_prefix /game
		reverse_proxy localhost:4350
	}

	# Go game server routes
	handle /ws {
		reverse_proxy localhost:4350
	}
	handle /api/* {
		reverse_proxy localhost:4350
	}
	handle /openapi.json {
		reverse_proxy localhost:4350
	}
	handle /admin/* {
		reverse_proxy localhost:4350
	}
	handle /health {
		reverse_proxy localhost:4350
	}
	handle /metrics {
		reverse_proxy localhost:4350
	}

	# Serve Markdown siblings for trailing-slash canonical URLs such as
	# /docs/agents/protocol/ -> /docs/agents/protocol.md.
	@markdownTrailing {
		header Accept *text/markdown*
		path_regexp trailing ^(.+)/$
	}
	handle @markdownTrailing {
		root * /srv/hugo/
		header Vary "Accept, Accept-Encoding"
		header Content-Type "text/markdown; charset=utf-8"
		try_files {re.trailing.1}.md {path}index.md {path}/index.md
		file_server
	}

	@markdown header Accept *text/markdown*
	handle @markdown {
		root * /srv/hugo/
		header Vary "Accept, Accept-Encoding"
		header Content-Type "text/markdown; charset=utf-8"
		try_files {path}.md {path}index.md {path}/index.md
		file_server
	}

	# Astro static files (catch-all; the document-root name is historical).
	handle {
		root * /srv/hugo/
		# Discovery headers for agents and crawlers.
		header Link "</llms.txt>; rel=\"alternate\"; type=\"text/plain\", </sitemap-index.xml>; rel=\"sitemap\"; type=\"application/xml\", </rss.xml>; rel=\"alternate\"; type=\"application/rss+xml\", </.well-known/agent-skills/index.json>; rel=\"alternate\"; type=\"application/json\""
		header Vary "Accept, Accept-Encoding"
		try_files {path} {path}/index.html
		file_server
	}

	# Serve 404.html for unmatched routes
	handle_errors {
		root * /srv/hugo/
		@markdownError header Accept *text/markdown*
		handle @markdownError {
			header Content-Type "text/markdown; charset=utf-8"
			header Vary "Accept, Accept-Encoding"
			rewrite /404.md
			file_server
		}
		handle {
			header Vary "Accept, Accept-Encoding"
			rewrite /404.html
			file_server
		}
	}
}
