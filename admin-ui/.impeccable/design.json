  "narrative": {
    "northStar": "The Haunted Paperback",
    "overview": "The console extends [Haunted Paperback](../website-astro/DESIGN.md): wordmark at\ntop left, static desktop sidebar, main working area, and one light theme. The\noperator's job is to inspect records, edit safely, and understand save and\nvalidation states. Use [brand voice Layer 1](../docs/brand-voice.md): direct,\ntechnical, specific.",
    "keyCharacteristics": [
      "Cream surfaces, charcoal rules, sparse oxblood.",
      "Flat controls, serif reading, machine-only monospace.",
      "Existing permissions and save boundaries remain visible."
    ],
    "rules": [
      {
        "name": "The One Oxblood Rule",
        "body": "Keep the accent sparse; status also needs words or icons.",
        "section": "colors"
      },
      {
        "name": "The Flat-Ink Rule",
        "body": "Separate surfaces with ink rules and the two paper tones. No shadows, gradients, glass or blur. Modal scrims use ink at 45% opacity. State transitions are brief; reduced-motion preferences shorten them.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep labels explicit and validation, errors and unsaved state visible.",
      "Do verify routed pages, narrow layouts, focus, overlays and save boundaries.",
      "Do keep screenshots as local evidence; this foundation ships no raster assets."
    ],
    "donts": [
      "Don't introduce a second theme or decorative status colors.",
      "Don't turn synthetic chart fixtures into operational claims."
