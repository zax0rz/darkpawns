# Dark Pawns Environment Variables
# Native installation: copy to .env and fill in your values.
# The binary does not read .env automatically. Export it from your shell:
#   set -a; . ./.env; set +a
# NEVER commit actual secrets to version control!

# ========== SECURITY SETTINGS ==========
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET_MIN_32_CHARS
# Optional secret-store encryption key, also generated with openssl rand -hex 32:
# ENCRYPTION_KEY=

# Environment (development/production)
ENVIRONMENT=production

# ========== DATABASE ==========
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DATABASE_URL=postgres://darkpawns:${POSTGRES_PASSWORD}@localhost:5432/darkpawns?sslmode=disable
# Create the darkpawns role/database first; URL-encode special password characters.
# Optional agent-sidecar Redis (not required for human play):
# REDIS_URL=redis://localhost:6379/0

# ========== CONNECTIONS (optional) ==========
# Reverse proxies whose X-Forwarded-For names the client (comma-separated CIDRs).
# Unset: loopback only. Empty: trust no proxy.
# TRUSTED_PROXIES=127.0.0.0/8,::1/128
# Per-address caps (flood protection; default 8 = two players x 3 characters + slack).
# TELNET_MAX_CONNS_PER_IP=8
# WEBSOCKET_MAX_CONNS_PER_IP=8

# ========== AI AGENT ==========
# AI_API_KEY=

# ========== TLS TELNET (optional) ==========
# Used only with -telnet-tls-port; separate from TLS_CERT_FILE/TLS_KEY_FILE (HTTPS).
# TELNET_TLS_CERT_FILE=
# TELNET_TLS_KEY_FILE=

# ========== MUDLET (optional) ==========
# Public URL of mudlet/darkpawns.xml, served from the same commit as this binary;
# Mudlet installs it on connect (GMCP Client.GUI). Dark Pawns itself uses
# https://darkpawns.org/darkpawns.xml; a self-hosted server publishes its own copy.
# DP_MUDLET_PACKAGE_URL=
# Public URL of this server's /darkpawns-map.xml (the whole world as a Mudlet map).
# DP_MUDLET_MAP_URL=

# ========== EXTERNAL API KEYS (optional) ==========
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MEM0_API_KEY=

# ========== SERVER SETTINGS ==========
# Native server paths/ports are CLI flags, not these environment variables.
# The defaults are right for a checkout: ./server needs no flags from the
# repository root. The explicit form is:
# ./server -world ./lib/world -web ./web/public -port 4350 -telnet-port 7777

# ========== TLS/HTTPS (production only) ==========
USE_TLS=false
# Leave both unset for local plaintext HTTP. Setting both enables HTTPS even
# when USE_TLS=false. These settings do not enable TLS on the telnet listener.
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
