---
import Base from '../layouts/Base.astro';
import '@xterm/xterm/css/xterm.css';
---

<Base title="Play Dark Pawns" description="Play Dark Pawns in your browser." hideFooter>
  <section class="play-shell" aria-labelledby="play-heading">
    <div class="play-intro container">
      <h1 id="play-heading">Enter Dark Pawns</h1>
      <p>Play right here, or <a href="/connect/">connect a MUD client</a> for longer sessions.</p>
    </div>

    <div class="play-wrapper container">
      <div class="terminal-frame">
        <div class="terminal-header">
          <span class="terminal-title">Dark Pawns <span aria-hidden="true">//</span> Web Client</span>
          <div class="terminal-actions">
            <span class="conn-status disconnected" role="status" aria-live="polite"><span class="dot" aria-hidden="true"></span><span>Disconnected</span></span>
            <button id="screen-reader-btn" type="button" aria-pressed="false" aria-describedby="terminal-help">Screen reader: off</button>
            <button id="reconnect-btn" type="button">Reconnect</button>
          </div>
        </div>
        <p class="visually-hidden" id="terminal-help">Type in the terminal; press Tab to leave it. Screen reader mode announces new game text.</p>
        <div id="terminal" role="region" aria-label="Dark Pawns game terminal" aria-describedby="terminal-help"></div>
      </div>

      <aside class="play-sidebar" aria-labelledby="dock-heading">
        <h2 id="dock-heading" class="visually-hidden">Player dock</h2>
        <div id="status-bar" class="status-bar hidden" role="group" aria-labelledby="character-heading">
          <h3 id="character-heading">Character</h3>
          <p id="character-identity" class="character-identity"></p>
          <dl class="vitals">
            <div class="stat-group"><dt>Hit points</dt><dd><span id="hp-text">Waiting</span><span class="bar-track" aria-hidden="true"><span class="bar-fill" id="hp-bar"></span></span></dd></div>
            <div class="stat-group"><dt>Mana</dt><dd><span id="mana-text">Waiting</span><span class="bar-track" aria-hidden="true"><span class="bar-fill" id="mana-bar"></span></span></dd></div>
            <div class="stat-group"><dt>Movement</dt><dd><span id="move-text">Waiting</span><span class="bar-track" aria-hidden="true"><span class="bar-fill" id="move-bar"></span></span></dd></div>
          </dl>
          <div class="character-meta"><span id="level-info">Level pending</span><span id="gold-info">Gold pending</span></div>
        </div>
        <div id="sidebar-connect-panel">
          <h3>At the prompt</h3>
          <p>Enter an existing character name, create a new character, or type <strong>guest</strong> for an ephemeral visit.</p>
        </div>
        <div id="target-container" class="sidebar-panel hidden"></div>
        <div id="minimap-container" class="sidebar-panel hidden"></div>
        <section id="chat-container" class="chat-panel" aria-labelledby="chat-heading">
          <h3 id="chat-heading">Chat</h3>
          <p id="chat-empty">Channel messages appear here during play.</p>
          <ol id="chat-messages" tabindex="0" aria-label="Chat history" aria-live="off"></ol>
        </section>
      </aside>
    </div>
  </section>


  <script>
    // The client itself lives in web/public so the self-host splash, which has
    // no build step, can serve the same file verbatim. Vite bundles it here.
    // Terminal construction stays with the host: this page picks the fonts and
    // theme that match the site, the admin console picks its own.
    import { Terminal } from '@xterm/xterm';
    import { FitAddon } from '@xterm/addon-fit';
    import { createMudClient } from '../../../web/public/mud-client.js';

    // Screen reader mode makes xterm keep an accessible copy of the output and
    // announce new lines. It costs rendering speed, so it is a choice rather
    // than the default, and the choice is remembered per browser. Storage can
    // be unavailable (private windows, blocked site data), so every access is
    // guarded and the page works without it.
    const SCREEN_READER_KEY = 'dp.play.screenReader';
    const readScreenReaderPreference = () => {
      try {
        return window.localStorage.getItem(SCREEN_READER_KEY) === 'on';
      } catch {
        return false;
      }
    };
    const saveScreenReaderPreference = (on: boolean) => {
      try {
        window.localStorage.setItem(SCREEN_READER_KEY, on ? 'on' : 'off');
      } catch {
        // Not remembered, but still switched for this visit.
      }
    };

    // The play area fills the window under the site header; the header's
    // height changes with its wrapping, so it is measured, not assumed.
    const masthead = document.querySelector('.masthead');
    const setMastheadHeight = () => {
      if (masthead) document.documentElement.style.setProperty('--masthead-h', `${masthead.getBoundingClientRect().height}px`);
    };
    setMastheadHeight();
    if (masthead) new ResizeObserver(setMastheadHeight).observe(masthead);

    const term = new Terminal({
      screenReaderMode: readScreenReaderPreference(),
      cursorBlink: true,
      // Game text (MOTD, room and help files) uses bare "\n" line endings.
      // Without convertEol, xterm treats a lone LF as line-feed-only: the
      // cursor drops a row but keeps its column, producing runaway "staircase"
      // indentation. convertEol makes every "\n" behave as "\r\n", so lines
      // return to column 0.
      convertEol: true,
      fontSize: 15,
      fontFamily: '"IM Fell English", "Courier New", monospace',
      theme: {
        background: '#0a0908',
        foreground: '#c8b896',
        cursor: '#8b0000',
        selectionBackground: '#3a2a1a',
      },
    });
    const fit = new FitAddon();
    term.loadAddon(fit);
    const mount = document.getElementById('terminal');
    term.open(mount);
    fit.fit();
    // Refit whenever the terminal's own box changes size, not only the window,
    // and once web fonts finish loading. A terminal measured before its container
    // is laid out gets xterm's two-column minimum, and output written then wraps
    // at two columns; xterm reflows it once the fit is right.
    if (mount) new ResizeObserver(() => fit.fit()).observe(mount);
    document.fonts?.ready.then(() => fit.fit());

    const screenReaderButton = document.getElementById('screen-reader-btn');
    const showScreenReaderState = (on: boolean) => {
      if (!screenReaderButton) return;
      screenReaderButton.setAttribute('aria-pressed', on ? 'true' : 'false');
      screenReaderButton.textContent = on ? 'Screen reader: on' : 'Screen reader: off';
    };
    showScreenReaderState(term.options.screenReaderMode === true);
    screenReaderButton?.addEventListener('click', () => {
      const on = !term.options.screenReaderMode;
      term.options.screenReaderMode = on;
      saveScreenReaderPreference(on);
      showScreenReaderState(on);
    });

    // The shared client's Reconnect handler hides its button as the socket
    // opens. Keep keyboard focus in the game instead of dropping it to body.
    document.getElementById('reconnect-btn')?.addEventListener('click', () => term.focus());

    createMudClient({ terminal: term });
  </script>
</Base>

<style>
  /* The play area is an app: intro, terminal and dock fill the window under
     the site header (measured into --masthead-h), and nothing scrolls but the
     terminal and the chat history. The client guide sits below the fold. */
  .play-shell { display: flex; flex-direction: column; height: calc(100dvh - var(--masthead-h, 8rem)); min-height: 32rem; border-bottom: 1px solid var(--rule); }
  .play-intro { display: flex; align-items: baseline; flex-wrap: wrap; gap: .35rem var(--space-md); padding-block: var(--space-sm); }
  .play-intro h1 { margin: 0; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; }
  .play-intro p { color: var(--ink-muted); margin: 0; font-size: .95rem; }
  /* Auto margins would shrink these flex items to their content; they span
     the same 96rem column so the intro lines up with the terminal. */
  .play-wrapper.container, .play-intro.container { width: 100%; max-width: 96rem; padding-inline: var(--space-md); }
  .play-wrapper { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(19rem, 22rem); min-height: 0; border-top: 1px solid var(--rule); }
  .terminal-frame { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: hidden; background: #0a0908; }
  .terminal-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm); padding: .55rem var(--space-md); background: var(--paper-deep); border-bottom: 1px solid var(--rule); font-family: var(--font-mono); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
  .terminal-title { color: var(--accent); font-weight: 700; }
  .terminal-actions, .conn-status { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; }
  .conn-status .dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--accent); }
  .conn-status.connected .dot { background: var(--online); }
  #screen-reader-btn { border: 1px solid var(--rule); background: var(--paper); color: var(--ink); cursor: pointer; font: inherit; padding: .25rem .55rem; text-transform: uppercase; }
  #screen-reader-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  #screen-reader-btn:focus-visible, #reconnect-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #reconnect-btn { display: none; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); cursor: pointer; font: inherit; padding: .25rem .55rem; text-transform: uppercase; }
  #reconnect-btn.visible { display: inline-block; }
  /* The fit addon sizes rows from this box's height and subtracts padding only
     on xterm's own element, so the padding lives there and the frame is an
     inset shadow: padding or a border here made one row too many and clipped
     the prompt below the bottom edge. */
  #terminal { flex: 1; min-height: 0; overflow: hidden; background: #0a0908; box-shadow: inset 0 0 0 2px var(--rule); }
  #terminal :global(.xterm) { padding: .5rem; height: 100%; }
  /* Dock: character, target (in a fight), map, then chat taking the rest. */
  /* The dock never scrolls: Character and Target keep their height, and Map
     and Chat share what is left, each with a floor. */
  .play-sidebar { display: flex; flex-direction: column; min-width: 0; min-height: 0; padding: var(--space-sm) var(--space-md); background: var(--paper); border-left: 1px solid var(--rule); overflow: hidden; }
  .play-sidebar > * { flex: none; }
  .play-sidebar > #minimap-container { flex: 1 1 12rem; min-height: 7rem; max-height: 17rem; display: flex; flex-direction: column; }
  .play-sidebar > .chat-panel { flex: 1 1 12rem; min-height: 7rem; display: flex; flex-direction: column; margin-top: var(--space-sm); border: 1px solid var(--rule); background: var(--paper-deep); }
  .chat-panel h3 { margin: 0; padding: .35rem .6rem; border-bottom: 1px solid var(--rule); font-size: 1rem; }
  #chat-empty { margin: 0; padding: .5rem .6rem; font-size: .85rem; }
  #chat-messages { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: .35rem; margin: 0; padding: .5rem .6rem; list-style: none; font-family: var(--font-mono); font-size: .82rem; line-height: 1.4; overflow-wrap: anywhere; }
  #chat-messages:empty { display: none; }
  #chat-messages:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  #chat-messages li { border-left: 2px solid var(--accent); padding-left: .5rem; }
  #chat-messages small { color: var(--ink-muted); text-transform: uppercase; }
  .play-sidebar h3 { font-size: 1.2rem; margin: 0 0 var(--space-sm); }
  .play-sidebar p { color: var(--ink-muted); font-size: .9rem; }
  .hidden { display: none; }
  .sidebar-panel { border-top: 1px solid var(--rule); padding-top: var(--space-xs); margin-top: var(--space-sm); }
  .sidebar-panel:empty { display: none; }
  .status-bar { margin: 0; font-family: var(--font-mono); font-size: .85rem; }
  .status-bar h3 { font-family: var(--font-display); }
  .character-identity { margin: 0 0 var(--space-sm); color: var(--ink-muted); font-size: .85rem; }
  .vitals { margin: 0; }
  .stat-group { margin: 0 0 .3rem; }
  .stat-group dt, .stat-group dd { display: flex; justify-content: space-between; gap: var(--space-sm); margin: 0; }
  .stat-group dt { color: var(--ink-muted); text-transform: uppercase; font-size: .8rem; }
  .stat-group dd { flex-direction: column; align-items: stretch; font-variant-numeric: tabular-nums; text-align: right; }
  .bar-track { display: block; width: 100%; height: .45rem; overflow: hidden; background: var(--paper-deep); border: 1px solid var(--ink-muted); }
  .bar-fill { display: block; height: 100%; }
  .character-meta { display: flex; justify-content: space-between; gap: var(--space-sm); padding-top: .4rem; border-top: 1px solid var(--rule); font-variant-numeric: tabular-nums; }
  .play-sidebar :global(.sidebar-panel-title) { margin: 0 0 var(--space-xs); color: var(--accent); font-family: var(--font-display); font-size: 1.05rem; }
  .play-sidebar :global(.sidebar-list) { display: grid; gap: .3rem; }
  .play-sidebar :global(.sidebar-list-item) { display: flex; align-items: baseline; gap: .45rem; font-family: var(--font-mono); font-size: .85rem; line-height: 1.4; }
  .play-sidebar :global(.sidebar-list-empty) { color: var(--ink-muted); font-size: .85rem; }
  .play-sidebar :global(.sidebar-tabs) { display: flex; border-bottom: 1px solid var(--rule); margin-bottom: var(--space-sm); }
  .play-sidebar :global(.sidebar-tab-btn) { padding: .35rem .45rem; border: 0; background: transparent; color: var(--ink-muted); cursor: pointer; font: .85rem var(--font-mono); }
  .play-sidebar :global(.sidebar-tab-btn.active) { color: var(--accent); box-shadow: inset 0 -2px var(--accent); }
  .play-sidebar :global(.target-hp-bar-container) { display: flex; align-items: center; gap: .5rem; }
  .play-sidebar :global(.target-hp-bar-container .bar-track) { background: var(--paper-deep); border: 1px solid var(--ink-muted); }
  .play-sidebar :global(.target-name) { font-family: var(--font-mono); font-size: .82rem; }
  .play-sidebar :global(.badge) { margin-left: .25rem; color: var(--accent); font: .8rem var(--font-mono); text-transform: uppercase; }
  .play-sidebar :global(#minimap-container svg) { display: block; flex: 1; min-height: 0; width: 100%; height: auto; }
  @media (max-width: 860px) {
    .play-shell { height: auto; }
    .play-wrapper { grid-template-columns: 1fr; }
    .terminal-frame { height: clamp(27rem, 65dvh, 38rem); }
    .play-sidebar { overflow: visible; }
    .play-sidebar > #minimap-container { flex: none; max-height: none; }
    .play-sidebar :global(#minimap-container svg) { height: 12rem; }
    .play-sidebar > .chat-panel { flex: none; }
    #chat-messages { max-height: 16rem; }
    .play-sidebar { border-left: 0; border-top: 1px solid var(--rule); }
  }
  @media (max-width: 520px) {
    .play-intro { padding-inline: var(--space-md); }
    .play-wrapper.container { padding-inline: 0; }
    .terminal-header { align-items: flex-start; flex-direction: column; }
  }
</style>
