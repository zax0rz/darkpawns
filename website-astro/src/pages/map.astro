---
import Base from '../layouts/Base.astro';
import mapScriptUrl from '../scripts/map.js?url';
---

<Base title="Dark Pawns World Map" description="Explore the rooms, zones, and paths of the Dark Pawns world." hideFooter>
<h1 class="visually-hidden">Dark Pawns world map</h1>
<style is:global>
/* ── Map page layout ─────────────────────────────────── */
#map-page {
  display: flex;
  height: calc(100dvh - 7.75rem);
  overflow: hidden;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-mono);
}

/* ── Sidebar ─────────────────────────────────────────── */
#map-sidebar {
  width: 240px;
  min-width: 240px;
  display: flex;
  flex-direction: column;
  background: var(--paper-deep);
  border-right: 1px solid var(--ink);
  overflow: hidden;
}

#map-sidebar-top {
  padding: 0.75rem;
  border-bottom: 1px solid var(--ink);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

#zone-search, #room-search {
  width: 100%;
  background: var(--paper);
  border: 1px solid var(--ink);
  border-radius: 2px;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  padding: 0.4rem 0.6rem;
  outline: none;
}
#zone-search:focus, #room-search:focus {
  border-color: var(--accent);
}
#zone-search::placeholder, #room-search::placeholder {
  color: var(--ink-muted);
}

#room-search-section {
  border-top: 1px solid var(--ink);
  padding: 0.75rem;
}

#zone-index-link {
  border-top: 1px solid var(--ink);
  padding: 0.6rem 0.75rem;
  font-size: 0.7rem;
}
#zone-index-link a { color: var(--accent); text-decoration: none; text-transform: uppercase; letter-spacing: 0.08em; }
#zone-index-link a:hover { text-decoration: underline; }

#room-search-results {
  margin-top: 0.5rem;
  display: none;
  overflow-y: auto;
  max-height: 180px;
}

.room-result {
  padding: 0.35rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  font-size: 0.7rem;
  color: var(--ink-muted);
  line-height: 1.4;
}
.room-result:hover { background: var(--paper); color: var(--accent); }
.room-result-zone { color: var(--accent); font-size: 0.6rem; }

#zone-list {
  flex: 1;
  overflow-y: auto;
  padding: 0.25rem 0;
}

#zone-list::-webkit-scrollbar { width: 4px; }
#zone-list::-webkit-scrollbar-track { background: transparent; }
#zone-list::-webkit-scrollbar-thumb { background: var(--ink-muted); border-radius: 2px; }

.zone-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.4rem 0.75rem;
  cursor: pointer;
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink-muted);
  transition: background 0.1s, color 0.1s;
  line-height: 1.3;
}
.zone-item:hover { background: var(--paper); color: var(--accent); }
.zone-item.active { background: var(--paper); color: var(--accent); font-weight: 700; border-left: 2px solid var(--accent); }
.zone-record-link {
  color: var(--ink-muted);
  flex-shrink: 0;
  font-size: 0.65rem;
  margin-left: auto;
  padding: 0 0.35rem;
  text-decoration: none;
}
.zone-record-link:hover { color: var(--accent); }
.zone-item:hover .zone-record-link, .zone-item.active .zone-record-link { color: var(--accent); }
.zone-item .zone-count { margin-left: 0.35rem; }
.zone-count {
  font-size: 0.65rem;
  color: var(--ink-muted);
  margin-left: 0.5rem;
  flex-shrink: 0;
}
.zone-item.active .zone-count { color: var(--accent); }

/* ── Main canvas ─────────────────────────────────────── */
#map-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

#map-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0.75rem;
  min-height: 42px;
  gap: 0.5rem;
  background: var(--paper-deep);
  border-bottom: 1px solid var(--ink);
  flex-shrink: 0;
}

#zone-title {
  font-size: 0.8rem;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  font-family: var(--font-display);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

#map-controls {
  display: flex;
  gap: 0.35rem;
  align-items: center;
  flex-shrink: 0;
}

.map-btn {
  background: var(--paper);
  border: 1px solid var(--ink);
  border-radius: 2px;
  color: var(--ink);
  cursor: pointer;
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.25rem 0.55rem;
  line-height: 1.2;
  transition: background-color 0.1s, color 0.1s, border-color 0.1s;
  white-space: nowrap;
}
.map-btn:hover { background: var(--accent); color: var(--paper); border-color: var(--accent); }
.map-btn.active { background: var(--accent); border-color: var(--accent); color: var(--paper); }
.map-view-switch { display: inline-flex; }
.map-view-switch .map-btn { border-radius: 0; margin-left: -1px; }
.map-view-switch .map-btn:first-child { border-radius: 2px 0 0 2px; margin-left: 0; }
.map-view-switch .map-btn:last-child { border-radius: 0 2px 2px 0; }

/* ── Floating HUD in Graph Mode ──────────────────────── */
#map-graph-hud {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  z-index: 8;
  pointer-events: auto;
}
#map-graph-hud[hidden] {
  display: none !important;
}
.graph-dim-switch {
  display: inline-flex;
  background: rgba(16, 14, 12, 0.88);
  border: 1px solid rgba(239, 231, 214, 0.35);
  border-radius: 2px;
  overflow: hidden;
}
.graph-dim-btn {
  appearance: none;
  background: transparent;
  border: none;
  border-right: 1px solid rgba(239, 231, 214, 0.25);
  color: rgba(239, 231, 214, 0.78);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 0.3rem 0.6rem;
  cursor: pointer;
}
.graph-dim-btn:last-child {
  border-right: none;
}
.graph-dim-btn:hover {
  color: #efe7d6;
  background: rgba(207, 75, 66, 0.28);
}
.graph-dim-btn.active {
  background: #cf4b42;
  color: #efe7d6;
}
#graph-hud-hint {
  background: rgba(16, 14, 12, 0.82);
  border: 1px solid rgba(239, 231, 214, 0.22);
  color: rgba(239, 231, 214, 0.72);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  padding: 0.28rem 0.55rem;
  border-radius: 2px;
  pointer-events: none;
}

/* ── View wrapper — holds both canvas and svg ────────── */
#map-view-wrap {
  flex: 1;
  position: relative;
  overflow: hidden;
  touch-action: none;
}

#map-svg-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  touch-action: none;
}

#map-svg {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}
#map-svg:active { cursor: grabbing; }

#map-loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  color: var(--ink-muted);
  font-size: 0.8rem;
  font-family: var(--font-display);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  pointer-events: none;
  background: rgba(239, 231, 214, 0.8);
  z-index: 10;
}

#map-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--ink-muted);
  font-size: 0.8rem;
  font-family: var(--font-display);
  text-transform: uppercase;
  pointer-events: none;
}

/* ── Tooltip ─────────────────────────────────────────── */
#map-tooltip {
  position: fixed;
  background: var(--paper-deep);
  border: 1px solid var(--ink);
  border-radius: 2px;
  padding: 0.5rem 0.75rem;
  font-size: 0.75rem;
  color: var(--ink);
  pointer-events: none;
  z-index: 100;
  max-width: 260px;
  line-height: 1.45;
  box-shadow: 3px 3px 10px rgba(0,0,0,0.18);
  display: none;
}
#map-tooltip strong { color: var(--accent); display: block; margin-bottom: 0.15rem; font-family: var(--font-display); font-size: 0.8rem; }

/* ── Detail panel ────────────────────────────────────── */
#map-detail {
  width: 300px;
  min-width: 300px;
  background: var(--paper-deep);
  border-left: 1px solid var(--ink);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: margin-right 0.2s;
}
#map-detail.hidden {
  display: none;
}

#detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0.75rem;
  border-bottom: 1px solid var(--ink);
  gap: 0.5rem;
}

#detail-room-name {
  font-size: 0.9rem;
  color: var(--accent);
  font-family: var(--font-display);
  text-transform: uppercase;
  font-weight: 700;
  line-height: 1.3;
  margin: 0;
}

#detail-vnum {
  font-size: 0.7rem;
  color: var(--ink-muted);
  font-family: var(--font-mono);
  margin-top: 0.2rem;
}

#detail-close {
  background: none;
  border: none;
  color: var(--ink-muted);
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
  padding: 0.15rem;
  flex-shrink: 0;
}
#detail-close:hover { color: var(--accent); }

#detail-body {
  flex: 1;
  overflow-y: auto;
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
#detail-body::-webkit-scrollbar { width: 4px; }
#detail-body::-webkit-scrollbar-track { background: transparent; }
#detail-body::-webkit-scrollbar-thumb { background: var(--ink-muted); border-radius: 2px; }

#detail-desc {
  font-size: 0.9rem;
  color: var(--ink);
  line-height: 1.55;
  font-family: var(--font-body);
}
#detail-desc p {
  margin: 0;
}
#detail-desc p + p {
  margin-top: 0.65em;
}
#detail-desc pre {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  line-height: 1.3;
  overflow-x: auto;
  margin: 0;
}

#detail-exits h2, #detail-exits h4, #detail-mobs h4, #detail-path-section h2 {
  font-size: 0.75rem;
  font-family: var(--font-display);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-muted);
  margin: 0 0 0.4rem;
  border-bottom: 1px solid var(--rule);
  padding-bottom: 0.2rem;
}

.inhabitant-item {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  padding: 0.35rem 0;
  border-bottom: 1px solid var(--rule);
  text-decoration: none;
  color: var(--ink);
}
.inhabitant-item:last-child { border-bottom: none; }
.inhabitant-item:hover .inhabitant-name { color: var(--accent); text-decoration: underline; }
.inhabitant-name {
  font-family: var(--font-body);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.25;
}
.inhabitant-meta {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--ink-muted);
}

.exit-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.3rem 0;
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--ink);
  cursor: pointer;
  border-radius: 2px;
}
.exit-item:hover { color: var(--accent); }
.exit-dir {
  width: 1rem;
  text-align: center;
  font-size: 0.65rem;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
}
.exit-dest { color: var(--ink-muted); font-size: 0.65rem; margin-left: auto; }

#detail-mobs {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
#detail-mobs:empty {
  display: none;
}

#detail-path-section { border-top: 1px solid var(--ink); padding-top: 0.75rem; }

#path-status {
  font-size: 0.7rem;
  color: var(--ink-muted);
  margin-bottom: 0.5rem;
}

.path-btn {
  background: var(--paper);
  border: 1px solid var(--ink);
  border-radius: 2px;
  color: var(--ink);
  cursor: pointer;
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  padding: 0.35rem 0.6rem;
  width: 100%;
}
.path-btn:hover { background: var(--accent); color: var(--paper); border-color: var(--accent); }
.path-btn.start { border-color: var(--accent); color: var(--accent); }
.path-btn.clear { border-color: var(--accent); color: var(--accent); }

/* ── SVG element styles ──────────────────────────────── */
.exit-line {
  stroke: rgba(26, 22, 20, 0.22);
  stroke-width: 1.6;
  fill: none;
  pointer-events: none;
}
.exit-line.highlighted { stroke: var(--accent); stroke-width: 3.5; }
.exit-line.in-path { stroke: var(--accent); stroke-width: 3; }

.room-node {
  cursor: pointer;
  stroke: var(--ink);
  stroke-width: 1.2;
}
.room-node.selected { stroke: var(--accent) !important; stroke-width: 3 !important; }
.room-node.path-node { stroke: var(--accent) !important; stroke-width: 3 !important; }
.room-node.path-start { fill: var(--accent) !important; stroke: var(--ink) !important; stroke-width: 2 !important; }

/* ── Legend (inside map-view-wrap) ──────────────────── */
#map-legend {
  position: absolute;
  bottom: 0.75rem;
  right: 0.75rem;
  background: rgba(229, 218, 193, 0.95);
  border: 1px solid var(--ink);
  border-radius: 2px;
  padding: 0.5rem 0.75rem;
  font-size: 0.7rem;
  color: var(--ink);
  pointer-events: none;
  display: none;
  box-shadow: 2px 2px 8px rgba(0,0,0,0.1);
}
#map-legend.visible { display: block; }
.legend-item { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.25rem; font-family: var(--font-display); text-transform: uppercase; font-size: 0.65rem; }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; stroke: var(--ink); stroke-width: 0.8; }

/* ── Canvas wrap (world overview) ────────────────────── */
#map-canvas-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  touch-action: none;
}
#map-canvas {
  width: 100%;
  height: 100%;
  display: block;
  cursor: grab;
}
#map-canvas:active { cursor: grabbing; }

/* ── Responsive ──────────────────────────────────────── */
#btn-sidebar { display: none; }

@media (max-width: 768px) {
  #map-sidebar {
    width: 0; min-width: 0; overflow: hidden; border-right: none;
  }
  #map-sidebar.open {
    width: 82vw; max-width: 300px; min-width: 240px;
    position: absolute; z-index: 25; height: 100%;
    border-right: 1px solid var(--ink);
    box-shadow: 4px 0 16px rgba(0,0,0,0.25);
  }
  #map-header {
    padding: 0.35rem 0.6rem;
    min-height: auto;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
  }
  #zone-title {
    width: 100%;
    font-size: 0.72rem;
    line-height: 1.25;
  }
  #map-controls {
    width: 100%;
    justify-content: space-between;
    gap: 0.25rem;
  }
  .map-btn {
    padding: 0.24rem 0.45rem;
    font-size: 0.68rem;
  }
  #graph-hud-hint {
    display: none;
  }
  #map-legend {
    display: none !important;
  }
  /* Detail panel: bottom sheet on mobile */
  #map-detail {
    width: 100% !important; min-width: 0;
    position: absolute; bottom: 0; left: 0; right: 0;
    max-height: 0; overflow: hidden;
    border-left: none;
    border-top: 2px solid var(--ink);
    transition: max-height 0.25s ease;
    z-index: 22;
    box-shadow: 0 -4px 18px rgba(0,0,0,0.22);
  }
  #map-detail.open:not(.hidden) {
    max-height: 58vh;
    overflow-y: auto;
  }
  #map-detail.hidden { max-height: 0 !important; }
  #btn-sidebar { display: inline-flex !important; align-items: center; }
}

@media (max-width: 640px) {
  #map-page { height: calc(100dvh - 8.5rem); }
}
</style>

<div id="map-page">

  <!-- Sidebar: zone list + room search -->
  <aside id="map-sidebar">
    <div id="map-sidebar-top">
      <input id="zone-search" type="text" placeholder="Search zones…" autocomplete="off" aria-label="Search zones">
    </div>
    <div id="zone-list" role="list" aria-label="Zone list"></div>
    <div id="zone-index-link"><a href="/zones/">Zone records</a> · <a href="/database/">Mob &amp; Item Codex</a></div>
    <div id="room-search-section">
      <input id="room-search" type="text" placeholder="Search rooms…" autocomplete="off" aria-label="Search rooms">
      <div id="room-search-results" role="list" aria-label="Room search results"></div>
    </div>
  </aside>

  <!-- Main view -->
  <div id="map-main">
    <div id="map-header">
      <span id="zone-title">Loading…</span>
      <div id="map-controls">
        <button class="map-btn" id="btn-sidebar" title="Toggle zone list" aria-label="Toggle zone list">☰ Zones</button>
        <button class="map-btn" id="btn-zoom-in"  title="Zoom in"  aria-label="Zoom in">+</button>
        <button class="map-btn" id="btn-zoom-out" title="Zoom out" aria-label="Zoom out">−</button>
        <button class="map-btn" id="btn-reset"    title="Reset view" aria-label="Reset view">⌂</button>
        <button class="map-btn" id="btn-path"     title="Pathfinding mode" aria-label="Toggle pathfinding">Path</button>
        <div class="map-view-switch" role="group" aria-label="Map view">
          <button class="map-btn active" id="btn-view-graph" title="Obsidian-style 3D / 2D constellation graph" aria-label="World graph view">✦ Graph</button>
          <button class="map-btn" id="btn-view-grid" title="Point-connected MUD room grid" aria-label="Point-connected grid view">▦ Grid</button>
        </div>
      </div>
    </div>

    <!-- View: both canvas and svg live here; JS toggles display -->
    <div id="map-view-wrap">

      <!-- Floating Graph Mode HUD (switches between 3D World Sphere and 2D Constellation Plane) -->
      <div id="map-graph-hud">
        <div class="graph-dim-switch" role="group" aria-label="Graph projection">
          <button type="button" class="graph-dim-btn active" id="btn-graph-3d" title="3D interactive Obsidian sphere">3D World</button>
          <button type="button" class="graph-dim-btn" id="btn-graph-2d" title="2D planar Obsidian constellation">2D Plane</button>
        </div>
        <span id="graph-hud-hint">Drag to rotate · Scroll to zoom · Shift+drag to pan · Click any room</span>
      </div>

      <!-- World map: Canvas (all rooms, pan/zoom) -->
      <div id="map-canvas-wrap">
        <canvas id="map-canvas" aria-label="World map, all rooms"></canvas>
      </div>

      <!-- Zone view: SVG with pre-baked positions -->
      <div id="map-svg-wrap" style="display:none">
        <svg id="map-svg" role="img" aria-label="Zone map"></svg>
      </div>

      <!-- Shared overlays -->
      <div id="map-loading" aria-live="polite">
        <div id="map-loading-msg">Loading…</div>
      </div>
      <div id="map-empty" style="display:none" aria-label="No zone selected">
        <div>← Select a zone from the list</div>
      </div>
      <div id="map-tooltip" role="tooltip" aria-live="polite"></div>
      <div id="map-legend" aria-label="Sector legend">
        <div class="legend-item"><span class="legend-dot" style="background:#4a4540"></span>inside</div>
        <div class="legend-item"><span class="legend-dot" style="background:#a8201a"></span>city</div>
        <div class="legend-item"><span class="legend-dot" style="background:#8c905c"></span>field</div>
        <div class="legend-item"><span class="legend-dot" style="background:#3e5c38"></span>forest</div>
        <div class="legend-item"><span class="legend-dot" style="background:#b08b5c"></span>hills</div>
        <div class="legend-item"><span class="legend-dot" style="background:#6b5e50"></span>mountain</div>
        <div class="legend-item"><span class="legend-dot" style="background:#4a7a96"></span>water</div>
        <div class="legend-item"><span class="legend-dot" style="background:#d0a868"></span>desert</div>
      </div>

    </div>
  </div>

  <!-- Detail panel -->
  <aside id="map-detail" class="hidden" aria-label="Room detail">
    <div id="detail-header">
      <div>
        <p id="detail-room-name" style="font-size:.9rem;color:var(--accent);font-family:var(--font-display);text-transform:uppercase;font-weight:700;line-height:1.3;margin:0"></p>
        <div id="detail-vnum"></div>
      </div>
      <div style="display:flex;gap:.35rem;align-items:center;flex-shrink:0">
        <a id="detail-record-link" href="#" title="Room record page" aria-label="Room record page"
          style="display:none;background:none;border:1px solid var(--ink-muted);border-radius:2px;color:var(--ink-muted);font-family:var(--font-display);font-size:.6rem;font-weight:600;letter-spacing:.06em;padding:.2rem .45rem;text-decoration:none;text-transform:uppercase;white-space:nowrap">Record</a>
        <button id="detail-copy-link" title="Copy shareable link" aria-label="Copy link to this room"
          style="background:none;border:1px solid var(--ink-muted);border-radius:2px;color:var(--ink-muted);cursor:pointer;font-family:var(--font-display);font-size:.6rem;font-weight:600;letter-spacing:.06em;padding:.2rem .45rem;text-transform:uppercase;white-space:nowrap">
          Copy link
        </button>
        <button id="detail-close" title="Close detail" aria-label="Close room detail">✕</button>
      </div>
    </div>
    <div id="detail-body">
      <div id="detail-desc"></div>
      <div id="detail-exits"></div>
      <div id="detail-mobs"></div>
      <div id="detail-path-section">
        <h2>Pathfinding</h2>
        <div id="path-status"></div>
        <button class="path-btn" id="btn-set-start">Set as path start</button>
        <button class="path-btn clear" id="btn-clear-path" style="display:none;margin-top:.3rem">Clear path</button>
      </div>
      <div id="detail-expand-section" style="margin-top:0.5rem">
        <button class="path-btn" id="btn-expand-zone" style="border-color:var(--accent);color:var(--accent)">Open 2D Zone Grid Map →</button>
      </div>
    </div>
  </aside>

</div>

<script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"
        integrity="sha256-8glLv2FBs1lyLE/kVOtsSw8OQswQzHr5IfwVj864ZTk=" is:inline
        crossorigin="anonymous"></script>
<script is:inline src={mapScriptUrl}></script>
</Base>
