---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const fmt = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const fieldGuides = [
  { href: '/map/', title: 'Map', text: 'Trace rooms and connections drawn from the world files.' },
  { href: '/database/', title: 'Database', text: 'Look through the mobs and objects loaded by the current server.' },
  { href: '/help/', title: 'Help files', text: 'Search the commands, spells, skills, and reference files used in the game.' },
];
---

<Base title="Dark Pawns | A fantasy world from 1994">
  <main class="home-page">
    <section class="cover container">
      <div class="cover-copy">
        <p class="eyebrow">A Multi-User Dungeon, established 1994</p>
        <h1>A fantasy world first opened in 1994.</h1>
        <p class="lede">Play in your browser, explore the original world, or read what survived from the people who built it.</p>
        <div class="cover-actions">
          <a class="btn-primary" href="/play/">Enter the game</a>
          <a class="btn-secondary" href="/world/">Explore the world</a>
        </div>
      </div>
      <aside class="connection-slip" aria-label="Direct connection details">
        <p class="slip-label">Direct connection</p>
        <dl>
          <div><dt>Host</dt><dd>darkpawns.labz0rz.com</dd></div>
          <div><dt>Port</dt><dd>7777</dd></div>
          <div><dt>Protocol</dt><dd>Telnet</dd></div>
        </dl>
        <p><a href="/play/#desktop-client">Desktop client instructions</a></p>
      </aside>
    </section>

    <section class="world-desk">
      <div class="container world-grid">
        <div class="world-intro">
          <p class="eyebrow">Field guides</p>
          <h2>Field guides to the original world</h2>
          <p>The map, database, and help index are generated from the same files used by the server. They are useful before you enter and after you get lost.</p>
        </div>
        <ol class="guide-list">
          {fieldGuides.map((guide) => (
            <li>
              <a href={guide.href}>
                <h3>{guide.title}</h3>
                <p>{guide.text}</p>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="record container">
      <article class="archive-feature">
        <p class="eyebrow">Recovered from the old web</p>
        <h2>The recovered community archive</h2>
        <p>Copies of dp-players.com and darkpawns.com survived in the Wayback Machine. The public archive preserves a small, sourced selection and records where each page came from.</p>
        <div class="record-links">
          <a href="/archive/">Browse the archive <span aria-hidden="true">→</span></a>
          <a href="/about/">Read the history <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <aside class="restoration-note">
        <p class="eyebrow">The current restoration</p>
        <h2>The game is the game.</h2>
        <p>The new Go server treats the original C implementation as the oracle. Player-facing behavior is preserved rather than redesigned.</p>
        <p><a href="/about/project/">See the current work and how to help <span aria-hidden="true">→</span></a></p>
      </aside>
    </section>

    <section class="dispatch container">
      <header>
        <div>
          <p class="eyebrow">Dispatch</p>
          <h2>Notes from the restoration</h2>
        </div>
        <a href="/blog/">All posts <span aria-hidden="true">→</span></a>
      </header>
      <ol class="dispatch-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .75rem; font-weight: 700; letter-spacing: .12em; margin-bottom: var(--space-xs); text-transform: uppercase; }
  .cover { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(18rem, .55fr); gap: var(--space-xl); align-items: end; padding-block: var(--space-xl); }
  .cover h1 { max-width: 14ch; font-size: clamp(3.5rem, 7vw, 6.5rem); line-height: .98; }
  .lede { max-width: 48ch; color: var(--ink-muted); font-size: 1.2rem; }
  .cover-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }
  .btn-primary, .btn-secondary { display: inline-block; border: 1px solid var(--rule); padding: .65rem 1rem; font-family: var(--font-display); color: var(--ink); }
  .btn-primary { border-color: var(--accent); background: var(--accent); color: var(--paper); }
  .btn-primary:hover { background: var(--accent-deep); text-decoration: none; }
  .btn-secondary:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
  .connection-slip { border-top: 3px solid var(--accent); background: var(--paper-deep); padding: var(--space-md); }
  .slip-label { font-family: var(--font-display); font-size: 1.1rem; }
  .connection-slip dl { margin: 0 0 var(--space-md); }
  .connection-slip dl div { display: grid; grid-template-columns: 5rem 1fr; gap: var(--space-sm); border-top: 1px solid var(--rule); padding-block: var(--space-sm); }
  .connection-slip dt { color: var(--ink-muted); }
  .connection-slip dd { margin: 0; overflow-wrap: anywhere; font-family: var(--font-mono); font-size: .8rem; }
  .connection-slip p:last-child { margin: 0; }
  .world-desk { border-block: 1px solid var(--rule); background: var(--paper-deep); padding-block: var(--space-xl); }
  .world-grid { display: grid; grid-template-columns: minmax(17rem, .7fr) minmax(26rem, 1.3fr); gap: var(--space-xl); }
  .world-intro p:last-child { color: var(--ink-muted); }
  .guide-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .guide-list li { border-bottom: 1px solid var(--rule); }
  .guide-list a { display: grid; grid-template-columns: 9rem 1fr 1rem; gap: var(--space-md); align-items: baseline; padding-block: var(--space-md); color: var(--ink); }
  .guide-list a:hover { color: var(--accent); text-decoration: none; }
  .guide-list h3 { font-size: 1.2rem; margin: 0; }
  .guide-list p { color: var(--ink-muted); margin: 0; }
  .record { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .55fr); gap: var(--space-xl); padding-block: var(--space-xl); }
  .archive-feature { border-top: 3px solid var(--rule); padding-top: var(--space-md); }
  .archive-feature h2 { max-width: 21ch; font-size: clamp(2rem, 4vw, 3.5rem); }
  .archive-feature > p:not(.eyebrow) { color: var(--ink-muted); }
  .record-links { display: flex; flex-wrap: wrap; gap: var(--space-lg); }
  .restoration-note { align-self: start; border-top: 3px solid var(--accent); background: var(--paper-deep); padding: var(--space-md); }
  .restoration-note h2 { font-size: 1.45rem; }
  .restoration-note p:not(.eyebrow) { color: var(--ink-muted); }
  .dispatch { border-top: 1px solid var(--rule); padding-block: var(--space-lg) var(--space-xl); }
  .dispatch header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-md); }
  .dispatch header h2 { margin: 0; }
  .dispatch-list { list-style: none; margin: var(--space-lg) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .dispatch-list li { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-lg); padding-block: var(--space-md); border-bottom: 1px solid var(--rule); }
  .dispatch-list time { color: var(--ink-muted); font-family: var(--font-mono); font-size: .72rem; }
  .dispatch-list h3 { font-size: 1.2rem; margin-bottom: var(--space-xs); }
  .dispatch-list h3 a { color: var(--ink); }
  .dispatch-list h3 a:hover { color: var(--accent); text-decoration: none; }
  @media (max-width: 800px) {
    .cover, .world-grid, .record { grid-template-columns: 1fr; gap: var(--space-lg); }
    .connection-slip { max-width: 30rem; }
  }
  @media (max-width: 560px) {
    .cover, .world-grid, .record, .dispatch { padding-inline: var(--space-md); }
    .cover h1 { font-size: clamp(3rem, 15vw, 4.5rem); }
    .guide-list a { grid-template-columns: 1fr 1rem; gap: var(--space-xs) var(--space-sm); }
    .guide-list p { grid-column: 1; }
    .guide-list a > span { grid-column: 2; grid-row: 1; }
    .dispatch-list li { grid-template-columns: 1fr; gap: var(--space-xs); }
  }
</style>
