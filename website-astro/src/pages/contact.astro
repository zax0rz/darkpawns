---
import Base from '../layouts/Base.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Base title="Contact Dark Pawns" description="Send a private message about Dark Pawns, its history, or the current restoration.">
  {turnstileSiteKey && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <div class="contact-page container">
    <header>
      <p class="eyebrow">Private correspondence</p>
      <h1>Were you there?</h1>
      <p class="lede">Use this form if you played Dark Pawns, remember part of its history, or want to help with the restoration. Your reply address is sent privately and is not published.</p>
    </header>

    <div class="contact-grid">
      <form id="contact-form" class="contact-form" data-configured={turnstileSiteKey ? 'true' : 'false'}>
        <div class="field-pair">
          <label>
            <span>Character name <small>optional</small></span>
            <input name="character" type="text" maxlength="80" autocomplete="nickname" />
          </label>
          <label>
            <span>Years played <small>optional</small></span>
            <input name="years" type="text" maxlength="80" placeholder="For example, 2001 to 2005" />
          </label>
        </div>
        <label>
          <span>Private reply address</span>
          <input name="email" type="email" maxlength="254" autocomplete="email" required />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" minlength="20" maxlength="4000" rows="9" required></textarea>
        </label>
        <label class="honeypot" aria-hidden="true">
          <span>Website</span>
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        {turnstileSiteKey ? (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light"></div>
        ) : (
          <p class="preview-note">Spam protection is not configured in this local preview.</p>
        )}
        <p class="privacy-note">The <a href="/privacy/">privacy page</a> explains how messages and spam checks are handled.</p>
        <div class="form-actions">
          <button class="btn-primary" type="submit" disabled={!turnstileSiteKey}>Send privately</button>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside>
        <h2>What happens next</h2>
        <p>The message goes to Zach Greene. If you provide a reply address, he can write back to you directly.</p>
        <p>Contact details are not added to the archive or exposed on this site.</p>
        <p>This form is also the place to request a correction or ask for archived material to be removed.</p>
      </aside>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || form.dataset.configured !== 'true') return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fields = new FormData(form);
    const payload = {
      character: fields.get('character'),
      years: fields.get('years'),
      email: fields.get('email'),
      message: fields.get('message'),
      website: fields.get('website'),
      turnstile: fields.get('cf-turnstile-response'),
    };
    if (button) button.disabled = true;
    status.textContent = 'Sending...';
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json();
      status.textContent = result.message ?? 'The form returned an unexpected response.';
      if (response.ok) {
        form.reset();
        window.turnstile?.reset();
      }
    } catch {
      status.textContent = 'The message could not be sent. Please try again later.';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .contact-page { padding-block: var(--space-xl); }
  .contact-page header { max-width: 50rem; margin-bottom: var(--space-xl); }
  .contact-page h1 { max-width: 12ch; font-size: clamp(3rem, 8vw, 6rem); }
  .eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .75rem; font-weight: 700; letter-spacing: .12em; margin-bottom: var(--space-xs); text-transform: uppercase; }
  .lede { color: var(--ink-muted); font-size: 1.2rem; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(17rem, .65fr); gap: var(--space-xl); align-items: start; }
  .contact-form { border-top: 3px solid var(--rule); padding-top: var(--space-lg); }
  .field-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  label { display: block; margin-bottom: var(--space-md); }
  label > span { display: block; margin-bottom: var(--space-xs); font-family: var(--font-display); }
  label small { color: var(--ink-muted); font-family: var(--font-body); }
  input, textarea { width: 100%; border: 1px solid var(--rule); border-radius: 2px; background: var(--paper); color: var(--ink); padding: .7rem; font: inherit; }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .preview-note { border-block: 1px solid var(--rule); color: var(--ink-muted); padding-block: var(--space-sm); }
  .privacy-note { color: var(--ink-muted); font-size: .85rem; }
  .form-actions { display: flex; align-items: center; gap: var(--space-md); margin-top: var(--space-md); }
  .btn-primary { border: 1px solid var(--accent); background: var(--accent); color: var(--paper); padding: .65rem 1rem; font-family: var(--font-display); font-size: 1rem; }
  .btn-primary:hover:not(:disabled) { background: var(--accent-deep); }
  .btn-primary:disabled { background: var(--ink-muted); border-color: var(--ink-muted); cursor: not-allowed; }
  .form-status { color: var(--ink-muted); margin: 0; }
  aside { border-top: 3px solid var(--accent); background: var(--paper-deep); padding: var(--space-md); }
  aside h2 { font-size: 1.35rem; }
  aside p { color: var(--ink-muted); }
  @media (max-width: 720px) { .contact-grid, .field-pair { grid-template-columns: 1fr; } .contact-grid { gap: var(--space-lg); } }
  @media (max-width: 520px) { .contact-page { padding-inline: var(--space-md); } .form-actions { align-items: flex-start; flex-direction: column; } }
</style>
