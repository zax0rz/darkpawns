---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { zonesSorted, totalRooms } from '../../lib/zones';

const entries = await getCollection('world', ({ data }) => !data.draft);
const byId = Object.fromEntries(entries.map((e) => [e.id, e]));

const chapters = [
  {
    num: 'I',
    title: 'Character & Progression',
    subtitle: 'Who you are at creation, what guilds teach you, and the road from level 1 to Hero and Remort.',
    ids: ['classes', 'races', 'progression', 'skills'],
  },
  {
    num: 'II',
    title: 'Rules of Engagement',
    subtitle: 'THAC0, saving throws, combat ticks, PK flags, and the command table loaded by the server.',
    ids: ['systems', 'mechanics', 'commands'],
  },
  {
    num: 'III',
    title: 'Atlas & Myth',
    subtitle: 'The three continents, the ninety-five zones, and Friar Drake’s creation letter.',
    ids: ['zones', 'world-creation', 'lore'],
  },
];

const baseClasses = [
  { name: 'Warrior', role: 'Frontline melee, rescue, bash, weapon mastery' },
  { name: 'Cleric', role: 'Divine healing, sanctuary, blunt weapons' },
  { name: 'Mage', role: 'Arcane offensive & utility spellcraft' },
  { name: 'Thief', role: 'Backstab, stealth, lockpicking, urban survival' },
  { name: 'Ninja', role: 'Southern espionage, martial arts, ambush (Human only)' },
  { name: 'Psionic', role: 'Mental disciplines, telekinetic & mind powers' },
];

const remortClasses = [
  { name: 'Paladin', from: 'Warrior', role: 'Holy martial champion of the church' },
  { name: 'Ranger', from: 'Warrior', role: 'Wilderness tracker and guardian' },
  { name: 'Avatar', from: 'Cleric', role: 'Emissary of the Holy Forces' },
  { name: 'Magus', from: 'Mage', role: 'Cosmic-scale arcane spellcaster' },
  { name: 'Assassin', from: 'Thief / Ninja', role: 'Master of lethal strikes and shadow craft' },
  { name: 'Mystic', from: 'Psionic', role: 'Enlightened master of time, space, and mind' },
];

const races = [
  { name: 'Human', trait: 'Versatile · Only race admitted to Ninja guilds' },
  { name: 'Elf', trait: 'High dexterity · Woodland & arcane affinity' },
  { name: 'Dwarf', trait: 'High strength & constitution · Underground resilience' },
  { name: 'Kender', trait: 'Small, fearless · Adept at stealth and pockets' },
  { name: 'Minotaur', trait: 'Massive frame · Innate labyrinth direction sense' },
  { name: 'Rakshasa', trait: 'Tiger-headed spirit in flesh · High magic resistance' },
  { name: 'Ssaur', trait: 'Swamp-born lizardfolk · High constitution & survival' },
];
---

<Base
  title="The World | Dark Pawns"
  description="The Dark Pawns Player’s Field Manual: classes, races, skills, combat formulas, and the ninety-five zones of the world."
>
  <article class="container world-hub">
    <header class="world-header">
      <p class="eyebrow">Player’s Field Manual · {zonesSorted.length} Zones · {totalRooms.toLocaleString('en-US')} Rooms</p>
      <h1>The World</h1>
      <p class="lede">
        Three continents, {zonesSorted.length} zones, six base classes, six remort paths, seven mortal races, and an
        AD&amp;D-derived combat engine that reproduces the original C codebase’s rules down to the dice roll.
      </p>

      <div class="atlas-callout">
        <div>
          <span class="atlas-label">Live World Reference</span>
          <p>
            Every zone, room, mob, and object documented here is cross-linked to the active server files.
          </p>
        </div>
        <div class="atlas-links">
          <a href="/map/">Interactive 3D/2D Map →</a>
          <a href="/database/">Mob &amp; Item Codex →</a>
          <a href="/zones/">All {zonesSorted.length} Zone Records →</a>
        </div>
      </div>
    </header>

    {chapters.map((chapter) => {
      const items = chapter.ids.map((id) => byId[id]).filter(Boolean);
      return (
        <section class="chapter" aria-labelledby={`chapter-${chapter.num}`}>
          <header class="chapter-header">
            <div class="chapter-title-row">
              <span class="chapter-num">Part {chapter.num}</span>
              <h2 id={`chapter-${chapter.num}`}>{chapter.title}</h2>
            </div>
            <p class="chapter-sub">{chapter.subtitle}</p>
          </header>

          <ol class="chapter-list">
            {items.map((entry) => (
              <li class="chapter-item">
                <a href={`/world/${entry.id}/`}>
                  <div class="chapter-item-main">
                    <h3>{entry.data.title}</h3>
                    <p>{entry.data.description}</p>
                  </div>
                  <span class="chapter-item-cta">Read section →</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}

    <!-- Quick Reference Ledger: Classes & Races at a Glance -->
    <section class="roster-section" aria-labelledby="roster-heading">
      <header class="chapter-header">
        <div class="chapter-title-row">
          <span class="chapter-num">Reference</span>
          <h2 id="roster-heading">Mortal Lineages &amp; Calling</h2>
        </div>
        <p class="chapter-sub">
          At character creation you choose one of seven mortal races and one of six base classes; reaching Hero status opens the remort paths.
        </p>
      </header>

      <div class="roster-grid">
        <div class="roster-col">
          <div class="roster-col-head">
            <h3>Six Base Classes</h3>
            <a href="/world/classes/">Full class notes →</a>
          </div>
          <dl class="roster-dl">
            {baseClasses.map((c) => (
              <div>
                <dt>{c.name}</dt>
                <dd>{c.role}</dd>
              </div>
            ))}
          </dl>

          <div class="roster-col-head roster-subhead">
            <h3>Remort Paths</h3>
            <a href="/world/mechanics/">Remort rules →</a>
          </div>
          <dl class="roster-dl">
            {remortClasses.map((c) => (
              <div>
                <dt>{c.name} <small>({c.from})</small></dt>
                <dd>{c.role}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="roster-col">
          <div class="roster-col-head">
            <h3>Seven Mortal Races</h3>
            <a href="/world/races/">Full race profiles →</a>
          </div>
          <dl class="roster-dl">
            {races.map((r) => (
              <div>
                <dt>{r.name}</dt>
                <dd>{r.trait}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .world-hub {
    padding-block: var(--space-xl);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-xs);
  }
  .world-header h1 {
    margin-bottom: var(--space-sm);
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.15rem;
    max-width: 62ch;
    margin: 0 0 var(--space-lg);
  }

  .atlas-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--ink);
    border-left: 4px solid var(--accent);
    background: var(--paper-deep);
    margin-bottom: var(--space-xl);
  }
  .atlas-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 0.15rem;
  }
  .atlas-callout p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }
  .atlas-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .atlas-links a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }
  .atlas-links a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
    text-decoration: none;
  }

  /* Chapters */
  .chapter {
    margin-bottom: var(--space-xl);
  }
  .chapter-header {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .chapter-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: 0.2rem;
  }
  .chapter-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .chapter-title-row h2 {
    margin: 0;
    font-size: 1.75rem;
  }
  .chapter-sub {
    margin: 0;
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .chapter-item {
    border-bottom: 1px solid var(--rule);
  }
  .chapter-item a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xs);
    color: var(--ink);
    text-decoration: none;
  }
  .chapter-item a:hover {
    background: var(--paper-deep);
    text-decoration: none;
  }
  .chapter-item-main h3 {
    margin: 0 0 0.2rem;
    font-size: 1.375rem;
    color: var(--ink);
  }
  .chapter-item a:hover h3 {
    color: var(--accent);
  }
  .chapter-item-main p {
    margin: 0;
    color: var(--ink-muted);
    max-width: 58ch;
  }
  .chapter-item-cta {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  /* Quick Reference Ledger */
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-md);
  }
  .roster-col {
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: var(--space-md) var(--space-lg);
  }
  .roster-col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.35rem;
    margin-bottom: var(--space-sm);
  }
  .roster-subhead {
    margin-top: var(--space-lg);
  }
  .roster-col-head h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .roster-col-head a {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .roster-dl {
    margin: 0;
  }
  .roster-dl div {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-sm);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .roster-dl div:last-child {
    border-bottom: 0;
  }
  .roster-dl dt {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }
  .roster-dl dt small {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .roster-dl dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .roster-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
  @media (max-width: 600px) {
    .chapter-item a {
      flex-direction: column;
      gap: var(--space-xs);
    }
    .roster-dl div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
