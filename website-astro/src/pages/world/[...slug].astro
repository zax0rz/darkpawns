---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('world', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} | Dark Pawns`} description={entry.data.description} canonicalPath={entry.data.canonicalPath}>
  <link slot="head" rel="alternate" type="text/markdown" href={`/world/${entry.id}.md`} title={`${entry.data.title} as Markdown`} />
  <article class="container world-article">
    <Breadcrumb trail={[{ label: 'World', href: '/world/' }, { label: entry.data.title }]} />
    <h1>{entry.data.title}</h1>
    {entry.data.canonicalPath && (
      <p class="primary-source">
        This page still reproduces a recovered page verbatim.
        <a href={entry.data.canonicalPath}>Read it in the Archive with its provenance.</a>
      </p>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .world-article { padding-block: var(--space-lg) var(--space-xl); }
  .primary-source {
    max-width: var(--content-width);
    border-left: 2px solid var(--accent);
    padding: 0.2rem 0 0.2rem var(--space-md);
    color: var(--ink-muted);
  }
  .world-article > h1 { margin-bottom: var(--space-lg); }
</style>
