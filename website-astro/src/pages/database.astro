---
import Base from '../layouts/Base.astro';
import { mobs, items } from '../lib/database';

const mobCount = mobs.length.toLocaleString('en-US');
const itemCount = items.length.toLocaleString('en-US');
---

<Base
  title="Mob & Item Database | Dark Pawns"
  description={`Search and cross-reference all ${mobCount} mobs and ${itemCount} items from the active Dark Pawns world files, integrated with the world map.`}
  hideFooter={true}
>
  <section id="db-page" aria-label="Dark Pawns Mob and Item Database">
    <!-- Top Header & Filter Bar -->
    <header id="db-toolbar">
      <div class="db-toolbar-top">
        <div class="db-title-group">
          <div class="db-tab-group" role="tablist" aria-label="Database Record Type">
            <button
              id="tab-mobs"
              class="db-tab active"
              role="tab"
              aria-selected="true"
              data-tab="mobs"
              type="button"
            >
              Mobs <span id="count-mobs" class="tab-count">{mobCount}</span>
            </button>
            <button
              id="tab-items"
              class="db-tab"
              role="tab"
              aria-selected="false"
              data-tab="items"
              type="button"
            >
              Items <span id="count-items" class="tab-count">{itemCount}</span>
            </button>
          </div>
          <nav class="db-static-links" aria-label="Full record directories">
            <a href="/mobs/">All mobs</a>
            <span aria-hidden="true">·</span>
            <a href="/items/">All items</a>
            <span aria-hidden="true">·</span>
            <a href="/map/">World map</a>
          </nav>
        </div>

        <div class="db-search-group">
          <label for="db-search" class="visually-hidden">Filter records by name, keyword, or VNUM</label>
          <input
            type="search"
            id="db-search"
            placeholder="Filter mobs by name, keyword, zone, or #VNUM..."
            autocomplete="off"
            spellcheck="false"
          />
          <button id="db-clear-btn" class="db-reset-btn" type="button" hidden>Reset filters</button>
        </div>
      </div>

      <div class="db-toolbar-filters">
        <div class="filter-field">
          <label for="filter-zone">Zone</label>
          <select id="filter-zone">
            <option value="">All Zones</option>
          </select>
        </div>

        <!-- Mob-specific filters -->
        <div class="filter-field mob-only-filter" id="field-mob-level">
          <label for="filter-level-range">Level</label>
          <select id="filter-level-range">
            <option value="">All Levels</option>
            <option value="1-10">Levels 1-10</option>
            <option value="11-20">Levels 11-20</option>
            <option value="21-30">Levels 21-30</option>
            <option value="31-99">Level 31+</option>
          </select>
        </div>

        <div class="filter-field mob-only-filter" id="field-mob-align">
          <label for="filter-alignment">Alignment</label>
          <select id="filter-alignment">
            <option value="">All Alignments</option>
            <option value="good">Good (+300 and up)</option>
            <option value="neutral">Neutral</option>
            <option value="evil">Evil (-300 and below)</option>
          </select>
        </div>

        <div class="filter-field mob-only-filter" id="field-mob-role">
          <label for="filter-mob-role">Trait</label>
          <select id="filter-mob-role">
            <option value="">All Mobs</option>
            <option value="shop">Shopkeepers</option>
            <option value="aggr">Aggressive</option>
            <option value="drops">Carries / Equips Loot</option>
            <option value="script">Scripted (Lua)</option>
          </select>
        </div>

        <!-- Item-specific filters -->
        <div class="filter-field item-only-filter" id="field-item-type" hidden>
          <label for="filter-item-type">Type</label>
          <select id="filter-item-type">
            <option value="">All Types</option>
          </select>
        </div>

        <div class="filter-field item-only-filter" id="field-item-wear" hidden>
          <label for="filter-item-wear">Wear Slot</label>
          <select id="filter-item-wear">
            <option value="">All Slots</option>
          </select>
        </div>

        <div class="filter-field item-only-filter" id="field-item-affect" hidden>
          <label for="filter-item-affect">Magical Affect</label>
          <select id="filter-item-affect">
            <option value="">Any Affect</option>
          </select>
        </div>

        <div class="filter-field filter-sort">
          <label for="db-sort">Sort</label>
          <select id="db-sort">
            <option value="zone">By Zone</option>
            <option value="lvl-desc">Highest Level</option>
            <option value="lvl-asc">Lowest Level</option>
            <option value="name">Alphabetical</option>
            <option value="vnum">By VNUM</option>
          </select>
        </div>

        <div class="db-filter-summary" id="db-result-summary" aria-live="polite">
          Loading records...
        </div>
      </div>
    </header>

    <!-- Main Split Workspace -->
    <div id="db-main">
      <!-- Left Column: Full-height Record List -->
      <aside id="db-sidebar" aria-label="Filtered Records">
        <div id="db-results-container" tabindex="0">
          <div id="db-loading">Loading world database...</div>
          <ul id="db-results-list" role="listbox" aria-label="Database records"></ul>
        </div>
      </aside>

      <!-- Right Column: Complete Record Sheet & Map Integration -->
      <div id="db-content" tabindex="0">
        <div id="db-empty-state">
          <p class="empty-eyebrow">World File Inspector</p>
          <h2>Select a mob or item from the index</h2>
          <p>
            Every creature, weapon, armor piece, spell scroll, and shopkeeper parsed directly from the
            server's active world files. Select any record to inspect its complete attributes, equipment resets,
            and interactive spawn locations on the world map.
          </p>
        </div>
        <div id="db-detail-view" hidden></div>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/database.js';
  </script>
</Base>

<style is:global>
  #db-page {
    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-md: 1.125rem;
    --text-lg: 1.25rem;
    --text-xl: 1.5rem;
    --text-2xl: 2rem;
    --space-2xl: 3rem;
    display: flex;
    flex-direction: column;
    height: calc(100dvh - 7.75rem);
    min-height: 34rem;
    background: var(--paper);
    color: var(--ink);
    border-top: 2px solid var(--ink);
    overflow: hidden;
  }

  /* ── Top Toolbar ── */
  #db-toolbar {
    flex-shrink: 0;
    background: var(--paper-deep);
    border-bottom: 1px solid var(--ink);
    padding: var(--space-sm) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .db-toolbar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .db-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .db-tab-group {
    display: inline-flex;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .db-tab {
    appearance: none;
    background: transparent;
    border: none;
    border-right: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .db-tab:last-child {
    border-right: none;
  }

  .db-tab:hover:not(.active) {
    background: var(--paper-deep);
    color: var(--accent);
  }

  .db-tab.active {
    background: var(--accent);
    color: var(--paper);
  }

  .tab-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    opacity: 0.85;
  }

  .db-static-links {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .db-static-links a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .db-static-links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .db-search-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex: 1 1 20rem;
    max-width: 34rem;
  }

  #db-search {
    width: 100%;
    background: var(--paper);
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.45rem 0.75rem;
    border-radius: 0;
  }

  #db-search::placeholder {
    color: var(--ink-muted);
  }

  #db-search:focus {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .db-reset-btn {
    appearance: none;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.45rem 0.65rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .db-reset-btn:hover {
    background: var(--accent);
    color: var(--paper);
  }

  /* ── Filter Bar Row ── */
  .db-toolbar-filters {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding-top: var(--space-xs);
    border-top: 1px solid var(--rule);
  }

  .filter-field {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .filter-field[hidden] {
    display: none !important;
  }

  .filter-field label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .filter-field select {
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.3rem 0.5rem;
    border-radius: 0;
    cursor: pointer;
    max-width: 14rem;
  }

  .filter-field select:hover,
  .filter-field select:focus {
    border-color: var(--ink);
    outline: none;
  }

  .db-filter-summary {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  /* ── Main Split Pane ── */
  #db-main {
    display: grid;
    grid-template-columns: 23rem minmax(0, 1fr);
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Left Record List ── */
  #db-sidebar {
    border-right: 1px solid var(--ink);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  #db-results-container {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
  }

  #db-loading {
    padding: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  #db-results-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .db-zone-divider {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--paper-deep);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.35rem var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .db-list-item {
    border-bottom: 1px solid var(--rule);
    padding: 0.6rem var(--space-md);
    cursor: pointer;
    background: var(--paper);
    transition: background-color 0.1s ease;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .db-list-item:hover {
    background: var(--paper-deep);
  }

  .db-list-item.active {
    background: var(--paper-deep);
    border-left: 3px solid var(--accent);
    padding-left: calc(var(--space-md) - 3px);
  }

  .db-item-row-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .db-item-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .db-list-item.active .db-item-title {
    color: var(--accent);
  }

  .db-item-vnum {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    flex-shrink: 0;
  }

  .db-item-row-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .db-item-badges {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .db-mini-tag {
    border: 1px solid var(--rule);
    padding: 0.05rem 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--paper);
  }

  .db-mini-tag.tag-accent {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ── Right Pane: Record Detail Sheet ── */
  #db-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-xl);
    background: var(--paper);
    min-height: 0;
  }

  #db-empty-state {
    max-width: 36rem;
    margin: var(--space-2xl) auto;
    padding: var(--space-xl);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .empty-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  #db-empty-state h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-sm);
  }

  #db-empty-state p {
    color: var(--ink-muted);
    margin: 0;
  }

  /* ── Record Sheet Layout ── */
  .sheet {
    max-width: 64rem;
    margin: 0 auto;
    padding-bottom: var(--space-2xl);
  }

  .sheet-mobile-back {
    display: none;
    appearance: none;
    background: var(--paper-deep);
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.45rem 0.75rem;
    margin-bottom: var(--space-md);
    cursor: pointer;
  }

  .sheet-header {
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    padding: var(--space-md) 0;
    margin-bottom: var(--space-lg);
  }

  .sheet-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xs);
  }

  .sheet-eyebrow {
    color: var(--accent);
    font-weight: 600;
  }

  .sheet-actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .sheet-actions a,
  .sheet-actions button {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-decoration: underline;
    cursor: pointer;
    text-transform: none;
    letter-spacing: normal;
  }

  .sheet-actions a:hover,
  .sheet-actions button:hover {
    color: var(--accent);
  }

  .sheet-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-xs);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .sheet-lede {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-style: italic;
    color: var(--ink-muted);
    margin: 0;
  }

  .sheet-keywords {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  /* ── Sheet Grid & Sections ── */
  .sheet-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.95fr) minmax(20rem, 1.05fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .sheet-section {
    margin-bottom: var(--space-lg);
  }

  .sheet-section-title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.35rem;
    margin: 0 0 var(--space-sm);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .sheet-section-title small {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
    text-transform: none;
    letter-spacing: normal;
  }

  /* ── Key-Value Stat Table ── */
  .sheet-dl {
    display: grid;
    grid-template-columns: minmax(8rem, 42%) 1fr;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .sheet-dl dt,
  .sheet-dl dd {
    margin: 0;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .sheet-dl dt {
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-right: var(--space-sm);
  }

  .sheet-dl dd {
    color: var(--ink);
    font-weight: 600;
    text-align: right;
    overflow-wrap: anywhere;
  }

  /* ── 6-Attribute Strip ── */
  .attr-strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    margin-top: var(--space-sm);
  }

  .attr-cell {
    padding: 0.45rem 0.25rem;
    text-align: center;
    border-right: 1px solid var(--rule);
    font-family: var(--font-mono);
  }

  .attr-cell:last-child {
    border-right: none;
  }

  .attr-label {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .attr-val {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
  }

  /* ── Flags & Affects ── */
  .sheet-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sheet-tag {
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink);
  }

  .sheet-tag.tag-affect {
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
    background: var(--paper);
  }

  /* ── Prose / Verbatim Descriptions ── */
  .sheet-prose {
    background: var(--paper-deep);
    border-left: 2px solid var(--accent);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--ink);
    margin: 0;
  }

  .sheet-prose p {
    margin: 0;
  }

  .sheet-prose p + p {
    margin-top: 0.75em;
  }

  .sheet-prose.is-drawing {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.35;
    white-space: pre;
    overflow-x: auto;
  }

  /* ── Cross-Reference Lists (Spawns, Equipment, Mobs, Shops) ── */
  .xref-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .xref-item {
    border-bottom: 1px solid var(--rule);
    padding: 0.55rem 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .xref-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .xref-link {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    text-decoration: none;
  }

  .xref-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .xref-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .xref-sub a {
