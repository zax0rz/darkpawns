---
import { getCollection, render } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
export async function getStaticPaths() {
  return (await getCollection('generatedDocs')).map((entry) => ({ params: { slug: entry.id.replace(/(^|\/)index$/, '') }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const source = entry.data.sourcePath?.endsWith('/') ? 'website-astro/scripts/generate-docs.mjs' : entry.data.sourcePath;
---
<StarlightPage frontmatter={{ ...entry.data, editUrl: `https://github.com/zax0rz/darkpawns/edit/main/${source ?? 'website-astro/scripts/generate-docs.mjs'}` }} headings={headings}><Content /></StarlightPage>
