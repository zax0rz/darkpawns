---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('docs', ({ data }) => !data.draft);

const tasks = [
  {
    title: 'Run a local server',
    description: 'Build the Go server, configure SQLite persistence, and connect locally.',
    href: '/docs/getting-started/local-server/',
    label: 'Operator',
  },
  {
    title: 'Understand the architecture',
    description: 'See how sessions, the world, combat, scripting, and storage fit together.',
    href: '/docs/server/architecture/',
    label: 'Developer',
  },
  {
    title: 'Work on the faithful port',
    description: 'Learn the C-oracle workflow and the rules that prevent silent behavioral drift.',
    href: '/docs/research/port-fidelity/',
    label: 'Researcher',
  },
];

const sections = [
  {
    id: 'getting-started',
    num: '01',
    title: 'Getting Started',
    subtitle: 'Build the single-binary Go server, configure persistence, and verify local play.',
  },
  {
    id: 'server',
    num: '02',
    title: 'Server & Development',
    subtitle: 'Package architecture, parser internals, contribution rules, and build gates.',
  },
  {
    id: 'research',
    num: '03',
    title: 'Port Fidelity & Research',
    subtitle: 'C-oracle differential testing, proof levels, string censuses, and the fidelity rulebook.',
  },
] as const;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title="Documentation | Dark Pawns"
  description="Technical documentation for running, extending, and verifying the Dark Pawns Go server."
>
  <article class="container docs-hub">
    <header class="docs-header">
      <p class="eyebrow">Operators · Developers · Researchers</p>
      <h1>Documentation</h1>
      <p class="lede">
        The technical manual for the Dark Pawns software. If you want to play, start with{' '}
        <a href="/play/">Play</a>; if you need an in-game command or spell, use <a href="/help/">Help</a>.
      </p>
    </header>

    <div class="task-grid" aria-label="Quick start paths">
      {tasks.map((task) => (
        <a class="task" href={task.href}>
          <span class="task-label">{task.label}</span>
          <h2>{task.title}</h2>
          <p>{task.description}</p>
        </a>
      ))}
    </div>

    <div class="directory">
      {sections.map((sec) => {
        const secEntries = entries
          .filter((e) => e.data.section === sec.id)
          .sort((a, b) => a.data.order - b.data.order);
        return (
          <section class="doc-section" id={sec.id} aria-labelledby={`sec-${sec.id}`}>
            <header class="sec-header">
              <div class="sec-title-row">
                <span class="sec-num">Section {sec.num}</span>
                <h2 id={`sec-${sec.id}`}>
                  <a href={`/docs/${sec.id}/`}>{sec.title}</a>
                </h2>
                <span class="sec-count">{secEntries.length} manuals</span>
              </div>
              <p class="sec-sub">{sec.subtitle}</p>
            </header>

            <ol class="manual-list">
              {secEntries.map((entry) => (
                <li class="manual-row">
                  <a href={`/docs/${entry.id}/`}>
                    <div class="manual-main">
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.description}</p>
                    </div>
                    <div class="manual-meta">
                      <span class="manual-audience">{entry.data.audience.replace('-', ' ')}</span>
                      <span class="manual-source">
                        <code>{entry.data.sourcePath}</code> · {fmtDate(entry.data.updated)}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  </article>
</Base>

<style>
  .docs-hub {
    padding-block: var(--space-xl);
  }
  .eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .docs-header h1 {
    margin-bottom: var(--space-sm);
  }
  .lede {
    max-width: 58ch;
    color: var(--ink-muted);
    font-size: 1.15rem;
    margin: 0;
  }

  .task-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-block: var(--space-xl);
    border: 1px solid var(--ink);
    background: var(--ink);
  }
  .task {
    display: flex;
    flex-direction: column;
    padding: var(--space-md) var(--space-lg);
    color: var(--ink);
    background: var(--paper-deep);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .task:hover {
    background: var(--paper);
    text-decoration: none;
  }
  .task-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .task h2 {
    margin: var(--space-xs) 0;
    font-size: 1.375rem;
    color: var(--ink);
  }
  .task:hover h2 {
    color: var(--accent);
  }
  .task p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .doc-section {
    margin-bottom: var(--space-xl);
  }
  .sec-header {
    border-top: 2px solid var(--ink);
    padding-top: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .sec-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-bottom: 0.2rem;
  }
  .sec-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .sec-title-row h2 {
    margin: 0;
    font-size: 1.75rem;
  }
  .sec-title-row h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .sec-title-row h2 a:hover {
    color: var(--accent);
  }
  .sec-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .sec-sub {
    margin: 0;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .manual-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .manual-row {
    border-bottom: 1px solid var(--rule);
  }
  .manual-row a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xs);
    color: var(--ink);
    text-decoration: none;
  }
  .manual-row a:hover {
    background: var(--paper-deep);
    text-decoration: none;
  }
  .manual-main h3 {
    margin: 0 0 0.2rem;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .manual-row a:hover h3 {
    color: var(--accent);
  }
  .manual-main p {
    margin: 0;
    color: var(--ink-muted);
    max-width: 54ch;
  }
  .manual-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    flex-shrink: 0;
    text-align: right;
  }
  .manual-audience {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .manual-source {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .task-grid {
      grid-template-columns: 1fr;
    }
    .manual-row a {
      flex-direction: column;
      gap: var(--space-xs);
    }
    .manual-meta {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
