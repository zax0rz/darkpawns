---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cleanKey = (t: string) => t.replace(/^['"`\s]+/, '').toUpperCase();
  const entries = await getCollection('help', ({ data }) => !data.draft);
  const cats = [...new Set(entries.map((e) => e.id.split('/')[0]))];
  return cats.map((category) => ({
    params: { category },
    props: {
      category,
      items: entries
        .filter((e) => e.id.startsWith(category + '/'))
        .sort((a, b) => cleanKey(a.data.title).localeCompare(cleanKey(b.data.title))),
      allCounts: Object.fromEntries(
        cats.map((c) => [c, entries.filter((e) => e.id.startsWith(c + '/')).length]),
      ),
    },
  }));
}

const { category, items, allCounts } = Astro.props;
const labels: Record<string, { title: string; desc: string }> = {
  commands: {
    title: 'Commands',
    desc: 'Every player command preserved from the original Dark Pawns help table, with syntax and combat lag notes.',
  },
  spells: {
    title: 'Spells',
    desc: 'The full spellbook: mana costs, casting syntax, targets, and effects.',
  },
  info: {
    title: 'Info & Lore',
    desc: 'Races, classes, towns, mechanics, and world reference entries.',
  },
  socials: {
    title: 'Socials',
    desc: 'Emotes and social commands across the realm. Mind the company.',
  },
  wizhelp: {
    title: 'Wizard Help',
    desc: 'Immortal administration and world-building documentation.',
  },
};

const order = ['commands', 'spells', 'info', 'socials', 'wizhelp'];
const label = labels[category]?.title ?? category;
const desc = labels[category]?.desc ?? `Help files in ${label}.`;

const getLetter = (title: string) => {
  const cleaned = title.replace(/^['"`\s]+/, '').toUpperCase();
  const ch = cleaned[0] || '#';
  return /[A-Z]/.test(ch) ? ch : '#';
};

const enriched = items.map((e) => ({
  id: e.id,
  title: e.data.title,
  description: e.data.description,
  letter: getLetter(e.data.title),
}));

const letters = [...new Set(enriched.map((e) => e.letter))].sort((a, b) =>
  a === '#' ? -1 : b === '#' ? 1 : a.localeCompare(b),
);

const byLetter = letters.map((letter) => ({
  letter,
  entries: enriched.filter((e) => e.letter === letter),
}));
---

<Base title={`${label} | Help | Dark Pawns`} description={`Help files: ${label} (${items.length} entries).`}>
  <article class="container help-cat">
    <header class="cat-header">
      <p class="crumb"><a href="/help/">Help Archive</a> &raquo; {label}</p>
      <div class="cat-title-row">
        <h1>{label}</h1>
        <span class="cat-badge">{items.length} entries</span>
      </div>
      <p class="lede">{desc}</p>

      <nav class="cat-tabs" aria-label="Help categories">
        <a class="cat-tab" href="/help/">All Help</a>
        {order.filter((c) => allCounts[c]).map((c) => (
          <a
            class:list={['cat-tab', { active: c === category }]}
            href={`/help/${c}/`}
            aria-current={c === category ? 'page' : undefined}
          >
            {labels[c]?.title ?? c} <span>{allCounts[c]}</span>
          </a>
        ))}
      </nav>
    </header>

    <div class="cat-toolbar">
      <div class="cat-search-wrap">
        <label for="cat-filter-input" class="visually-hidden">Filter {label}</label>
        <input
          id="cat-filter-input"
          type="search"
          placeholder={`Filter ${items.length} ${label.toLowerCase()} by name or syntax…`}
          autocomplete="off"
        />
      </div>
      <span class="cat-status" id="cat-result-count" aria-live="polite">
        Showing all {items.length} entries
      </span>
      <nav class="az-rail" aria-label="Jump to letter">
        {letters.map((letter) => (
          <a href={`#letter-${letter}`} class="az-link" data-letter-jump={letter}>
            {letter}
          </a>
        ))}
      </nav>
    </div>

    <div class="letter-groups">
      {byLetter.map((group) => (
        <section class="letter-group" id={`letter-${group.letter}`} data-letter-group={group.letter}>
          <header class="letter-header">
            <h2>{group.letter}</h2>
            <span class="letter-count">{group.entries.length}</span>
          </header>
          <ol class="topic-list">
            {group.entries.map((item) => (
              <li
                class="topic-row"
                data-search={`${item.title} ${item.description}`.toLowerCase()}
              >
                <a href={`/help/${item.id}/`}>
                  <span class="topic-name">{item.title}</span>
                  <span class="topic-desc">{item.description}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </article>

  <script>
    const input = document.getElementById('cat-filter-input') as HTMLInputElement | null;
    const groups = document.querySelectorAll<HTMLElement>('[data-letter-group]');
    const countEl = document.getElementById('cat-result-count');

    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let total = 0;
      groups.forEach((group) => {
        const rows = group.querySelectorAll<HTMLElement>('.topic-row');
        let visible = 0;
        rows.forEach((row) => {
          const match = !q || (row.dataset.search ?? '').includes(q);
          row.hidden = !match;
          if (match) visible++;
        });
        group.hidden = visible === 0;
        const badge = group.querySelector('.letter-count');
        if (badge) badge.textContent = String(visible);
        total += visible;

        const letter = group.dataset.letterGroup;
        const jump = document.querySelector<HTMLElement>(`[data-letter-jump="${letter}"]`);
        if (jump) jump.classList.toggle('is-dim', visible === 0);
      });
      if (countEl) {
        countEl.textContent = !q
          ? `Showing all ${total} entries`
          : `${total} ${total === 1 ? 'entry' : 'entries'} matching filter`;
      }
    });
  </script>
</Base>

<style>
  .help-cat {
    padding-block: var(--space-lg) var(--space-xl);
  }
  .crumb {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 var(--space-xs);
  }
  .cat-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }
  .cat-title-row h1 {
    margin: 0;
  }
  .cat-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.15rem;
    max-width: 60ch;
    margin: 0 0 var(--space-md);
  }
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-lg);
  }
  .cat-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    color: var(--ink);
    text-decoration: none;
  }
  .cat-tab span {
    color: var(--ink-muted);
    margin-left: 0.2rem;
  }
  .cat-tab:hover {
    border-color: var(--ink);
    text-decoration: none;
  }
  .cat-tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
  .cat-tab.active span {
    color: var(--paper);
  }

  .cat-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-lg);
  }
  .cat-search-wrap {
    flex: 1 1 20rem;
    max-width: 28rem;
  }
  #cat-filter-input {
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--ink);
  }
  #cat-filter-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .cat-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .az-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .az-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid transparent;
  }
  .az-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .az-link.is-dim {
    opacity: 0.3;
    pointer-events: none;
  }

  .letter-group {
    margin-bottom: var(--space-lg);
  }
  .letter-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.2rem;
  }
  .letter-header h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    margin: 0;
    color: var(--accent);
  }
  .letter-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .topic-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topic-row {
    border-bottom: 1px solid var(--rule);
  }
  .topic-row a {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
    padding: 0.48rem var(--space-xs);
    color: var(--ink);
    text-decoration: none;
  }
  .topic-row a:hover {
    background: var(--paper-deep);
    text-decoration: none;
  }
  .topic-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .topic-row a:hover .topic-name {
    color: var(--accent);
  }
  .topic-desc {
    font-size: 0.875rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 640px) {
    .topic-row a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
