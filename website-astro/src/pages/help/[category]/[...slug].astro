---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('help', ({ data }) => !data.draft)).sort((a, b) =>
    a.data.title.localeCompare(b.data.title),
  );
  return entries.map((entry) => {
    const [category, ...rest] = entry.id.split('/');
    const catEntries = entries.filter((e) => e.id.startsWith(category + '/'));
    const idx = catEntries.findIndex((e) => e.id === entry.id);
    const prev = idx > 0 ? catEntries[idx - 1] : null;
    const next = idx >= 0 && idx < catEntries.length - 1 ? catEntries[idx + 1] : null;
    return {
      params: { category, slug: rest.join('/') },
      props: {
        entry,
        prev: prev ? { id: prev.id, title: prev.data.title } : null,
        next: next ? { id: next.id, title: next.data.title } : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const category = entry.id.split('/')[0];
const labels: Record<string, string> = {
  commands: 'Commands',
  spells: 'Spells',
  info: 'Info & Lore',
  socials: 'Socials',
  wizhelp: 'Wizard Help',
};
const catLabel = labels[category] ?? category;
---

<Base title={`${entry.data.title} | Help | Dark Pawns`} description={entry.data.description}>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/help/${entry.id}.md`}
    title={`${entry.data.title} as Markdown`}
  />
  <article class="container help-entry">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/help/">Help Archive</a>
      <span aria-hidden="true">&raquo;</span>
      <a href={`/help/${category}/`}>{catLabel}</a>
      <span aria-hidden="true">&raquo;</span>
      <span>{entry.data.title}</span>
    </nav>

    <div class="manual-card">
      <header class="manual-header">
        <div class="manual-meta">
          <span class="manual-prompt">&gt; help {entry.data.title.toLowerCase()}</span>
          <div class="manual-actions">
            <span class="manual-cat">{catLabel}</span>
            <a href={`/help/${entry.id}.md`}>Raw .md</a>
          </div>
        </div>
        <h1>{entry.data.title}</h1>
      </header>

      <div class="manual-body prose">
        <Content />
      </div>
    </div>

    <nav class="manual-pager" aria-label={`Adjacent ${catLabel} entries`}>
      <div class="pager-cell">
        {prev && (
          <a href={`/help/${prev.id}/`}>
            <span class="pager-dir">← Previous in {catLabel}</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        )}
      </div>
      <div class="pager-cell pager-center">
        <a href={`/help/${category}/`}>All {catLabel}</a>
      </div>
      <div class="pager-cell pager-right">
        {next && (
          <a href={`/help/${next.id}/`}>
            <span class="pager-dir">Next in {catLabel} →</span>
            <span class="pager-title">{next.title}</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</Base>

<style>
  .help-entry {
    max-width: 52rem;
    padding-block: var(--space-lg) var(--space-xl);
  }
  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }
  .manual-card {
    border: 1px solid var(--ink);
    background: var(--paper-deep);
  }
  .manual-header {
    padding: var(--space-md) var(--space-lg);
    border-bottom: 2px solid var(--ink);
    background: var(--paper);
  }
  .manual-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin-bottom: var(--space-xs);
  }
  .manual-prompt {
    color: var(--accent);
    font-weight: 700;
  }
  .manual-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .manual-cat {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .manual-header h1 {
    margin: 0;
    text-transform: uppercase;
    font-size: 2rem;
    letter-spacing: 0.02em;
  }
  .manual-body {
    padding: var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.65;
  }
  .manual-body :global(p:first-child) {
    margin-top: 0;
  }
  .manual-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .manual-pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .pager-cell a {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--ink);
    text-decoration: none;
  }
  .pager-cell a:hover .pager-title {
    color: var(--accent);
  }
  .pager-dir {
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pager-title {
    font-weight: 700;
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  .pager-center a {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .pager-right {
    text-align: right;
  }
  .pager-right a {
    align-items: flex-end;
  }

  @media (max-width: 640px) {
    .manual-header,
    .manual-body {
      padding: var(--space-md);
    }
    .manual-pager {
      grid-template-columns: 1fr 1fr;
    }
    .pager-center {
      grid-column: 1 / -1;
      order: 3;
      text-align: center;
    }
  }
</style>
