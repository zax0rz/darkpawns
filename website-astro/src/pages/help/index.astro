---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const cleanSortKey = (title: string) => title.replace(/^['"`\s]+/, '').toUpperCase();

const entries = (await getCollection('help', ({ data }) => !data.draft)).sort((a, b) =>
  cleanSortKey(a.data.title).localeCompare(cleanSortKey(b.data.title)),
);

const catInfo: Record<string, { title: string; short: string; desc: string }> = {
  commands: {
    title: 'Commands',
    short: 'Command',
    desc: 'Every mortal command, from ABILITIES to YANK, with syntax and combat lag notes.',
  },
  spells: {
    title: 'Spells',
    short: 'Spell',
    desc: 'The complete spellbook: mana costs, targets, durations, and casting syntax.',
  },
  info: {
    title: 'Info & Lore',
    short: 'Info',
    desc: 'Races, classes, towns, mechanics, and world reference entries.',
  },
  socials: {
    title: 'Socials',
    short: 'Social',
    desc: 'Emotes and social commands across the realm. Mind the company.',
  },
  wizhelp: {
    title: 'Wizard Help',
    short: 'Wizhelp',
    desc: 'Immortal administration and world-building documentation.',
  },
};

const order = ['commands', 'spells', 'info', 'socials', 'wizhelp'];
const cats = [...new Set(entries.map((e) => e.id.split('/')[0]))].sort(
  (a, b) => order.indexOf(a) - order.indexOf(b),
);
const countOf = (c: string) => entries.filter((e) => e.id.startsWith(c + '/')).length;

// Group entries alphabetically by first letter after stripping leading quotes (or '#' for symbols like '! ^')
const getLetter = (title: string) => {
  const cleaned = cleanSortKey(title);
  const ch = cleaned[0] || '#';
  return /[A-Z]/.test(ch) ? ch : '#';
};

const enrichedEntries = entries.map((e) => {
  const cat = e.id.split('/')[0];
  const letter = getLetter(e.data.title);
  return {
    id: e.id,
    title: e.data.title,
    description: e.data.description,
    cat,
    catLabel: catInfo[cat]?.short ?? cat,
    letter,
  };
});

const letters = [...new Set(enrichedEntries.map((e) => e.letter))].sort((a, b) =>
  a === '#' ? -1 : b === '#' ? 1 : a.localeCompare(b),
);

const byLetter = letters.map((letter) => ({
  letter,
  items: enrichedEntries.filter((e) => e.letter === letter),
}));
---

<Base
  title="Help Archive | Dark Pawns"
  description="The complete Dark Pawns in-game help archive: commands, spells, lore, socials, and wizard documentation preserved from the original game."
>
  <article class="container help-hub">
    <header class="help-header">
      <p class="eyebrow">In-Game Reference Desk · {entries.length} Preserved Files</p>
      <h1>Help Archive</h1>
      <p class="lede">
        The complete in-game help system from the original Dark Pawns world files: {entries.length} entries from{' '}
        <code>ABILITIES</code> to <code>YANK</code>, with all their 1994 terminal syntax and aggressive helpfulness intact.
      </p>
    </header>

    <!-- Category Shelf -->
    <section class="cat-shelf" aria-label="Help categories">
      {cats.map((c) => (
        <a class="cat-card" href={`/help/${c}/`} data-cat-link={c}>
          <div class="cat-card-top">
            <h2 class="cat-title">{catInfo[c]?.title ?? c}</h2>
            <span class="cat-count">{countOf(c)}</span>
          </div>
          <p class="cat-desc">{catInfo[c]?.desc ?? ''}</p>
        </a>
      ))}
    </section>

    <!-- Interactive Reference Desk -->
    <section class="desk" aria-labelledby="desk-heading">
      <div class="desk-toolbar">
        <div class="desk-toolbar-top">
          <div class="desk-title-wrap">
            <h2 id="desk-heading">Master Topic Directory</h2>
            <span class="desk-status" id="help-result-count" aria-live="polite">
              Showing all {entries.length} entries
            </span>
          </div>
          <div class="desk-search-wrap">
            <label for="help-filter-input" class="visually-hidden">Filter help topics</label>
            <input
              id="help-filter-input"
              type="search"
              placeholder="Filter by topic, command, or usage (e.g. backstab, heal, thief)…"
              autocomplete="off"
            />
          </div>
        </div>

        <div class="desk-filters">
          <div class="cat-pills" role="group" aria-label="Filter by category">
            <button type="button" class="cat-pill active" data-cat="all" aria-pressed="true">
              All ({entries.length})
            </button>
            {cats.map((c) => (
              <button type="button" class="cat-pill" data-cat={c} aria-pressed="false">
                {catInfo[c]?.title ?? c} ({countOf(c)})
              </button>
            ))}
          </div>

          <nav class="az-rail" aria-label="Jump to letter">
            {letters.map((letter) => (
              <a href={`#letter-${letter}`} class="az-link" data-letter-jump={letter}>
                {letter}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <div id="help-groups" class="help-groups">
        {byLetter.map((group) => (
          <section class="letter-group" id={`letter-${group.letter}`} data-letter-group={group.letter}>
            <header class="letter-header">
              <h3>{group.letter}</h3>
              <span class="letter-count">{group.items.length}</span>
            </header>
            <ol class="topic-list">
              {group.items.map((item) => (
                <li
                  class="topic-row"
                  data-cat={item.cat}
                  data-search={`${item.title} ${item.description} ${item.cat}`.toLowerCase()}
                >
                  <a href={`/help/${item.id}/`}>
                    <span class="topic-name">{item.title}</span>
                    <span class="topic-desc">{item.description}</span>
                    <span class="topic-cat">{item.catLabel}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <p id="help-empty" class="help-empty" hidden>
        No help entries match your filter. <button type="button" id="help-reset-btn">Reset filter</button>
      </p>
    </section>
  </article>

  <script>
    const input = document.getElementById('help-filter-input') as HTMLInputElement | null;
    const pills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
    const groups = document.querySelectorAll<HTMLElement>('[data-letter-group]');
    const jumpLinks = document.querySelectorAll<HTMLAnchorElement>('[data-letter-jump]');
    const countEl = document.getElementById('help-result-count');
    const emptyEl = document.getElementById('help-empty');
    const resetBtn = document.getElementById('help-reset-btn');

    let activeCat = 'all';
    let query = '';

    function applyFilter() {
      const q = query.trim().toLowerCase();
      let totalVisible = 0;

      groups.forEach((group) => {
        const rows = group.querySelectorAll<HTMLElement>('.topic-row');
        let groupVisible = 0;
        rows.forEach((row) => {
          const catMatch = activeCat === 'all' || row.dataset.cat === activeCat;
          const textMatch = !q || (row.dataset.search ?? '').includes(q);
          const show = catMatch && textMatch;
          row.hidden = !show;
          if (show) groupVisible++;
        });
        group.hidden = groupVisible === 0;
        const badge = group.querySelector('.letter-count');
        if (badge) badge.textContent = String(groupVisible);
        totalVisible += groupVisible;

        const letter = group.dataset.letterGroup;
        const jump = document.querySelector<HTMLElement>(`[data-letter-jump="${letter}"]`);
        if (jump) jump.classList.toggle('is-dim', groupVisible === 0);
      });

      if (countEl) {
        countEl.textContent =
          activeCat === 'all' && !q
            ? `Showing all ${totalVisible} entries`
            : `${totalVisible} ${totalVisible === 1 ? 'entry' : 'entries'} matching filter`;
      }
      if (emptyEl) emptyEl.hidden = totalVisible > 0;
    }

    input?.addEventListener('input', () => {
      query = input.value;
      applyFilter();
    });

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCat = pill.dataset.cat ?? 'all';
        pills.forEach((p) => {
          const isMatch = p === pill;
          p.classList.toggle('active', isMatch);
          p.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
        });
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      query = '';
      activeCat = 'all';
      pills.forEach((p) => {
        const isAll = p.dataset.cat === 'all';
        p.classList.toggle('active', isAll);
        p.setAttribute('aria-pressed', isAll ? 'true' : 'false');
      });
      applyFilter();
    });
  </script>
</Base>

<style>
  .help-hub {
    padding-block: var(--space-xl);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-xs);
  }
  .help-header h1 {
    margin-bottom: var(--space-sm);
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.15rem;
    max-width: 62ch;
    margin: 0 0 var(--space-lg);
  }
  .lede code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  /* Category Shelf */
  .cat-shelf {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--ink);
    background: var(--ink);
    margin-bottom: var(--space-xl);
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-md);
    background: var(--paper-deep);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .cat-card:hover {
    background: var(--paper);
    text-decoration: none;
  }
  .cat-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
  }
  .cat-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin: 0;
    color: var(--ink);
  }
  .cat-card:hover .cat-title {
    color: var(--accent);
  }
  .cat-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cat-desc {
    font-size: 0.875rem;
    color: var(--ink-muted);
    line-height: 1.45;
    margin: 0;
  }

  /* Reference Desk Toolbar */
  .desk-toolbar {
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-block: var(--space-md);
    margin-bottom: var(--space-lg);
    background: var(--paper);
  }
  .desk-toolbar-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }
  .desk-title-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }
  .desk-title-wrap h2 {
    margin: 0;
    font-size: 1.375rem;
  }
  .desk-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .desk-search-wrap {
    flex: 1 1 22rem;
    max-width: 30rem;
  }
  #help-filter-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--ink);
  }
  #help-filter-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .desk-filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }
  .cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .cat-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    color: var(--ink);
    cursor: pointer;
  }
  .cat-pill:hover {
    border-color: var(--ink);
  }
  .cat-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .az-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .az-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid transparent;
  }
  .az-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .az-link.is-dim {
    opacity: 0.3;
    pointer-events: none;
  }

  /* Letter Groups */
  .letter-group {
    margin-bottom: var(--space-lg);
  }
  .letter-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.2rem;
    margin-bottom: 0;
  }
  .letter-header h3 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    margin: 0;
    color: var(--accent);
  }
  .letter-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .topic-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topic-row {
    border-bottom: 1px solid var(--rule);
  }
  .topic-row a {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-md);
    padding: 0.48rem var(--space-xs);
    color: var(--ink);
    text-decoration: none;
  }
  .topic-row a:hover {
    background: var(--paper-deep);
    text-decoration: none;
  }
  .topic-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .topic-row a:hover .topic-name {
    color: var(--accent);
  }
  .topic-desc {
    font-size: 0.875rem;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topic-cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
  }

  .help-empty {
    padding: var(--space-lg);
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .help-empty button {
    margin-left: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  @media (max-width: 980px) {
    .cat-shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .cat-shelf {
      grid-template-columns: 1fr;
    }
    .topic-row a {
      grid-template-columns: 1fr auto;
      gap: 0.2rem var(--space-sm);
    }
    .topic-desc {
      grid-column: 1 / -1;
      order: 3;
    }
  }
</style>
