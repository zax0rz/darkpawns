---
import Base from '../layouts/Base.astro';
import ChapterHeader from '../components/ChapterHeader.astro';

const earlyStaff = [
  ['Serapis (Derek Karnes)', 'Founder and original implementor'],
  ['Tracer (C. Jackson)', 'Co-founder and early developer'],
  ['Orodreth (S. Thompson)', 'Coder and later co-implementor'],
  ['Frontline (R.E. Paret)', 'Coder, co-implementor, historian, and website author'],
  ['Arak (B. Parker)', 'Coder'],
  ['Oddity (A. McConnell)', 'Head builder'],
  ['Nimos', 'Builder'],
  ['Aralius (R. Martin)', 'Builder'],
  ['Doragar', 'Builder and coder'],
];
---

<Base title="Dark Pawns Credits" description="The creators, builders, players, and free-software projects behind Dark Pawns.">
  <article class="credits-page container">
    <ChapterHeader
      title="Acknowledgements & Credits"
      lede="No persistent world is made by one person. Dark Pawns carries the work of its founders, implementors, builders, engine authors, and the players who kept returning."
    />

    <section class="credit-section">
      <div class="section-heading">
        <h2>Dark Pawns staff</h2>
        <p>Names and roles below are drawn from the preserved project history and original wizard list.</p>
      </div>
      <dl class="credit-list">
        {earlyStaff.map(([name, role]) => <div><dt>{name}</dt><dd>{role}</dd></div>)}
      </dl>
    </section>

    <section class="credit-section" id="archived-staff-list">
      <div class="section-heading">
        <h2>Preserved wizard list</h2>
        <p>A snapshot from Frontline’s original Dark Pawns website, not an all-time roster.</p>
      </div>
      <p class="archived-quote">“Wizards are a secret lot, and very powerful. They are not to be trifled with.”</p>
      <ul class="wizard-list"><li>Orodreth</li><li>Frontline</li><li>Doragar</li></ul>
    </section>

    <section class="credit-section">
      <div class="section-heading">
        <h2>The engine lineage</h2>
        <p>Dark Pawns descends from software shared freely by generations of MUD developers.</p>
      </div>
      <div class="lineage" aria-label="Engine lineage">
        <span>DikuMUD</span><b aria-hidden="true">→</b><span>CircleMUD</span><b aria-hidden="true">→</b><span>Dark Pawns</span>
      </div>
      <p class="credit-note">CircleMUD was created by Jeremy Elson and is derived from DikuMUD Gamma 0.0 by Katja Nyboe, Tom Madsen, Hans Henrik Stærfeldt, Michael Seifert, and Sebastian Hammer.</p>
    </section>

    <section class="credit-section">
      <div class="section-heading">
        <h2>The restoration</h2>
        <p>The current Go port and website are maintained as an open-source project.</p>
      </div>
      <dl class="credit-list compact">
        <div><dt>Zach Greene (zax0rz)</dt><dd>Project lead, Go restoration, and modern website</dd></div>
        <div><dt>Contributors</dt><dd>Everyone whose code, testing, research, and corrections appear in the repository history</dd></div>
      </dl>
      <p class="credit-note"><a href="https://github.com/zax0rz/darkpawns">View the complete contributor history on GitHub <span aria-hidden="true">→</span></a></p>
    </section>

    <section class="credit-section community-credit">
      <h2>And the players.</h2>
      <p class="credit-note">The clans, arguments, late-night sessions, forum posts, bug reports, maps, rumors, and friendships were part of the game too. The surviving record is incomplete, but it is being gathered in the <a href="/archive/">Archive</a>.</p>
    </section>
  </article>
</Base>

<style>
  .credits-page { padding-bottom: var(--space-xl); }
  .credit-section { padding-block: var(--space-lg); border-top: 1px solid var(--rule); }
  .credits-page > .credit-section:first-of-type { border-top: 0; padding-top: 0; }
  .section-heading { max-width: var(--content-width); margin-bottom: var(--space-md); }
  .section-heading h2 { margin-bottom: var(--space-xs); }
  .section-heading p { color: var(--ink-muted); margin: 0; }
  .credit-list { margin: 0; max-width: 52rem; }
  .credit-list div { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: var(--space-md); padding: .7rem 0; border-top: 1px solid color-mix(in srgb, var(--rule) 35%, transparent); }
  .credit-list dt { font-family: var(--font-display); font-size: 1.1rem; }
  .credit-list dd { color: var(--ink-muted); margin: 0; }
  .archived-quote { max-width: 44rem; font-family: var(--font-display); font-size: 1.35rem; margin-bottom: var(--space-md); }
  .wizard-list { display: flex; flex-wrap: wrap; gap: var(--space-sm); list-style: none; margin: 0; padding: 0; }
  .wizard-list li { border: 1px solid var(--rule); background: var(--paper-deep); padding: .4rem .7rem; font-family: var(--font-mono); font-size: .85rem; }
  .lineage { display: flex; align-items: center; gap: var(--space-md); margin: 0 0 var(--space-md); font-family: var(--font-display); font-size: clamp(1.2rem, 3vw, 1.75rem); }
  .lineage b { color: var(--accent); }
  .credit-note { max-width: 58ch; color: var(--ink-muted); }
  .community-credit h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); margin-bottom: var(--space-sm); }
  @media (max-width: 650px) {
    .credits-page { padding-inline: var(--space-md); }
    .credit-list div { grid-template-columns: 1fr; gap: 0; }
    .lineage { align-items: flex-start; flex-direction: column; gap: var(--space-xs); }
    .lineage b { transform: rotate(90deg); }
  }
</style>
