---
import Base from '../../layouts/Base.astro';
import { zonesSorted, totalRooms } from '../../lib/zones';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dark Pawns zone index',
  description: `${zonesSorted.length} zones parsed from the active Dark Pawns world files.`,
  isPartOf: { '@type': 'WebSite', name: 'Dark Pawns', url: 'https://darkpawns.org/' },
};
const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

// Parse zone title strings like "(15-20) Orc Burrows (Arakon)" or "(I) (X) (24-30) The Lakeshore Tavern (Oddity)"
function parseZoneMeta(rawName: string) {
  let s = rawName.trim();
  const flags: string[] = [];
  let levelRange = '';
  let minLevel = 999;

  while (true) {
    const m = s.match(/^\(([^)]+)\)\s*/);
    if (!m) break;
    const token = m[1].trim();
    if (/^\d+\s*-\s*\d+$/.test(token)) {
      levelRange = `Lvl ${token.replace(/\s+/g, '')}`;
      minLevel = parseInt(token.split('-')[0], 10);
    } else if (token.toLowerCase() === 'all' || token === '-N/A-') {
      levelRange = token === '-N/A-' ? 'Special' : 'All Levels';
      minLevel = 0;
    } else {
      flags.push(token);
    }
    s = s.slice(m[0].length);
  }

  let builder = '';
  const trailing = s.match(/\s*\(([^)]+)\)\s*$/);
  if (trailing) {
    builder = trailing[1].trim();
    s = s.slice(0, s.length - trailing[0].length).trim();
  }

  return {
    cleanName: s || rawName,
    levelRange,
    minLevel,
    builder,
    flags,
  };
}

const enrichedZones = zonesSorted.map((zone) => {
  const meta = parseZoneMeta(zone.name);
  const mobLevels = zone.mobs.map((m) => m.level).filter((l) => l > 0);
  const computedRange =
    !meta.levelRange && mobLevels.length > 0
      ? `Lvl ${Math.min(...mobLevels)}-${Math.max(...mobLevels)}`
      : meta.levelRange || 'Unrated';
  return {
    ...zone,
    cleanName: meta.cleanName,
    levelLabel: computedRange,
    minLevel: meta.minLevel === 999 && mobLevels.length > 0 ? Math.min(...mobLevels) : meta.minLevel,
    builder: meta.builder,
  };
});

const totalMobsPlaced = zonesSorted.reduce((sum, z) => sum + z.mobs.length, 0);
const totalShops = zonesSorted.reduce((sum, z) => sum + z.shops.length, 0);
---

<Base
  title="Dark Pawns Zone Index"
  description={`${zonesSorted.length} zones and ${totalRooms.toLocaleString('en-US')} rooms parsed from the active Dark Pawns world files.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd}></script>
  </Fragment>

  <article class="directory container">
    <header class="dir-header">
      <p class="eyebrow"><a href="/world/">The World</a> &raquo; Zone Atlas</p>
      <h1>Zone Index</h1>
      <p class="lede">
        {zonesSorted.length} zones holding {totalRooms.toLocaleString('en-US')} rooms, parsed directly from the active{' '}
        <code>lib/world/</code> files. Every zone below links to its room ledger, the{' '}
        <a href="/map/">interactive 3D/2D map</a>, and its <a href="/database/">mob &amp; item codex</a> records.
      </p>

      <dl class="tally">
        <div><dd>{zonesSorted.length}</dd><dt>Zones</dt></div>
        <div><dd>{totalRooms.toLocaleString('en-US')}</dd><dt>Rooms</dt></div>
        <div><dd>{totalMobsPlaced.toLocaleString('en-US')}</dd><dt>Zone Mob Types</dt></div>
        <div><dd>{totalShops}</dd><dt>Active Shops</dt></div>
      </dl>
    </header>

    <div class="dir-toolbar">
      <div class="dir-search-wrap">
        <label for="zone-filter-input" class="visually-hidden">Filter zones</label>
        <input
          id="zone-filter-input"
          type="search"
          placeholder="Filter by zone name, builder (Arakon, Oddity, Serapis…), or zone ID…"
          autocomplete="off"
        />
      </div>

      <div class="dir-sort-wrap">
        <span class="dir-status" id="zone-result-count" aria-live="polite">
          Showing all {enrichedZones.length} zones
        </span>
        <div class="sort-pills" role="group" aria-label="Sort zones">
          <button type="button" class="sort-pill active" data-sort="level" aria-pressed="true">By Level</button>
          <button type="button" class="sort-pill" data-sort="id" aria-pressed="false">By Zone #</button>
          <button type="button" class="sort-pill" data-sort="rooms" aria-pressed="false">By Size</button>
          <button type="button" class="sort-pill" data-sort="name" aria-pressed="false">By Name</button>
        </div>
      </div>
    </div>

    <ol class="record-index" id="zone-list">
      {enrichedZones.map((zone) => (
        <li
          class="zone-row"
          data-id={zone.id}
          data-level={zone.minLevel}
          data-rooms={zone.roomCount}
          data-name={zone.cleanName.toLowerCase()}
          data-search={`${zone.name} ${zone.cleanName} ${zone.builder} ${zone.id} ${zone.levelLabel}`.toLowerCase()}
        >
          <div class="zone-main">
            <div class="zone-title-line">
              <a class="zone-link" href={`/zones/${zone.id}/`}>{zone.cleanName}</a>
              <span class="zone-lvl">{zone.levelLabel}</span>
              {zone.builder && <span class="zone-builder">by {zone.builder}</span>}
            </div>
            <div class="zone-meta">
              <span>Zone #{zone.id}</span>
              <span>·</span>
              <span>{zone.roomCount} {zone.roomCount === 1 ? 'room' : 'rooms'}</span>
              <span>·</span>
              <span>{zone.mobs.length} {zone.mobs.length === 1 ? 'mob' : 'mobs'}</span>
              <span>·</span>
              <span>{zone.items.length} {zone.items.length === 1 ? 'item' : 'items'}</span>
              {zone.shops.length > 0 && (
                <>
                  <span>·</span>
                  <span class="zone-shops">{zone.shops.length} {zone.shops.length === 1 ? 'shop' : 'shops'}</span>
                </>
              )}
            </div>
          </div>

          <div class="zone-actions">
            <a class="zone-pill" href={`/zones/${zone.id}/`}>Record</a>
            <a class="zone-pill" href={`/map/?zone=${zone.id}`}>Map</a>
            <a class="zone-pill" href={`/database/?zone=${zone.id}`}>Codex</a>
          </div>
        </li>
      ))}
    </ol>
  </article>

  <script>
    const input = document.getElementById('zone-filter-input') as HTMLInputElement | null;
    const list = document.getElementById('zone-list');
    const countEl = document.getElementById('zone-result-count');
    const sortBtns = document.querySelectorAll<HTMLButtonElement>('.sort-pill');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.zone-row'));

    function filterZones() {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const match = !q || (row.dataset.search ?? '').includes(q);
        row.hidden = !match;
        if (match) visible++;
      });
      if (countEl) {
        countEl.textContent = !q
          ? `Showing all ${visible} zones`
          : `${visible} ${visible === 1 ? 'zone' : 'zones'} matching filter`;
      }
    }

    function sortZones(mode: string) {
      if (!list) return;
      const sorted = [...rows].sort((a, b) => {
        if (mode === 'id') {
          return Number(a.dataset.id) - Number(b.dataset.id);
        }
        if (mode === 'rooms') {
          return Number(b.dataset.rooms) - Number(a.dataset.rooms);
        }
        if (mode === 'name') {
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        // default: level
        const la = Number(a.dataset.level);
        const lb = Number(b.dataset.level);
        if (la !== lb) return la - lb;
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      });
      sorted.forEach((row) => list.appendChild(row));
    }

    input?.addEventListener('input', filterZones);

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        sortZones(btn.dataset.sort ?? 'level');
      });
    });
  </script>
</Base>

<style>
  .directory {
    padding-block: var(--space-lg) var(--space-xl);
  }
  .eyebrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 var(--space-xs);
  }
  .lede {
    color: var(--ink-muted);
    font-size: 1.15rem;
    max-width: 62ch;
    margin: 0;
  }
  .lede code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .tally {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: var(--space-lg) 0 var(--space-xl);
    border: 1px solid var(--ink);
    background: var(--ink);
    max-width: 52rem;
  }
  .tally div {
    padding: var(--space-sm) var(--space-md);
    background: var(--paper-deep);
  }
  .tally dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tally dt {
    margin-top: 0.15rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dir-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .dir-search-wrap {
    flex: 1 1 22rem;
    max-width: 30rem;
  }
  #zone-filter-input {
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--ink);
  }
  #zone-filter-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .dir-sort-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .dir-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sort-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .sort-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    color: var(--ink);
    cursor: pointer;
  }
  .sort-pill:hover {
    border-color: var(--ink);
  }
  .sort-pill.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }

  .record-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .zone-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: 0.65rem var(--space-xs);
    border-bottom: 1px solid var(--rule);
  }
  .zone-row:hover {
    background: var(--paper-deep);
  }
  .zone-main {
    min-width: 0;
  }
  .zone-title-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.15rem;
  }
  .zone-link {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
  }
  .zone-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .zone-lvl {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    padding: 0.05rem 0.38rem;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .zone-builder {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .zone-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
  .zone-shops {
    color: var(--ink);
  }

  .zone-actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.35rem;
  }
  .zone-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    color: var(--ink);
    text-decoration: none;
  }
  .zone-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--paper);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .tally {
      grid-template-columns: repeat(2, 1fr);
    }
    .zone-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }
</style>
