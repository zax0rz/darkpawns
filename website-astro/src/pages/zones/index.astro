---
import Base from '../../layouts/Base.astro';
import { zonesSorted, totalRooms } from '../../lib/zones';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Dark Pawns zone index',
  description: `${zonesSorted.length} zones parsed from the active Dark Pawns world files.`,
  isPartOf: { '@type': 'WebSite', name: 'Dark Pawns', url: 'https://darkpawns.labz0rz.com/' },
};
const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<Base title="Dark Pawns Zone Index" description={`${zonesSorted.length} zones and ${totalRooms.toLocaleString('en-US')} rooms parsed from the active Dark Pawns world files.`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd}></script>
  </Fragment>

  <article class="directory container">
    <p class="eyebrow">World / zones</p>
    <h1>Zone index</h1>
    <p class="lede">{zonesSorted.length} zones holding {totalRooms.toLocaleString('en-US')} rooms, parsed from the active world files. Each zone page lists its rooms, inhabitants, and connections, with the <a href="/map/">interactive map</a> available for the spatial view.</p>
    <ol class="record-index">
      {zonesSorted.map((zone) => (
        <li>
          <a href={`/zones/${zone.id}/`}>
            <span>{zone.name}</span>
            <small>Zone {zone.id} / {zone.roomCount} rooms / {zone.mobs.length} mobs / {zone.items.length} items</small>
          </a>
        </li>
      ))}
    </ol>
  </article>
</Base>

<style>
  .directory { padding-block: var(--space-lg) var(--space-xl); }
  .eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .lede { color: var(--ink-muted); }
  .record-index { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); list-style: none; margin: var(--space-lg) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .record-index li { border-bottom: 1px solid var(--rule); }
  .record-index a { color: var(--ink); display: block; padding: .65rem var(--space-sm); }
  .record-index a:hover { color: var(--accent); text-decoration: none; }
  .record-index span { display: block; font-family: var(--font-display); overflow-wrap: anywhere; }
  .record-index small { color: var(--ink-muted); font-family: var(--font-mono); font-size: .65rem; }
  @media (max-width: 560px) { .directory { padding-inline: var(--space-md); } }
</style>
