---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The capture timestamp is the date the Wayback Machine took its copy, which is
// never the date the page was written. The policy requires the two to be shown
// as separate facts, so it is read back out of the capture URL and labelled.
const captureStamp = entry.data.captureUrl.match(/\/web\/(\d{4})(\d{2})(\d{2})/);
const archivedOn = captureStamp
  ? new Date(`${captureStamp[1]}-${captureStamp[2]}-${captureStamp[3]}T00:00:00Z`)
      .toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;
const recoveredOn = entry.data.recoveredAt.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const participants = entry.data.participants ?? [];
---
<Base title={`${entry.data.title} | Dark Pawns Archive`} description={entry.data.description}>
  <link slot="head" rel="alternate" type="text/markdown" href={`/archive/${entry.id}.md`} title={`${entry.data.title} as Markdown`} />
  <article class="container archive-article">
    <p class="crumb"><a href="/archive/">Archive</a> &raquo; {entry.data.title}</p>
    <h1>{entry.data.title}</h1>

    {entry.data.completeness === 'partial' && (
      <p class="completeness">
        <strong>Incomplete record.</strong> {entry.data.completenessNote ??
          'Only part of this record was ever captured.'}
      </p>
    )}

    <dl class="provenance">
      <div><dt>Written</dt><dd>{entry.data.dateLabel}</dd></div>
      {entry.data.board && <div><dt>Board</dt><dd>{entry.data.board}</dd></div>}
      {entry.data.postCount && (
        <div>
          <dt>Length</dt>
          <dd>
            {entry.data.postCount} posts
            {participants.length > 0 && ` from ${participants.length} people`}
          </dd>
        </div>
      )}
      <div><dt>Record type</dt><dd>{entry.data.kind.replaceAll('-', ' ')}</dd></div>
      <div><dt>Published on</dt><dd>{entry.data.sourceSite}</dd></div>
      {archivedOn && <div><dt>Archived</dt><dd>{archivedOn}</dd></div>}
      <div><dt>Recovered</dt><dd>{recoveredOn}</dd></div>
      {entry.data.usedIn && entry.data.usedIn.length > 0 && (
        <div>
          <dt>Used in</dt>
          <dd>{entry.data.usedIn.map((use, index) => (
            <>{index > 0 && ', '}<a href={use.href}>{use.label}</a></>
          ))}</dd>
        </div>
      )}
      <div>
        <dt>Source</dt>
        <dd>
          <a href={entry.data.captureUrl}>View the Wayback capture</a>
          {' · '}
          <a href={`/archive/${entry.id}.md`}>Markdown</a>
        </dd>
      </div>
    </dl>

    {participants.length > 0 && (
      <section class="participants" aria-label="People in this conversation">
        <h2>In this conversation</h2>
        <ul>
          {participants.map((person) => (
            <li>
              <span class="who">{person.name}</span>
              {person.role !== 'unknown' && <span class="rank">{person.role}</span>}
              <span class="count">{person.posts === 1 ? '1 post' : `${person.posts} posts`}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {entry.data.contentWarning && <p class="content-warning"><strong>Content note:</strong> {entry.data.contentWarning}</p>}
    <div class="prose archive-copy"><Content /></div>
  </article>
</Base>

<style>
  .archive-article { padding-block: var(--space-lg) var(--space-xl); }
  .crumb {
    margin-bottom: var(--space-sm);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .completeness {
    max-width: var(--content-width);
    border-left: 3px solid var(--accent);
    padding: 0.2rem 0 0.2rem var(--space-md);
    color: var(--ink-muted);
  }
  .provenance {
    max-width: var(--content-width);
    margin: 0 0 var(--space-lg);
    border-block: 1px solid var(--rule);
    padding: var(--space-sm) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .provenance div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-md); padding: 0.15rem 0; }
  .provenance dt { color: var(--ink-muted); }
  .provenance dd { margin: 0; }

  .participants { max-width: var(--content-width); margin-bottom: var(--space-lg); }
  .participants h2 {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .participants ul { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin: 0; padding: 0; list-style: none; }
  .participants li { display: flex; align-items: baseline; gap: 0.4rem; }
  .participants .who { font-family: var(--font-display); font-size: 1rem; }
  .participants .rank,
  .participants .count { color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; }
  .participants .rank::before { content: '·'; margin-right: 0.4rem; }

  .archive-copy :global(h3) {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-md);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }
  /* A quoted passage is the thing being answered, not a post of its own. It is
     set quieter and tighter than the reply that follows it. */
  .archive-copy :global(blockquote) {
    margin: 0 0 var(--space-md);
    border-left: 2px solid var(--rule);
    padding: 0.1rem 0 0.1rem var(--space-md);
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .archive-copy :global(blockquote p) { margin: 0 0 var(--space-xs); }
  .archive-copy :global(blockquote p:last-child) { margin-bottom: 0; }
  .archive-copy :global(blockquote strong) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .content-warning { max-width: var(--content-width); border-left: 3px solid var(--accent); padding-left: var(--space-md); color: var(--ink-muted); }
  @media (max-width: 520px) { .provenance div { grid-template-columns: 1fr; gap: 0; } }
</style>
