---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('archive', ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortDate.getTime() - b.data.sortDate.getTime());
const byId = new Map(entries.map((entry) => [entry.id, entry]));

const isThread = (entry) => entry.data.kind === 'forum-thread';
const threads = entries.filter(isThread);

// One axis: the site a record was published on. The forum was part of
// dp-players.com, so it is a subsection there rather than a third peer.
const sections = [
  {
    id: 'darkpawns',
    site: 'darkpawns.com',
    note: "The official site, run by Frontline: the news page, the text map of Kir Drax'in, and the handbooks.",
    entries: entries.filter((entry) => entry.data.sourceSite === 'darkpawns.com'),
  },
  {
    id: 'player-page',
    site: 'dp-players.com',
    note: 'The player page I ran in 2004, and the board attached to it.',
    entries: entries.filter((entry) => entry.data.sourceSite === 'dp-players.com' && !isThread(entry)),
    threads,
  },
];

// A shortlist, because thirty-seven equal rows is a directory, not an archive.
// Each one says why it is worth the click.
const shortlist = [
  { id: 'topic-t38', why: 'Orodreth, who holds player number two, explains where parts of the world came from.' },
  { id: 'board-index-general', why: 'Every topic the board held in July 2004, with the reply count on each. Most of them are gone.' },
  { id: 'map-kir-draxin', why: 'The starting city drawn in characters, the way you would have kept it beside the keyboard.' },
  { id: 'topic-t83', why: 'The player-killing argument, which is really an argument about what the game was for.' },
  { id: 'darkpawns-news-2005', why: 'The 3.0 beta announcement, answering a year of speculation on the board above.' },
].map((pick) => ({ ...pick, entry: byId.get(pick.id) })).filter((pick) => pick.entry);

const tally = {
  records: entries.length,
  threads: threads.length,
  posts: threads.reduce((sum, entry) => sum + (entry.data.postCount ?? 0), 0),
  people: new Set(threads.flatMap((entry) => (entry.data.participants ?? []).map((p) => p.name))).size,
};
// The tally is a provenance claim. If any thread cannot contribute a count, the
// posts figure would understate the corpus, so it is withheld rather than shown
// wrong. Same rule as the rest of the archive: sourced or silent.
const postsComplete = threads.every((entry) => typeof entry.data.postCount === 'number');

const contentsDate = (label) => (label === 'Date not recorded' ? '' : label);

const KIND_LABEL = {
  'forum-thread': 'thread', 'board-index': 'board index', 'site-page': 'page',
  map: 'map', guide: 'guide', history: 'history', quote: 'quotes', roster: 'staff',
};

// The hub is a collection page; naming its parts lets a crawler or an agent
// enumerate the archive without scraping the list markup.
const site = 'https://darkpawns.labz0rz.com';
const collectionLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Dark Pawns Archive',
  description: 'Records recovered from archived copies of dp-players.com and darkpawns.com.',
  url: `${site}/archive/`,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Dark Pawns', url: site },
  hasPart: entries.map((entry) => ({
    '@type': entry.data.kind === 'forum-thread' ? 'DiscussionForumPosting' : 'Article',
    name: entry.data.title,
    url: `${site}/archive/${entry.id}/`,
    ...(entry.data.dateLabel === 'Date not recorded'
      ? {}
      : { datePublished: entry.data.sortDate.toISOString().slice(0, 10) }),
    isBasedOn: entry.data.sourceUrl,
    citation: entry.data.captureUrl,
  })),
});

const missing = [
  { what: 'The drawing of the city', detail: "darkpawns.com printed a picture of Kir Drax'in next to the text map. The text map is here. The picture was never captured." },
  { what: 'Two guides', detail: "The index names them: Whistler's Determining Your Natural Abilities, November 2002, and my Definative Newbie Guide, March 2003. Neither was archived." },
  { what: '201 game logs', detail: 'Players uploaded transcripts of hunts and duels across ten categories. The index survived with every count on it. None of the logs did.' },
  { what: 'Most of the board', detail: 'The July 2004 index lists topics with no capture at any timestamp. Several long threads survive only as their last page.' },
];
---
<Base title="Archive | Dark Pawns" description="Recovered conversations and records from the original Dark Pawns community.">
  <script slot="head" type="application/ld+json" set:html={collectionLd} />
  <div class="container archive-hub">
    <h1>The Archive</h1>
    <p class="lede">
      These records were recovered from archived copies of my old player page, dp-players.com, and
      the official Dark Pawns site, darkpawns.com. Every one of them names where it came from and
      which archived copy it was taken from.
    </p>

    <dl class="tally">
      <div><dd>{tally.records}</dd><dt>Records</dt></div>
      <div><dd>{tally.threads}</dd><dt>Conversations</dt></div>
      {postsComplete && <div><dd>{tally.posts}</dd><dt>Posts</dt></div>}
      <div><dd>{tally.people}</dd><dt>People</dt></div>
    </dl>

    <section class="start" aria-labelledby="start-here">
      <header class="band">
        <h2 id="start-here">Start here</h2>
        <p class="band-count">{shortlist.length} of {tally.records}</p>
      </header>
      <ol class="start-list">
        {shortlist.map((pick) => (
          <li>
            <a class="start-title" href={`/archive/${pick.entry.id}/`}>{pick.entry.data.title}</a>
            <p class="start-why">{pick.why}</p>
          </li>
        ))}
      </ol>
    </section>

    {sections.map((section) => (
      <section class="site" id={section.id} aria-labelledby={`h-${section.id}`}>
        <header class="band">
          <h2 id={`h-${section.id}`}>{section.site}</h2>
          <p class="band-count">
            {section.entries.length + (section.threads?.length ?? 0)} records
          </p>
        </header>
        <p class="site-note">{section.note}</p>

        <ol class="records">
          {section.entries.map((entry) => (
            <li>
              <a href={`/archive/${entry.id}/`}>
                <span class="r-date">{contentsDate(entry.data.dateLabel)}</span>
                <span class="r-title">{entry.data.title}</span>
                <span class="r-lead" aria-hidden="true"></span>
                <span class="r-meta">
                  {KIND_LABEL[entry.data.kind] ?? entry.data.kind}
                  {entry.data.kind === 'board-index' && entry.data.topics &&
                    `, ${entry.data.topics.length} topics`}
                  {entry.data.completeness === 'partial' && ', partial'}
                </span>
              </a>
            </li>
          ))}
        </ol>

        {section.threads && (
          <div class="threads">
            <header class="band band-sub">
              <h3 id="forum">The board</h3>
              <p class="band-count">{section.threads.length} threads</p>
            </header>
            <p class="site-note">
              Nineteen of the thirty-six threads the board was carrying survived. Oldest first.
            </p>
            <ol class="records">
              {section.threads.map((entry) => (
                <li>
                  <a href={`/archive/${entry.id}/`}>
                    <span class="r-date">{contentsDate(entry.data.dateLabel)}</span>
                    <span class="r-title">{entry.data.title}</span>
                    <span class="r-lead" aria-hidden="true"></span>
                    <span class="r-meta">
                      {entry.data.postCount} posts
                      {entry.data.participants && `, ${entry.data.participants.length} people`}
                      {entry.data.completeness === 'partial' && ', partial'}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </section>
    ))}

    <section class="gaps" id="missing" aria-labelledby="h-missing">
      <header class="band">
        <h2 id="h-missing">What is missing</h2>
        <p class="band-count">{missing.length} things</p>
      </header>
      <p class="site-note">
        The recovery followed every link the surviving pages pointed at. These four are what it
        looked for and did not find.
      </p>
      <dl class="missing">
        {missing.map((item) => (
          <div><dt>{item.what}</dt><dd>{item.detail}</dd></div>
        ))}
      </dl>
      <p class="ask">
        If you kept backups from that era, they are the only remaining source for any of it.{' '}
        <a href="/contact/">Get in touch.</a>
      </p>
    </section>
  </div>
</Base>

<style>
  /* The archive reads at broadsheet width, wider than an article column because
     every row is a date rail plus a title, but never the full 72rem shell. */
  .archive-hub { --archive-width: 58rem;
  /* The archive's type ramp, declared once. DESIGN.md documents six global
     steps; an index of dated records needs a label and a row title between
     them, so the extra steps are named here rather than scattered as literals. */
  --t-label: 0.8rem;   /* mono labels, meta, provenance */
  --t-quote: 0.95rem;  /* a quoted passage, quieter than the reply */
  --t-body: 1rem;
  --t-lede: 1.15rem;   /* opening paragraph, post bylines */
  --t-row: 1.25rem;    /* a record title in a list */
  --t-section: 1.375rem;
  --t-figure: 1.75rem; /* the tally numerals */
 padding-block: var(--space-xl) var(--space-lg); }
  .archive-hub > * { max-width: var(--archive-width); }
  .lede { max-width: 58ch; color: var(--ink-muted); font-size: var(--t-lede); }

  /* An accession block off a library card: four ruled cells, figures in the
     display face, labels in the machine face. The rules are the only structure
     and the tonal cream is the only fill, which is all the depth this system
     has. */
  .tally {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: var(--space-lg) 0 0;
    border: 1px solid var(--ink);
    background: var(--ink);
  }
  .tally div { padding: var(--space-sm) var(--space-md); background: var(--paper-deep); }
  .tally dd { margin: 0; font-family: var(--font-display); font-size: var(--t-figure); line-height: 1; font-variant-numeric: tabular-nums; }
  .tally dt { margin-top: 0.15rem; color: var(--ink-muted); font-family: var(--font-mono); font-size: var(--t-label); letter-spacing: 0.06em; text-transform: uppercase; }

  /* Each section opens on a ruled band with its name and its extent, the way a
     printed catalogue announces a new run of entries. */
  .band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    border-block: 1px solid var(--ink);
    background: var(--paper-deep);
    padding: var(--space-sm) var(--space-md);
  }
  .band h2, .band h3 { margin: 0; }
  .band h3 { font-size: var(--t-row); }
  .band-sub { margin-top: var(--space-lg); border-block-width: 1px 0; background: none; padding-inline: 0; }
  .band-count { margin: 0; color: var(--ink-muted); font-family: var(--font-mono); font-size: var(--t-label); letter-spacing: 0.04em; white-space: nowrap; }
  .site-note { max-width: 58ch; margin: var(--space-sm) 0 var(--space-md); color: var(--ink-muted); }

  /* Start here: the only place a record is allowed to argue for itself. */
  .start-list { margin: 0; padding: 0; list-style: none; }
  .start-list li { border-bottom: 1px solid var(--rule); padding: var(--space-md) 0; }
  .start-title {
    display: inline-block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--t-section);
    line-height: 1.2;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
  }
  .start-title:hover, .start-title:focus-visible { color: var(--accent); text-decoration-color: var(--accent); }
  .start-why { margin: 0.15rem 0 0; max-width: 62ch; color: var(--ink-muted); }

  .threads { margin-top: var(--space-lg); }

  /* A contents page, not a stack of summaries: date, title, extent, one line
     each, with the dot leader a printed table of contents would use. What each
     record is belongs on the record. */
  .records { margin: 0; padding: 0; list-style: none; }
  .records li + li { border-top: 1px solid var(--rule); }
  .records a {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: 0.45rem 0;
    color: var(--ink);
  }
  .r-date {
    flex: 0 0 11rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    /* One line per entry, the way a contents page sets its page numbers. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .r-title { font-family: var(--font-display); font-size: var(--t-lede); line-height: 1.3; }
  .r-title::after {
    content: '';
    display: inline-block;
    width: 0;
  }
  .r-meta {
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .r-lead { flex: 1 1 auto; border-bottom: 1px dotted var(--rule); transform: translateY(-0.3em); min-width: var(--space-md); }
  .r-title, .r-date { transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), color 120ms linear; }
  .records a:hover .r-title,
  .records a:focus-visible .r-title { color: var(--accent); transform: translateX(3px); }
  .records a:hover .r-date,
  .records a:focus-visible .r-date { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .r-title, .r-date { transition: color 120ms linear; }
    .records a:hover .r-title, .records a:focus-visible .r-title { transform: none; }
  }
  .records a:hover .r-lead,
  .records a:focus-visible .r-lead { border-bottom-color: var(--accent); }

  .missing { margin: var(--space-md) 0 0; }
  .missing div { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-lg); border-top: 1px solid var(--rule); padding: var(--space-md) 0; }
  .missing div:last-child { border-bottom: 1px solid var(--rule); }
  .missing dt { font-family: var(--font-display); font-size: var(--t-lede); }
  .missing dd { margin: 0; color: var(--ink-muted); }
  .ask { margin-top: var(--space-md); margin-left: calc(10rem + var(--space-lg)); color: var(--ink-muted); }

  @media (max-width: 640px) {
    .tally { grid-template-columns: repeat(2, 1fr); }
    .band { flex-wrap: wrap; gap: 0.1rem var(--space-sm); }
    .records a, .missing div { grid-template-columns: 1fr; gap: var(--space-xs); }
    .records a { flex-wrap: wrap; gap: 0.1rem var(--space-sm); padding: var(--space-sm) 0; }
    .r-date { flex: 0 0 100%; order: 2; }
    .r-title { flex: 0 0 100%; order: 1; }
    .r-lead { display: none; }
    .r-meta { margin-left: 0; order: 3; }
    .ask { margin-left: 0; }
  }
</style>
