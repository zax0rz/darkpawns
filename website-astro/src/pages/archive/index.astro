---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('archive', ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortDate.getTime() - b.data.sortDate.getTime());

const isForum = (entry) => entry.data.kind === 'forum-thread' || entry.data.kind === 'board-index';
const threads = entries.filter((entry) => entry.data.kind === 'forum-thread');
const boardIndexes = entries.filter((entry) => entry.data.kind === 'board-index');

// Threads are grouped by the board they lived on, read from the breadcrumb of
// the capture itself. Some captures do not carry one; those are grouped last
// and labelled rather than guessed at.
const boards = [...new Set(threads.map((entry) => entry.data.board).filter(Boolean))].sort();
const threadGroups = [
  ...boards.map((board) => ({ board, entries: threads.filter((entry) => entry.data.board === board) })),
  { board: 'Board not recorded', entries: threads.filter((entry) => !entry.data.board) },
].filter((group) => group.entries.length > 0);

// Eras, in the order the sites existed. A record belongs to the site it was
// published on, which is also the story the archive tells.
const eras = [
  {
    id: 'darkpawns',
    title: 'darkpawns.com',
    years: '2002 to 2005',
    note: "Frontline's own site: the news page, the map of Kir Drax'in, and the handbooks that described the world.",
    entries: entries.filter((entry) => entry.data.sourceSite === 'darkpawns.com' && !isForum(entry)),
  },
  {
    id: 'player-page',
    title: 'dp-players.com',
    years: '2004',
    note: 'The player page: the history of the game, directions and equipment guides, and the pages players kept for each other.',
    entries: entries.filter((entry) => entry.data.sourceSite === 'dp-players.com' && !isForum(entry)),
  },
];

const totals = {
  entries: entries.length,
  threads: threads.length,
  posts: threads.reduce((sum, entry) => sum + (entry.data.postCount ?? 0), 0),
  voices: new Set(
    threads.flatMap((entry) => (entry.data.participants ?? []).map((person) => person.name)),
  ).size,
};

// Named absences. Every one of these is a URL the recovery checked and closed,
// not a page nobody looked for.
const missing = [
  {
    what: 'The drawn world map',
    detail: "darkpawns.com published a picture of Kir Drax'in beside the text map. The page survived; the image was never captured.",
  },
  {
    what: 'The guide articles',
    detail: 'The player page indexed a shelf of strategy articles. The index survived. None of the articles it linked to were archived.',
  },
  {
    what: 'The game logs',
    detail: 'Players uploaded transcripts of hunts and deaths. The log index survived; the transcripts themselves were never crawled.',
  },
  {
    what: 'Most of the forum',
    detail: 'The board index lists topics whose pages have no capture at any timestamp, and long threads survive only as their final page.',
  },
];
---
<Base title="Archive | Dark Pawns" description="Recovered conversations and records from the original Dark Pawns community.">
  <div class="container archive-hub">
    <p class="eyebrow">Recovered from the old web</p>
    <h1>The Archive</h1>
    <p class="lede">
      Dark Pawns was more than a codebase. It was arguments, jokes, quests, grudges, and people
      trying to keep a world alive. These records were recovered from archived copies of
      dp-players.com and darkpawns.com, then checked and preserved with their provenance intact.
    </p>

    <dl class="tally">
      <div><dt>Records</dt><dd>{totals.entries}</dd></div>
      <div><dt>Conversations</dt><dd>{totals.threads}</dd></div>
      <div><dt>Posts</dt><dd>{totals.posts}</dd></div>
      <div><dt>People</dt><dd>{totals.voices}</dd></div>
    </dl>

    <aside class="archive-note">
      <strong>A living collection.</strong> Some pages survived whole; others vanished between
      captures. We publish only material we can trace to an archived source, and we do not publish
      private contact information.
      If you recognize something or remember what is missing, <a href="/contact/">send a private message</a>.
    </aside>

    {eras.map((era) => era.entries.length > 0 && (
      <section class="era" id={era.id}>
        <header class="era-head">
          <p class="era-years">{era.years}</p>
          <div>
            <h2>{era.title}</h2>
            <p>{era.note}</p>
          </div>
        </header>
        <ol class="archive-list">
          {era.entries.map((entry) => (
            <li>
              <a href={`/archive/${entry.id}/`}>
                <span class="archive-date">{entry.data.dateLabel}</span>
                <span class="archive-title">{entry.data.title}</span>
                <span class="archive-desc">{entry.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section class="era" id="forum">
      <header class="era-head">
        <p class="era-years">2004</p>
        <div>
          <h2>The forum</h2>
          <p>
            dp-players.com ran a phpBB board. These are the conversations that survived, grouped by
            the board they were posted on.
          </p>
        </div>
      </header>
      {boardIndexes.length > 0 && (
        <ol class="archive-list board-index-list">
          {boardIndexes.map((entry) => (
            <li>
              <a href={`/archive/${entry.id}/`}>
                <span class="archive-date">{entry.data.dateLabel}</span>
                <span class="archive-title">{entry.data.title}</span>
                <span class="archive-desc">{entry.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
      {threadGroups.map((group) => (
        <div class="board">
          <h3>{group.board}</h3>
          <ol class="archive-list">
            {group.entries.map((entry) => (
              <li>
                <a href={`/archive/${entry.id}/`}>
                  <span class="archive-date">{entry.data.dateLabel}</span>
                  <span class="archive-title">
                    {entry.data.title}
                    {entry.data.completeness === 'partial' && <span class="chip partial">partial</span>}
                  </span>
                  <span class="archive-desc">{entry.data.description}</span>
                  {entry.data.postCount && (
                    <span class="archive-meta">
                      {entry.data.postCount} posts
                      {entry.data.participants && ` · ${entry.data.participants.length} people`}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="era gap" id="missing">
      <header class="era-head">
        <p class="era-years">Gaps</p>
        <div>
          <h2>What is missing</h2>
          <p>
            The recovery checked every URL the surviving pages pointed at, and closed each one with a
            result. These are the ones that came back empty. They are listed because an archive that
            hides its gaps is not a record.
          </p>
        </div>
      </header>
      <dl class="missing">
        {missing.map((item) => (
          <div>
            <dt>{item.what}</dt>
            <dd>{item.detail}</dd>
          </div>
        ))}
      </dl>
      <p class="gap-ask">
        If you kept backups from the dp-players.com era, those files are the only remaining source
        for any of this. <a href="/contact/">Get in touch.</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .archive-hub { padding-block: var(--space-xl) var(--space-lg); }
  .eyebrow {
    margin-bottom: var(--space-xs);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lede { max-width: 58ch; color: var(--ink-muted); font-size: 1.15rem; }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    max-width: 58rem;
    margin: var(--space-lg) 0 0;
  }
  .tally div { display: flex; flex-direction: column-reverse; gap: 0.1rem; }
  .tally dt { color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .tally dd { margin: 0; font-family: var(--font-display); font-size: 1.75rem; line-height: 1; font-variant-numeric: tabular-nums; }

  .archive-note {
    max-width: 58rem;
    margin: var(--space-lg) 0;
    border-block: 1px solid var(--rule);
    padding: var(--space-md) 0;
  }

  .era { max-width: 58rem; margin-top: var(--space-xl); }
  .era-head { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-lg); align-items: baseline; }
  .era-head h2 { margin: 0; }
  .era-head p { margin: 0 0 var(--space-sm); color: var(--ink-muted); }
  .era-years { margin: 0; color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; }

  .board { margin-top: var(--space-lg); }
  .board h3 {
    margin: 0 0 var(--space-xs);
    margin-left: 12rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .archive-list { margin: 0; padding: 0; list-style: none; }
  .archive-list li { border-top: 1px solid var(--rule); }
  .archive-list li:last-child { border-bottom: 1px solid var(--rule); }
  .archive-list a {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-xs) var(--space-lg);
    padding: var(--space-md) 0;
    color: var(--ink);
  }
  .archive-list a:hover { color: var(--accent); text-decoration: none; }
  .archive-date { grid-row: 1 / -1; color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.75rem; }
  .archive-title { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2; }
  .archive-desc { color: var(--ink-muted); }
  .archive-meta { color: var(--ink-muted); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; }
  .board-index-list { margin-bottom: var(--space-md); }

  .chip {
    display: inline-block;
    margin-left: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: middle;
    color: var(--ink-muted);
  }

  .gap .missing { margin: 0; }
  .gap .missing div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-lg);
    border-top: 1px solid var(--rule);
    padding: var(--space-md) 0;
  }
  .gap .missing div:last-child { border-bottom: 1px solid var(--rule); }
  .gap .missing dt { font-family: var(--font-display); font-size: 1.05rem; }
  .gap .missing dd { margin: 0; color: var(--ink-muted); }
  .gap-ask { margin-top: var(--space-md); margin-left: 12rem; color: var(--ink-muted); }

  @media (max-width: 640px) {
    .era-head { grid-template-columns: 1fr; gap: var(--space-xs); }
    .archive-list a { grid-template-columns: 1fr; gap: var(--space-xs); }
    .archive-date { grid-row: auto; }
    .board h3, .gap-ask { margin-left: 0; }
    .gap .missing div { grid-template-columns: 1fr; gap: var(--space-xs); }
  }
</style>
