---
import Base from '../../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('logs', ({ data }) => !data.draft);

// Every character named in a log, with how many scenes they appear in and how
// many they recorded. Names are counted case-insensitively but shown as most
// often captured.
const characters = new Map<string, { name: string; scenes: number; recorded: number; counts: Map<string, number> }>();
for (const entry of entries) {
  const recKey = entry.data.recordedBy.toLowerCase();
  const seenInEntry = new Set<string>();
  for (const name of entry.data.cast) {
    const key = name.toLowerCase();
    seenInEntry.add(key);
    const row = characters.get(key) ?? { name, scenes: 0, recorded: 0, counts: new Map() };
    row.scenes += 1;
    if (recKey === key) row.recorded += 1;
    row.counts.set(name, (row.counts.get(name) ?? 0) + 1);
    characters.set(key, row);
  }
  if (!seenInEntry.has(recKey)) {
    const row = characters.get(recKey);
    if (row) row.recorded += 1;
  }
}
const people = [...characters.entries()]
  .map(([key, row]) => ({
    key,
    name: [...row.counts.entries()].sort((a, b) => b[1] - a[1])[0][0],
    scenes: row.scenes,
    recorded: row.recorded,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));

const topActive = [...people]
  .filter((p) => p.key !== 'someone')
  .sort((a, b) => b.scenes - a.scenes || a.name.localeCompare(b.name, 'en'))
  .slice(0, 12);
---
<Base title="Characters in the logs | Dark Pawns Logs" description="Every character named in the Dark Pawns logs captured on the original server, with the sessions each one appears in.">
  <article class="entry">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/archive/">The Archive</a> » <a href="/archive/logs/">Logs</a> » <span>Characters</span>
    </nav>
    <h1>Characters in the logs</h1>
    <p class="lede">
      Every character named in a capture from the original server, as the logs
      spell them. A name is only a character in the game; it is never linked to
      a person.
    </p>

    <section class="leaders" aria-labelledby="leaders-h">
      <header class="band">
        <h2 id="leaders-h">Most active on screen</h2>
        <p class="band-count">Top {topActive.length} of {people.length}</p>
      </header>
      <ol class="leader-grid">
        {topActive.map((person) => (
          <li>
            <a href={`/archive/logs/characters/${encodeURIComponent(person.key)}/`}>
              <span class="leader-name">{person.name}</span>
              <span class="leader-meta">
                {person.scenes} {person.scenes === 1 ? 'session' : 'sessions'}
                {person.recorded > 0 && ` · ${person.recorded} recorded`}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="roster" aria-labelledby="roster-h">
      <header class="band">
        <h2 id="roster-h">All characters (A to Z)</h2>
        <p class="band-count" id="char-count">{people.length} characters across {entries.length} sessions</p>
      </header>
      <div class="char-filter" role="search" aria-label="Filter characters">
        <label for="char-filter-input" class="visually-hidden">Filter character names</label>
        <input
          id="char-filter-input"
          type="search"
          placeholder="Find a character name (e.g. Vargus, Farius, Jyan, Pickle)..."
          autocomplete="off"
        />
      </div>
      <ul class="rows" id="char-rows">
        {people.map((person) => (
          <li data-name={person.key}>
            <a href={`/archive/logs/characters/${encodeURIComponent(person.key)}/`}>
              <span class="row-title">{person.name}</span>
              <span class="row-meta">
                {person.scenes} {person.scenes === 1 ? 'session' : 'sessions'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>

<script>
  const input = document.getElementById('char-filter-input') as HTMLInputElement | null;
  const countEl = document.getElementById('char-count');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#char-rows > li'));
  const total = items.length;

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const match = !q || (li.dataset.name ?? '').includes(q);
      li.hidden = !match;
      if (match) shown += 1;
    }
    if (countEl) {
      countEl.textContent = q ? `${shown} of ${total} characters` : `${total} characters`;
    }
  });
</script>

<style>
  .entry {
    --t-label: 0.8rem;
    --t-lede: 1.15rem;
    --t-section: 1.375rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
  }
  .crumb { margin-bottom: var(--space-sm); font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .crumb a { color: var(--ink-muted); }
  .crumb a:hover { color: var(--accent); }
  .lede { max-width: 60ch; font-size: var(--t-lede); color: var(--ink-muted); margin-bottom: var(--space-lg); }

  .band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    border-bottom: 2px solid var(--rule);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-md);
  }
  .band h2 { margin: 0; font-size: var(--t-section); }
  .band-count { margin: 0; font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }

  .leaders { margin-bottom: var(--space-xl); }
  .leader-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .leader-grid a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: 0.4rem 0.65rem;
    color: var(--ink);
    text-decoration: none;
  }
  .leader-grid a:hover { border-color: var(--accent); }
  .leader-grid a:hover .leader-name { color: var(--accent); }
  .leader-name { font-family: var(--font-display); font-size: var(--t-lede); }
  .leader-meta { font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }

  .char-filter { margin-bottom: var(--space-md); }
  .char-filter input {
    width: 100%;
    max-width: 32rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: 0.4rem 0.65rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
  }
  .char-filter input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; background: var(--paper); }

  .rows { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule); columns: 3; column-gap: var(--space-lg); }
  .rows li { border-top: 1px solid var(--rule); break-inside: avoid; }
  .rows a { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); padding: 0.35rem 0; color: var(--ink); text-decoration: none; }
  .row-title { font-family: var(--font-display); font-size: var(--t-lede); line-height: 1.2; }
  .rows a:hover .row-title { color: var(--accent); }
  .row-meta { color: var(--ink-muted); font-family: var(--font-mono); font-size: var(--t-label); white-space: nowrap; }
  @media (max-width: 820px) { .rows { columns: 2; } }
  @media (max-width: 540px) { .rows { columns: 1; } }
</style>
