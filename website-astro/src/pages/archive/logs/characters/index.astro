---
import Base from '../../../../layouts/Base.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { appearancesOf, characterKeys } from '../../../../lib/mudlog/entry';

const entries = await getCollection('logs');
const people = characterKeys(entries)
  .map((key) => {
    const rows = appearancesOf(entries, key);
    return { key, name: rows[0].name, logs: rows.length };
  })
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));
---
<Base title="Characters in the logs | Dark Pawns" description="Every character named in the Dark Pawns game logs from the original server, with the logs each one appears in.">
  <article class="entry">
    <Breadcrumb trail={[{ label: 'The Archive', href: '/archive/' }, { label: 'Logs', href: '/archive/logs/' }, { label: 'Characters' }]} />
    <h1>Characters in the logs</h1>
    <p class="lede">
      Every character named in a capture from the original server, as the logs
      spell them. A name here is a character in the game.
    </p>

    <section class="roster" aria-labelledby="roster-h">
      <header class="band">
        <h2 id="roster-h" class="visually-hidden">All characters</h2>
        <p class="band-count" id="char-count">{people.length} characters</p>
      </header>
      <div class="char-filter" role="search" aria-label="Filter characters">
        <label for="char-filter-input" class="visually-hidden">Filter character names</label>
        <input id="char-filter-input" type="search" placeholder="Find a character" autocomplete="off" />
      </div>
      <ul class="rows" id="char-rows">
        {people.map((person) => (
          <li data-name={person.key}>
            <a href={`/archive/logs/characters/${encodeURIComponent(person.key)}/`}>
              <span class="row-title">{person.name}</span>
              <span class="row-meta">{person.logs} {person.logs === 1 ? 'log' : 'logs'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</Base>

<script>
  const input = document.getElementById('char-filter-input') as HTMLInputElement | null;
  const countEl = document.getElementById('char-count');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#char-rows > li'));
  const total = items.length;

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const match = !q || (li.dataset.name ?? '').includes(q);
      li.hidden = !match;
      if (match) shown += 1;
    }
    if (countEl) {
      countEl.textContent = q ? `${shown} of ${total} characters` : `${total} characters`;
    }
  });
</script>

<style>
  .entry {
    --t-label: 0.8rem;
    --t-lede: 1.15rem;
    --t-section: 1.375rem;
    max-width: 56rem;
    margin-inline: auto;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
  }
  .lede { max-width: 60ch; font-size: var(--t-lede); color: var(--ink-muted); margin-bottom: var(--space-lg); }

  .band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    border-bottom: 2px solid var(--rule);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-md);
  }
  .band h2 { margin: 0; font-size: var(--t-section); }
  .band-count { margin: 0; font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }

  .char-filter { margin-bottom: var(--space-md); }
  .char-filter input {
    width: 100%;
    max-width: 32rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: 0.4rem 0.65rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
  }
  .char-filter input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; background: var(--paper); }

  .rows { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--rule); columns: 3; column-gap: var(--space-lg); }
  .rows li { border-top: 1px solid var(--rule); break-inside: avoid; }
  .rows a { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-sm); padding: 0.35rem 0; color: var(--ink); text-decoration: none; }
  .row-title { font-family: var(--font-display); font-size: var(--t-lede); line-height: 1.2; }
  .rows a:hover .row-title { color: var(--accent); }
  .row-meta { color: var(--ink-muted); font-family: var(--font-mono); font-size: var(--t-label); white-space: nowrap; }
  @media (max-width: 820px) { .rows { columns: 2; } }
  @media (max-width: 540px) { .rows { columns: 1; } }
</style>
