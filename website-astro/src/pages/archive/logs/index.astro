---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('logs', ({ data }) => !data.draft);
const byId = new Map(entries.map((entry) => [entry.id, entry]));

// Parse the line span ("lines 1 to 2,032" or "1-2,032") to compute exact line counts.
function parseLineCount(sourceLines: string): number {
  const m = /([\d,]+)\s*(?:to|[-\u2013\u2014])\s*([\d,]+)/i.exec(sourceLines.trim());
  if (!m) return 0;
  const start = Number(m[1].replace(/,/g, ''));
  const end = Number(m[2].replace(/,/g, ''));
  return end >= start ? end - start + 1 : 0;
}

function extractPartNum(id: string, title: string, fallback: number): number {
  const mt = /\(part (\d+)\)\s*$/i.exec(title);
  if (mt) return Number(mt[1]);
  const mi = /-(\d+)$/.exec(id);
  if (mi) return Number(mi[1]);
  return fallback;
}

const totalLines = entries.reduce((sum, e) => sum + parseLineCount(e.data.sourceLines), 0);

// Count every character across all published sessions.
const characterCounts = new Map<string, { name: string; count: number }>();
for (const entry of entries) {
  for (const name of entry.data.cast) {
    const key = name.toLowerCase();
    const prev = characterCounts.get(key);
    if (!prev || prev.count < 1) {
      characterCounts.set(key, { name, count: (prev?.count ?? 0) + 1 });
    } else {
      prev.count += 1;
    }
  }
}
const topCharacters = [...characterCounts.entries()]
  .filter(([key]) => key !== 'someone')
  .map(([key, val]) => ({ key, name: val.name, count: val.count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'en'))
  .slice(0, 12);

// Group sessions by their original capture file so multi-part raids sit together
// in line order instead of scattering alphabetically across the page.
interface CaptureGroup {
  sourceFile: string;
  dateLabel: string;
  sortTime: number;
  recorders: string[];
  castList: string[];
  totalLines: number;
  parts: Array<{
    entry: (typeof entries)[number];
    partNum: number;
    lineCount: number;
  }>;
}

const groupedMap = new Map<string, typeof entries>();
for (const entry of entries) {
  const list = groupedMap.get(entry.data.sourceFile) ?? [];
  list.push(entry);
  groupedMap.set(entry.data.sourceFile, list);
}

const groups: CaptureGroup[] = [...groupedMap.entries()]
  .map(([sourceFile, list]) => {
    list.sort((a, b) => a.data.sourceStart - b.data.sourceStart);
    const recorders = [...new Set(list.map((e) => e.data.recordedBy))];
    const castSet = new Set<string>();
    for (const e of list) {
      for (const c of e.data.cast) castSet.add(c);
    }
    const dated = list.find((e) => e.data.dateLabel !== 'Date not recorded') ?? list[0];
    return {
      sourceFile,
      dateLabel: dated.data.dateLabel,
      sortTime: dated.data.sortDate ? dated.data.sortDate.getTime() : 0,
      recorders,
      castList: [...castSet],
      totalLines: list.reduce((sum, e) => sum + parseLineCount(e.data.sourceLines), 0),
      parts: list.map((entry, idx) => ({
        entry,
        partNum: extractPartNum(entry.id, entry.data.title, idx + 1),
        lineCount: parseLineCount(entry.data.sourceLines),
      })),
    };
  })
  .sort((a, b) => a.sourceFile.localeCompare(b.sourceFile, 'en', { sensitivity: 'base' }));

// Shortlist of raids and boss kills. Each line is checked against its log.
const shortlist = [
  {
    id: 'nimos-raid',
    tag: 'Raid · 2,032 lines',
    why: 'Vargus leads seventeen players against Nimos and Lady Amber. Nimos falls at line 1,731, Lady Amber at 2,029.',
  },
  {
    id: 'shax12601-2',
    tag: 'Dragon kill · 2,500 lines',
    why: 'Farius\'s screen as Shax\'in, the brown dragon, dies at line 1,876.',
  },
  {
    id: 'dlich91500-1',
    tag: 'Boss kill · 1,466 lines',
    why: 'Vargus, Pickle, Farius and Folken kill the dracolich at line 1,440.',
  },
  {
    id: 'amber121200-5',
    tag: 'Amber raid · 2,500 lines',
    why: 'Part five of a long Amber capture on Farius\'s screen. Prince Bleys dies at line 824.',
  },
  {
    id: 'shax232-1',
    tag: 'Dragon fight · 2,500 lines',
    why: 'Shax\'in, the brown dragon, kills Jyan, Aiko, Hatsumi and Malasand on Farius\'s screen.',
  },
  {
    id: 'ssyzyilsolo1031-1',
    tag: 'Boss kill · 430 lines',
    why: 'Vargus and Farius fight Ssyzyil, the Abomination, who dies at line 419.',
  },
  {
    id: 'drath82900-1',
    tag: 'Boss kill · 1,593 lines',
    why: 'Vargus, Farius, Folken and Icarus kill Overlord Mischra Drath at line 1,129.',
  },
].map((pick) => ({ ...pick, entry: byId.get(pick.id) })).filter((pick) => pick.entry);

// Recorder filter pills with session counts.
const recorderCounts = new Map<string, number>();
for (const e of entries) {
  recorderCounts.set(e.data.recordedBy, (recorderCounts.get(e.data.recordedBy) ?? 0) + 1);
}
// Logs whose screen cannot be identified (an empty recordedBy) get no pill.
const recorders = [...recorderCounts.entries()].filter(([name]) => name).sort((a, b) => b[1] - a[1]);

const site = 'https://darkpawns.org';
const collectionLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Dark Pawns Game Logs',
  description: 'Game logs captured on the original Dark Pawns server, donated by Vargus and rendered in rebuilt ANSI color.',
  url: `${site}/archive/logs/`,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Dark Pawns', url: site },
});
---
<Base title="Game Logs | Dark Pawns Archive" description={`${entries.length} sessions captured on the original Dark Pawns server, donated by Vargus and rebuilt in server-accurate ANSI color.`}>
  <script slot="head" type="application/ld+json" set:html={collectionLd} />
  <div class="container logs-hub">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/archive/">The Archive</a> » <span>Logs</span>
    </nav>
    <h1>The Game Logs</h1>
    <p class="lede">
      Plain-text captures recorded in zMUD on the original server,
      donated by Vargus. Every line is colored again from the C source code at the
      four settings the game's <code>color</code> command offered. Private tells and whispers,
      mudmail, email addresses, IP addresses and passwords are removed, and each session counts
      its own redactions in the provenance.
    </p>

    <dl class="tally">
      <div><dd>{entries.length}</dd><dt>Sessions</dt></div>
      <div><dd>{groups.length}</dd><dt>Capture files</dt></div>
      <div>
        <dd><a href="/archive/logs/characters/">{characterCounts.size}</a></dd>
        <dt><a href="/archive/logs/characters/">Characters »</a></dt>
      </div>
      <div><dd>{totalLines.toLocaleString('en-US')}</dd><dt>Lines of output</dt></div>
    </dl>

    <section class="start" aria-labelledby="start-here">
      <header class="band">
        <h2 id="start-here">Start here</h2>
        <p class="band-count">{shortlist.length} sessions</p>
      </header>
      <ol class="start-list">
        {shortlist.map((pick) => (
          <li>
            <div class="start-top">
              <a class="start-title" href={`/archive/logs/${pick.entry!.id}/`}>{pick.entry!.data.title}</a>
              <span class="start-meta">{pick.entry!.data.sourceFile} · {pick.tag}</span>
            </div>
            <p class="start-why">{pick.why}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="roster-strip" aria-labelledby="roster-h">
      <header class="band">
        <h2 id="roster-h">Characters on screen</h2>
        <p class="band-count">
          <a href="/archive/logs/characters/">All {characterCounts.size} characters »</a>
        </p>
      </header>
      <p class="site-note">
        Every character named in a group list, room or combat line has an index page linking the exact line of their first appearance in each session.
      </p>
      <ul class="top-cast">
        {topCharacters.map((c) => (
          <li>
            <a href={`/archive/logs/characters/${encodeURIComponent(c.key)}/`}>
              <span class="cast-name">{c.name}</span>
              <span class="cast-count">{c.count}</span>
            </a>
          </li>
        ))}
        <li class="cast-more">
          <a href="/archive/logs/characters/">Browse all {characterCounts.size} characters »</a>
        </li>
      </ul>
    </section>

    <section class="catalog" id="all-logs" aria-labelledby="h-catalog">
      <header class="band">
        <h2 id="h-catalog">All captures</h2>
        <p class="band-count" id="logs-VisibleCount">{entries.length} sessions in {groups.length} files</p>
      </header>
      <p class="site-note">
        Long captures are split at quit, relogin or idle boundaries near 2,500 lines so every page loads quickly while keeping its raw line numbers intact.
      </p>

      <div class="filter-bar" role="search" aria-label="Filter game logs">
        <div class="filter-search">
          <label for="log-filter-input" class="visually-hidden">Filter by title, character, or file</label>
          <input
            id="log-filter-input"
            type="search"
            placeholder="Filter by character, boss, room, or filename (e.g. Shax'in, Amber, Pickle)..."
            autocomplete="off"
          />
        </div>
        <div class="filter-recorders" role="group" aria-label="Filter by recording character">
          <span class="filter-label">pov:</span>
          <button type="button" class="rec-btn active" data-recorder="all" aria-pressed="true">
            All ({entries.length})
          </button>
          {recorders.map(([name, count]) => (
            <button type="button" class="rec-btn" data-recorder={name.toLowerCase()} aria-pressed="false">
              {name} ({count})
            </button>
          ))}
        </div>
      </div>

      <p id="logs-empty" class="empty-msg" hidden>
        No captures match that filter. <button type="button" id="logs-reset" class="link-btn">Show all {entries.length} sessions</button>.
      </p>

      <ol class="capture-list" id="capture-list">
        {groups.map((group) => {
          const single = group.parts.length === 1 ? group.parts[0] : null;
          const searchBlob = [
            group.sourceFile,
            group.dateLabel,
            ...group.recorders,
            ...group.castList,
            ...group.parts.map((p) => `${p.entry.data.title} ${p.entry.data.description}`),
          ].join(' ').toLowerCase();
          const recordersAttr = group.recorders.map((r) => r.toLowerCase()).join(' ');

          return (
            <li
              class:list={['capture-group', { 'is-multipart': !single }]}
              data-search={searchBlob}
              data-recorders={recordersAttr}
              data-parts={group.parts.length}
            >
              {single ? (
                <div class="single-row">
                  <div class="row-main">
                    <a class="row-title" href={`/archive/logs/${single.entry.id}/`}>
                      {single.entry.data.title}
                    </a>
                    <span class="row-file">
                      <code>{group.sourceFile}</code>
                      · {single.lineCount.toLocaleString('en-US')} lines
                      {group.dateLabel !== 'Date not recorded' && ` · ${group.dateLabel}`}
                    </span>
                  </div>
                  <p class="row-desc">{single.entry.data.description}</p>
                  <div class="row-cast">
                    <span class="pov-tag">pov: {single.entry.data.recordedBy || 'not identified'}</span>
                    {single.entry.data.cast.length > 1 && (
                      <span class="with-cast">
                        with {single.entry.data.cast.filter((c) => c !== single.entry.data.recordedBy).slice(0, 7).join(', ')}
                        {single.entry.data.cast.length > 8 && ` +${single.entry.data.cast.length - 8} more`}
                      </span>
                    )}
                  </div>
                </div>
              ) : (
                <div class="multi-group">
                  <div class="multi-head">
                    <div class="multi-title-wrap">
                      <span class="multi-file"><code>{group.sourceFile}</code></span>
                      <span class="multi-badge">{group.parts.length} parts · {group.totalLines.toLocaleString('en-US')} lines</span>
                    </div>
                    <span class="multi-meta">
                      pov: {group.recorders.map((r) => r || 'not identified').join(', ')}
                      {group.dateLabel !== 'Date not recorded' && ` · ${group.dateLabel}`}
                    </span>
                  </div>
                  {group.castList.length > 1 && (
                    <p class="multi-cast">
                      Cast across file: {group.castList.slice(0, 10).join(', ')}
                      {group.castList.length > 10 && ` +${group.castList.length - 10} more`}
                    </p>
                  )}
                  <ol class="part-rows">
                    {group.parts.map((part) => {
                      const partSearch = `${part.entry.data.title} ${part.entry.data.description} ${part.entry.data.cast.join(' ')} ${group.sourceFile}`.toLowerCase();
                      return (
                        <li
                          class="part-item"
                          data-part-search={partSearch}
                          data-part-recorder={part.entry.data.recordedBy.toLowerCase()}
                        >
                          <a href={`/archive/logs/${part.entry.id}/`}>
                            <span class="part-num">Part {part.partNum}</span>
                            <span class="part-title">{part.entry.data.title.replace(/\s*\(part \d+\)$/i, '')}</span>
                            <span class="part-lines">{part.entry.data.sourceLines}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</Base>

<script>
  const input = document.getElementById('log-filter-input') as HTMLInputElement | null;
  const countEl = document.getElementById('logs-VisibleCount');
  const emptyEl = document.getElementById('logs-empty');
  const resetBtn = document.getElementById('logs-reset');
  const recBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.rec-btn'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.capture-group'));

  let activeRecorder = 'all';

  function applyFilter() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let visibleSessions = 0;
    let visibleFiles = 0;

    for (const group of groups) {
      const partItems = Array.from(group.querySelectorAll<HTMLElement>('.part-item'));
      if (partItems.length > 0) {
        let groupMatchedParts = 0;
        for (const part of partItems) {
          const pSearch = part.dataset.partSearch ?? '';
          const pRec = part.dataset.partRecorder ?? '';
          const matchQ = !q || pSearch.includes(q);
          const matchRec = activeRecorder === 'all' || pRec === activeRecorder;
          const show = matchQ && matchRec;
          part.hidden = !show;
          if (show) groupMatchedParts += 1;
        }
        const showGroup = groupMatchedParts > 0;
        group.hidden = !showGroup;
        if (showGroup) {
          visibleFiles += 1;
          visibleSessions += groupMatchedParts;
        }
      } else {
        const gSearch = group.dataset.search ?? '';
        const gRecs = (group.dataset.recorders ?? '').split(' ');
        const matchQ = !q || gSearch.includes(q);
        const matchRec = activeRecorder === 'all' || gRecs.includes(activeRecorder);
        const show = matchQ && matchRec;
        group.hidden = !show;
        if (show) {
          visibleFiles += 1;
          visibleSessions += 1;
        }
      }
    }

    if (countEl) {
      countEl.textContent = `${visibleSessions} ${visibleSessions === 1 ? 'session' : 'sessions'} in ${visibleFiles} ${visibleFiles === 1 ? 'file' : 'files'}`;
    }
    if (emptyEl) {
      emptyEl.hidden = visibleSessions > 0;
    }
  }

  input?.addEventListener('input', applyFilter);

  for (const btn of recBtns) {
    btn.addEventListener('click', () => {
      activeRecorder = btn.dataset.recorder ?? 'all';
      for (const b of recBtns) {
        const isCurrent = b === btn;
        b.classList.toggle('active', isCurrent);
        b.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      }
      applyFilter();
    });
  }

  resetBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    activeRecorder = 'all';
    for (const b of recBtns) {
      const isAll = b.dataset.recorder === 'all';
      b.classList.toggle('active', isAll);
      b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
    }
    applyFilter();
  });
</script>

<style>
  .logs-hub {
    --archive-width: 58rem;
    --t-label: 0.8rem;
    --t-body: 1rem;
    --t-lede: 1.15rem;
    --t-row: 1.25rem;
    --t-section: 1.375rem;
    --t-figure: 1.75rem;
    padding-block: var(--space-lg) var(--space-xl);
  }
  .logs-hub > * { max-width: var(--archive-width); }
  .crumb { margin-bottom: var(--space-sm); font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .crumb a { color: var(--ink-muted); }
  .crumb a:hover { color: var(--accent); }
  .lede { max-width: 62ch; color: var(--ink-muted); font-size: var(--t-lede); }
  .lede code { font-size: 0.9em; background: var(--paper-deep); padding: 0.05rem 0.3rem; color: var(--ink); }

  /* Tally strip (matching /archive/) */
  .tally {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 2px solid var(--rule);
    margin-block: var(--space-lg) var(--space-xl);
  }
  .tally > div {
    padding: var(--space-md);
    border-left: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
  }
  .tally > div:first-child { border-left: 0; padding-left: 0; }
  .tally dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--t-figure);
    line-height: 1;
    color: var(--ink);
  }
  .tally dd a { color: var(--ink); text-decoration: none; }
  .tally dd a:hover { color: var(--accent); }
  .tally dt {
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }
  .tally dt a { color: var(--accent); text-decoration: none; }
  .tally dt a:hover { text-decoration: underline; }

  .band {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    border-bottom: 2px solid var(--rule);
    padding-bottom: var(--space-xs);
  }
  .band h2 { margin: 0; font-size: var(--t-section); }
  .band-count { margin: 0; font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .band-count a { color: var(--accent); text-decoration: none; }
  .band-count a:hover { text-decoration: underline; }

  .site-note { margin: var(--space-sm) 0 var(--space-md); max-width: 62ch; color: var(--ink-muted); }

  /* Start here showcase */
  .start { margin-bottom: var(--space-xl); }
  .start-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: pick;
  }
  .start-list li {
    counter-increment: pick;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    column-gap: var(--space-sm);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--rule);
  }
  .start-list li::before {
    content: counter(pick, decimal-leading-zero);
    grid-row: 1 / span 2;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--accent);
    padding-top: 0.25rem;
  }
  .start-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
  }
  .start-title {
    font-family: var(--font-display);
    font-size: var(--t-row);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.25;
  }
  .start-title:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.18em; }
  .start-meta { font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .start-why { margin: var(--space-xs) 0 0; max-width: 62ch; color: var(--ink-muted); }

  /* Characters strip */
  .roster-strip { margin-bottom: var(--space-xl); }
  .top-cast {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .top-cast a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: 0.25rem 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .top-cast a:hover { border-color: var(--accent); color: var(--accent); }
  .cast-name { font-family: var(--font-display); font-size: var(--t-lede); }
  .cast-count { font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .cast-more a {
    background: var(--paper);
    border-color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--t-label);
  }

  /* Filter bar */
  .filter-bar {
    display: grid;
    gap: var(--space-sm);
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-md);
  }
  .filter-search input {
    width: 100%;
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 0.45rem 0.65rem;
    font-family: var(--font-body);
    font-size: var(--t-body);
    color: var(--ink);
  }
  .filter-search input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .filter-recorders {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--t-label);
  }
  .filter-label { color: var(--ink-muted); margin-right: 0.2rem; }
  .rec-btn {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink);
    cursor: pointer;
  }
  .rec-btn:hover { border-color: var(--ink); }
  .rec-btn.active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .rec-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .empty-msg {
    border: 1px solid var(--rule);
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--t-label);
    color: var(--ink-muted);
  }
  .link-btn {
    border: 0;
    background: transparent;
    padding: 0;
    font: inherit;
    color: var(--accent);
    text-decoration: underline;
    cursor: pointer;
  }

  /* Capture groups */
  .capture-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .capture-group {
    border-bottom: 1px solid var(--rule);
