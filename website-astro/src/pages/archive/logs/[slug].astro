---
import { readFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Colorizer, loadWorldText, type Line } from '../../../lib/mudlog/colorize';
import { describeLog, others, recorders, redactionSummary } from '../../../lib/mudlog/entry';

export async function getStaticPaths() {
  const entries = await getCollection('logs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;

const raw = readFileSync(resolve(dirname(resolve(entry.filePath!)), data.log), 'utf8');
const lines = new Colorizer(loadWorldText()).colorize(raw);

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// One span per line so any line can be cited by its number (#L650). Coloured
// runs carry their colour and the `color` level the server gated them on.
const renderLine = (runs: Line, n: number) =>
  `<span class="ln" id="L${n}">${runs.map((run) => run.color
    ? `<span class="c-${run.color}" data-l="${run.level}">${escape(run.text)}</span>`
    : escape(run.text)).join('')}</span>`;
// Lines are blocks, so they are joined without newlines; an empty line keeps
// one space so it still holds its height. A long capture is grouped into
// chunks the browser can skip drawing until they scroll near.
const CHUNK = 400;
const rendered = lines.map((runs, i) => renderLine(runs.length === 1 && !runs[0].text ? [{ text: ' ' }] : runs, i + 1));
const logHtml = Array.from({ length: Math.ceil(rendered.length / CHUNK) }, (_, c) =>
  `<span class="chunk">${rendered.slice(c * CHUNK, (c + 1) * CHUNK).join('')}</span>`).join('');

// The four settings of the in-game `color` command (screen.h C_OFF..C_CMP).
const LEVELS = ['off', 'sparse', 'normal', 'complete'];

const onScreen = others(data);
const removed = redactionSummary(data.redactions);
const description = describeLog(data);
const pageTitle = `${data.title}${data.cast.length ? `, with ${data.cast.slice(0, 3).join(', ')}` : ''} | Dark Pawns logs`;
const characterUrl = (name: string) => `/archive/logs/characters/${encodeURIComponent(name.toLowerCase())}/`;

const site = 'https://darkpawns.org';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description,
  inLanguage: 'en',
  url: `${site}/archive/logs/${entry.id}/`,
  isPartOf: { '@type': 'CollectionPage', name: 'Dark Pawns game logs', url: `${site}/archive/logs/` },
  ...(data.cast.length ? { character: data.cast.map((name) => ({ '@type': 'Person', name })) } : {}),
  publisher: { '@type': 'Organization', name: 'Dark Pawns', url: site },
});
---
<Base title={pageTitle} description={description}>
  <link slot="head" rel="alternate" type="text/markdown" href={`/archive/logs/${entry.id}.md`} title={`${data.title} as Markdown`} />
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <article class="entry">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/archive/">The Archive</a> » <a href="/archive/logs/">Logs</a>
    </nav>
    <h1>{data.title}</h1>
    <p class="dateline">
      Recorded by {data.recordedBy.length
        ? data.recordedBy.map((name, i) => <>{i > 0 && ' and '}<a href={characterUrl(name)}>{name}</a></>)
        : 'a player the capture never names'}
      · {data.lines.toLocaleString('en-US')} lines
    </p>
  </article>

  <figure class="screen" aria-labelledby="screen-caption">
    <form class="screen-bar" aria-label="Color setting">
      <span class="screen-file">{data.title}</span>
      <fieldset class="levels">
        <legend>color</legend>
        {LEVELS.map((name, level) => (
          <label>
            <input type="radio" name="color" value={level} checked={level === 3} />
            <span>{name}</span>
          </label>
        ))}
      </fieldset>
    </form>
    <pre class="log" tabindex="0" aria-label={`Game log, ${lines.length} lines`}><code set:html={logHtml} /></pre>
    <figcaption id="screen-caption">
      The capture is plain text. The color is rebuilt from the game's source
      code: each kind of message takes the color the server gave it at the
      setting chosen above. Prompt numbers are colored against the highest the
      capture reaches, since it never shows the character's maximums.
    </figcaption>
  </figure>

  <article class="entry">
    {onScreen.length > 0 && (
      <section class="people" aria-labelledby="people-h">
        <h2 id="people-h">On screen</h2>
        <ul>
          {onScreen.map((name) => <li><a href={characterUrl(name)}>{name}</a></li>)}
        </ul>
      </section>
    )}
    <section class="provenance" aria-labelledby="provenance-h">
      <h2 id="provenance-h">Provenance</h2>
      <dl>
        <div><dt>Collection</dt><dd>The Vargus logs, donated by Vargus</dd></div>
        <div><dt>File</dt><dd>{data.nameWithheld ? 'Name withheld: it contains a slur' : data.title}</dd></div>
        <div><dt>Recorded by</dt><dd>{recorders(data)}</dd></div>
        <div><dt>Date</dt><dd>Not recorded</dd></div>
        <div><dt>Removed</dt><dd>{removed ? `${removed}, each replaced by a marker so line numbers still match` : 'Nothing'}</dd></div>
        <div><dt>Plain text</dt><dd><a href={`/archive/logs/${entry.id}.md`}>{entry.id}.md</a></dd></div>
      </dl>
    </section>
  </article>
</Base>

<style>
  .entry { --t-label: 0.8rem; max-width: 46rem; margin-inline: auto; padding-inline: var(--space-md); padding-block: var(--space-lg) 0; }
  .crumb { margin-bottom: var(--space-sm); font-family: var(--font-mono); font-size: var(--t-label); color: var(--ink-muted); }
  .crumb a { color: var(--ink-muted); }
  .crumb a:hover { color: var(--accent); }
  h1 { font-family: var(--font-mono); font-size: clamp(1.6rem, 3vw + 0.8rem, 2.4rem); font-weight: 400; overflow-wrap: anywhere; }
  .dateline { margin: 0 0 var(--space-md); color: var(--ink-muted); }

  .people { margin-block: var(--space-lg) 0; border-top: 1px solid var(--rule); padding-top: var(--space-sm); }
  .people h2, .provenance h2 { margin: 0 0 var(--space-xs); font-family: var(--font-mono); font-size: var(--t-label); font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-muted); }
  .people ul { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); margin: 0; padding: 0; list-style: none; }
  .people a { font-family: var(--font-display); font-size: 1.1rem; }

  /* The screen. The log is the game's own output, so it gets the CRT canvas
     /play uses, under a paper control bar, with the eight ANSI colours tuned
     for that canvas. The figure is wider than the reading column: an
     80-column screen needs the room. */
  .screen {
    --crt: #0a0908;
    --ansi-fg: #b8b1a3;
    --ansi-red: #cf4b42;
    --ansi-green: #82a86c;
    --ansi-yellow: #e3b94a;
    --ansi-blue: #7f9bd0;
    --ansi-magenta: #b98bbf;
    --ansi-cyan: #72b6b0;
    --ansi-white: #ede5d3;
    max-width: 56rem;
    margin: 0 auto;
    padding-inline: var(--space-md);
  }
  .screen-bar {
    position: sticky; top: 0; z-index: 1;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm) var(--space-md);
    border: 2px solid var(--rule); border-bottom: 0;
    background: var(--paper-deep);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono); font-size: 0.7rem;
  }
  .screen-file { color: var(--ink-muted); }
  .levels { display: flex; align-items: center; gap: 0.15rem; margin: 0; border: 0; padding: 0; }
  .levels legend { float: left; margin-right: var(--space-sm); padding: 0; color: var(--ink-muted); }
  .levels label { position: relative; cursor: pointer; }
  .levels input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .levels span { display: block; border: 1px solid transparent; padding: 0.15rem 0.5rem; color: var(--ink); }
  .levels label:hover span { border-color: var(--rule); }
  .levels input:checked + span { background: var(--ink); color: var(--paper); }
  .levels input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 1px; }

  .log {
    margin: 0;
    border: 2px solid var(--rule);
    background: var(--crt);
    color: var(--ansi-fg);
    padding: var(--space-md) var(--space-md) var(--space-lg);
    overflow-x: auto;
    font-family: var(--font-mono); font-size: 0.9rem; line-height: 1.45;
    tab-size: 8;
    scrollbar-color: #3a2a1a var(--crt);
  }
  .log:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .log ::selection { background: #3a2a1a; color: var(--ansi-white); }
  /* 400 lines at 0.9rem x 1.45; "auto" keeps the real height once drawn. */
  .log :global(.chunk) { display: block; content-visibility: auto; contain-intrinsic-size: auto 522rem; }
  .log :global(.ln) { display: block; scroll-margin-top: 5rem; }
  .log :global(.ln:target) { background: #2a1d12; }

  .log :global(.c-red) { color: var(--ansi-red); }
  .log :global(.c-green) { color: var(--ansi-green); }
  .log :global(.c-yellow) { color: var(--ansi-yellow); }
  .log :global(.c-blue) { color: var(--ansi-blue); }
  .log :global(.c-magenta) { color: var(--ansi-magenta); }
  .log :global(.c-cyan) { color: var(--ansi-cyan); }
  .log :global(.c-white) { color: var(--ansi-white); }

  /* clr(ch, lvl) is level >= lvl (screen.h:49): at each setting, anything
     gated above it falls back to the terminal's own colour. No script. */
  .screen:has(input[value="0"]:checked) .log :global([data-l]) { color: inherit; }
  .screen:has(input[value="1"]:checked) .log :global([data-l="2"], [data-l="3"]) { color: inherit; }
  .screen:has(input[value="2"]:checked) .log :global([data-l="3"]) { color: inherit; }

  figcaption { max-width: 62ch; margin-top: var(--space-sm); color: var(--ink-muted); font-size: 0.9rem; }

  .provenance { margin-block: var(--space-lg) var(--space-xl); border-top: 1px solid var(--rule); padding-top: var(--space-sm); }
  .provenance dl { margin: 0; font-family: var(--font-mono); font-size: var(--t-label); }
  .provenance div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--space-md); padding: 0.15rem 0; }
  .provenance dt { color: var(--ink-muted); }
  .provenance dd { margin: 0; }

  @media (max-width: 640px) {
    .screen { padding-inline: 0; }
    .screen-bar, .log { border-inline: 0; }
    /* A phone cannot hold 80 columns. Wrap, and hang the continuation so
       each line of the capture still starts at the left edge. */
    .log { font-size: 0.75rem; padding-inline: var(--space-sm); white-space: pre-wrap; overflow-wrap: anywhere; }
    .log :global(.ln) { padding-left: 2ch; text-indent: -2ch; }
    .provenance div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
