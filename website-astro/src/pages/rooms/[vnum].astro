---
import Base from '../../layouts/Base.astro';
import { rooms, roomById, type RoomRecord } from '../../lib/rooms';
import { sectorName } from '../../lib/zones';

export function getStaticPaths() {
  return rooms.map((room) => ({ params: { vnum: String(room.id) }, props: { room } }));
}

interface Props { room: RoomRecord }
const { room } = Astro.props;
const jsonUrl = `/rooms/${room.id}.json`;
const exitCount = room.exits.length;
const description = `${room.name}, a room in ${room.zoneName} (zone ${room.zoneId}) in the Dark Pawns world files.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: room.name,
  description: room.description || room.name,
  identifier: { '@type': 'PropertyValue', propertyID: 'Dark Pawns room VNUM', value: String(room.id) },
  isPartOf: { '@type': 'VideoGame', name: 'Dark Pawns', url: 'https://darkpawns.labz0rz.com/' },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Zone', value: `${room.zoneName} (${room.zoneId})` },
    { '@type': 'PropertyValue', name: 'Sector', value: sectorName(room.sector) },
    { '@type': 'PropertyValue', name: 'Exits', value: room.exits.map((exit) => exit.direction).join(', ') || 'none' },
  ],
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Map', item: new URL('/map/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Zones', item: new URL('/zones/', Astro.site) },
    { '@type': 'ListItem', position: 3, name: room.zoneName, item: new URL(`/zones/${room.zoneId}/`, Astro.site) },
    { '@type': 'ListItem', position: 4, name: room.name, item: new URL(`/rooms/${room.id}/`, Astro.site) },
  ],
};
const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const safeBreadcrumbLd = JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c');
const targetName = (vnum: number) => roomById.get(vnum)?.name ?? null;
---

<Base title={`${room.name} | Room ${room.id} | Dark Pawns`} {description} ogType="article">
  <Fragment slot="head">
    <link rel="alternate" type="application/json" href={jsonUrl} title={`${room.name} as JSON`} />
    <script type="application/ld+json" set:html={safeJsonLd}></script>
    <script type="application/ld+json" set:html={safeBreadcrumbLd}></script>
  </Fragment>

  <article class="record-page container">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/map/">Map</a> / <a href="/zones/">Zones</a> / <a href={`/zones/${room.zoneId}/`}>{room.zoneName}</a> / {room.id}
    </nav>
    <header class="record-header">
      <p class="eyebrow">Room record / VNUM {room.id}</p>
      <h1>{room.name}</h1>
      <p class="record-lede">
        {room.zoneName} / {sectorName(room.sector)} / {exitCount} {exitCount === 1 ? 'exit' : 'exits'}.
        <a href={`/map/?room=${room.id}`}>Show on the interactive map</a>
        (<a href={jsonUrl}>JSON record</a>)
      </p>
    </header>
    <div class="record-body">
      <div>
        <section class="record-panel">
          <h2>Description</h2>
          {room.description.trim() ? (
            <p class="record-description">{room.description}</p>
          ) : <p class="record-empty">No description recorded in the world files.</p>}
        </section>

        <section class="record-panel">
          <h2>Exits</h2>
          {room.exits.length ? (
            <ul class="record-list">
              {room.exits.map((exit) => (
                <li>
                  {roomById.has(exit.target)
                    ? <a href={`/rooms/${exit.target}/`}>{exit.direction}</a>
                    : <span>{exit.direction}</span>}
                  <small>{targetName(exit.target) ?? `Room ${exit.target}`}</small>
                </li>
              ))}
            </ul>
          ) : <p class="record-empty">No exits recorded.</p>}
        </section>
      </div>

      <div>
        {room.shopkeepers.length > 0 && (
          <section class="record-panel">
            <h2>Shops here</h2>
            <ul class="record-list">
              {room.shopkeepers.map((shop) => (
                <li><a href={`/mobs/${shop.vnum}/`}>{shop.name}</a><small>Open {shop.openHours}</small></li>
              ))}
            </ul>
          </section>
        )}

        {room.mobs.length > 0 && (
          <section class="record-panel">
            <h2>Mobs here ({room.mobs.length})</h2>
            <ul class="record-list">
              {room.mobs.map((mob) => (
                <li><a href={`/mobs/${mob.vnum}/`}>{mob.name}</a><small>VNUM {mob.vnum} / level {mob.level}</small></li>
              ))}
            </ul>
          </section>
        )}

        {room.items.length > 0 && (
          <section class="record-panel">
            <h2>Items here ({room.items.length})</h2>
            <ul class="record-list">
              {room.items.map((item) => (
                <li><a href={`/items/${item.vnum}/`}>{item.name}</a><small>VNUM {item.vnum}</small></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    <footer class="record-source">
      <p>This page is generated from the world files used by the current Dark Pawns server.</p>
      <p><a href={`/zones/${room.zoneId}/`}>Return to {room.zoneName}</a></p>
    </footer>
  </article>
</Base>

<style>
  .record-page { max-width: 68rem; padding-block: var(--space-lg) var(--space-xl); }
  .crumb { color: var(--ink-muted); font-family: var(--font-mono); font-size: .72rem; margin-bottom: var(--space-lg); }
  .record-header { border-top: 4px solid var(--accent); padding-top: var(--space-md); }
  .eyebrow { color: var(--accent); font-family: var(--font-mono); font-size: .72rem; font-weight: 700; letter-spacing: .1em; margin-bottom: var(--space-xs); text-transform: uppercase; }
  .record-header h1 { max-width: 24ch; font-size: clamp(2rem, 4.5vw, 3.5rem); overflow-wrap: anywhere; }
  .record-lede { color: var(--ink-muted); }
  .record-body { display: grid; grid-template-columns: minmax(0, 1.28fr) minmax(16rem, .72fr); gap: var(--space-xl); border-top: 1px solid var(--rule); margin-top: var(--space-lg); padding-top: var(--space-lg); }
  .record-source { border-top: 1px solid var(--rule); color: var(--ink-muted); font-size: .9rem; margin-top: var(--space-xl); padding-top: var(--space-md); }
  .record-source p { margin-bottom: var(--space-xs); }
  @media (max-width: 760px) {
    .record-page { padding-inline: var(--space-md); }
    .record-body { grid-template-columns: 1fr; gap: var(--space-lg); }
  }
</style>
<style is:global>
  .record-panel { border-top: 3px solid var(--rule); padding-top: var(--space-md); }
  .record-panel + .record-panel { margin-top: var(--space-lg); }
  .record-panel h2 { font-size: 1.35rem; }
  .record-list { list-style: none; margin: 0; padding: 0; }
  .record-list li { border-top: 1px solid var(--rule); padding-block: .45rem; }
  .record-list small { color: var(--ink-muted); display: block; font-family: var(--font-mono); font-size: .68rem; }
  .record-empty { color: var(--ink-muted); font-style: italic; }
  .record-description { white-space: pre-line; }
</style>
