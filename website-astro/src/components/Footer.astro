---
// Footer — kept close to the Hugo version (Zach likes it). The Dark Pawns
// description will migrate up into the home callout in a later pass.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <h2>Play &amp; Explore</h2>
      <ul>
        <li><a href="/play/">Play In-Browser</a></li>
        <li><a href="/map/">Interactive World Map</a></li>
        <li><a href="/help/">Help Index</a></li>
        <li><a href="/world/lore/">World Lore</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2>Research &amp; Code</h2>
      <ul>
        <li><a href="/research/">AI Agent Research</a></li>
        <li><a href="/docs/">Developer Docs</a></li>
        <li><a href="https://github.com/zax0rz/darkpawns">GitHub Repository</a></li>
        <li><a href="/credits/">Credits &amp; Staff</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2>Historic Resources</h2>
      <ul>
        <li><a href="https://web.archive.org/web/20040803063038/http://www.dp-players.com/">dp-players.com (2004)</a></li>
        <li><a href="https://www.darkpawns.net/">darkpawns.net (revival)</a></li>
        <li><a href="https://www.circlemud.org/">CircleMUD Engine</a></li>
        <li><a href="https://www.mudlet.org/">Mudlet Desktop Client</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom container">
    <p class="footer-wordmark">DARK PAWNS · EST. 1994 · RESURRECTED 2026</p>
    <div class="footer-bottom-info">
      <span class="status" id="footer-status" title="MUD server status">
        <span class="dot" aria-hidden="true"></span><span id="footer-status-text">checking status</span>
      </span>
      <p>Released under the MIT &amp; CircleMUD Licenses · &copy; {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 2px solid var(--rule); margin-top: var(--space-xl); padding-top: var(--space-lg); }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .footer-col h2 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 var(--space-sm);
  }
  .footer-col p { color: var(--ink-muted); font-size: 0.95rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { padding: 0.15rem 0; }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
    margin-top: var(--space-lg);
    padding-block: var(--space-md) var(--space-lg);
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    margin: 0;
  }
  .footer-bottom-info { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }
  .footer-bottom-info p { margin: 0; color: var(--ink-muted); font-size: 0.85rem; }
  .status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
  }
  .status .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--ink-muted); }

  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
