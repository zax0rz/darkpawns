---
// Footer — kept close to the Hugo version (Zach likes it). The Dark Pawns
// description will migrate up into the home callout in a later pass.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <h2>Play &amp; Explore</h2>
      <ul>
        <li><a href="/play/">Play In-Browser</a></li>
        <li><a href="/map/">Interactive World Map</a></li>
        <li><a href="/database/">Mob &amp; Item Database</a></li>
        <li><a href="/zones/">Zone Records</a></li>
        <li><a href="/help/">Help Index</a></li>
        <li><a href="/world/">The World</a></li>
        <li><a href="https://www.mudlet.org/">Mudlet Desktop Client</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2>The Archive</h2>
      <ul>
        <li><a href="/archive/">Community Archive</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="https://web.archive.org/web/20040803063038/http://www.dp-players.com/">dp-players.com (2004)</a></li>
        <li><a href="https://www.darkpawns.net/">darkpawns.net (revival)</a></li>
        <li><a href="https://www.circlemud.org/">CircleMUD Lineage</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h2>About &amp; Code</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/download/">Download &amp; Host</a></li>
        <li><a href="/docs/">Developer Docs</a></li>
        <li><a href="/docs/research/">Port Research</a></li>
        <li>
          <a class="footer-github-link" href="https://github.com/zax0rz/darkpawns">
            <svg class="footer-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
            <span>GitHub Repository</span>
          </a>
        </li>
        <li><a href="/credits/">Credits &amp; Staff</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom container">
    <p class="footer-wordmark">DARK PAWNS · EST. 1994 · RESURRECTED 2026</p>
    <div class="footer-bottom-info">
      <span class="status" id="footer-status" data-server-status title="MUD server status" aria-live="polite">
        <span class="dot" aria-hidden="true"></span><span id="footer-status-text" data-server-status-text>status unknown</span>
      </span>
      <a class="footer-social-badge" href="https://github.com/zax0rz/darkpawns" aria-label="Dark Pawns on GitHub" title="zax0rz/darkpawns on GitHub">
        <svg class="footer-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span>GitHub</span>
      </a>
      <p>Non-commercial · <a href="https://github.com/zax0rz/darkpawns/blob/main/LICENSE">DikuMUD, CircleMUD &amp; MIT Licenses</a> · &copy; {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 2px solid var(--rule); margin-top: var(--space-xl); padding-top: var(--space-lg); }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .footer-col h2 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 var(--space-sm);
  }
  .footer-col p { color: var(--ink-muted); font-size: 0.95rem; }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { padding: 0.15rem 0; }
  .footer-github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }
  .footer-icon {
    flex-shrink: 0;
    color: var(--ink-muted);
    transition: color 0.15s ease;
  }
  .footer-github-link:hover .footer-icon,
  .footer-social-badge:hover .footer-icon {
    color: var(--accent);
  }
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    border-top: 1px solid var(--rule);
    margin-top: var(--space-lg);
    padding-block: var(--space-md) var(--space-lg);
  }
  .footer-wordmark {
    font-family: var(--font-display);
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    margin: 0;
  }
  .footer-bottom-info { display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }
  .footer-bottom-info p { margin: 0; color: var(--ink-muted); font-size: 0.85rem; }
  .footer-social-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--rule);
    background: var(--paper-deep);
    text-decoration: none;
  }
  .footer-social-badge:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
  }
  /* Default is the unresolved state: muted until /health answers. Online and
     offline follow the dot convention the play client already uses. */
  .status .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--ink-muted); }
  .status.online .dot { background: var(--online); }
  .status.offline .dot { background: var(--accent); }

  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
