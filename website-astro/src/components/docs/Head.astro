---
import Head from '@astrojs/starlight/components/Head.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
---
<Head />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<link rel="alternate" type="text/markdown" href={`${path}.md`} title="Read as Markdown" />
