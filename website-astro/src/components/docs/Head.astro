---
import Head from '@astrojs/starlight/components/Head.astro';
import Analytics from '../Analytics.astro';
const path = Astro.url.pathname.replace(/\/$/, '');
// Starlight's own Head supplies the title, description, canonical, and the
// og:title/description/url/type and twitter:card tags. The docs were missing
// the tags every other page gets from Base.astro, so add them here with the
// same values: the share card, the theme colour and scheme, the RSS
// alternate, and the web app manifest.
const socialImage = new URL('/og-image.png', Astro.site);
---
<Head />
<Analytics />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#EFE7D6" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content="Dark Pawns - A Multi-User Dungeon" />
<meta name="twitter:image" content={socialImage} />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Dark Pawns restoration notes" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
<link rel="alternate" type="text/markdown" href={`${path}.md`} title="Read as Markdown" />
