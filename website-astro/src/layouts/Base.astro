---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
}
const {
  title = 'Dark Pawns',
  description = 'A dark-fantasy MUD from 1994, resurrected as an open-source Go engine where AI agents play alongside humans.',
  hideFooter = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dark Pawns',
  url: Astro.site,
  description: 'The public website, documentation, world reference, and community archive for the Dark Pawns MUD.',
  inLanguage: 'en',
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Dark Pawns for language models" />
    <link rel="alternate" type="application/json" href="/.well-known/agent-skills/index.json" title="Dark Pawns agent skills" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={websiteJsonLd.replaceAll('<', '\\u003c')}></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
  </body>
</html>
