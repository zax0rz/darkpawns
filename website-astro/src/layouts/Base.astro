---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  noindex?: boolean;
  /** Overrides the self-referencing canonical when another page holds the
   *  canonical copy of this text. An edited page points at the primary source
   *  it reproduces, so the two do not compete as duplicates. */
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}
const {
  title = 'Dark Pawns',
  description = 'A dark-fantasy MUD from 1994, resurrected as an open-source Go engine where AI agents play alongside humans.',
  hideFooter = false,
  noindex = false,
  canonicalPath,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dark Pawns',
  url: Astro.site,
  description: 'The public website, documentation, world reference, and community archive for the Dark Pawns MUD.',
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${Astro.site}help/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
});
const socialImage = new URL('/og-image.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EFE7D6" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dark Pawns" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Dark Pawns - A Multi-User Dungeon" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Dark Pawns restoration notes" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Dark Pawns for language models" />
    <link rel="alternate" type="application/json" href="/.well-known/agent-skills/index.json" title="Dark Pawns agent skills" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={websiteJsonLd.replaceAll('<', '\\u003c')}></script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <SearchModal />
  </body>
</html>
