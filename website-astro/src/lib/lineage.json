    {
      "id": "circle",
      "title": "Jeremy Elson: the history of CircleMUD",
      "url": "https://www.circlemud.org/general.html",
      "note": "Diku ancestry, the original Circle game, and the first public release, CircleMUD 2.0."
    },
    {
      "id": "dp",
      "title": "Frontline: a brief history of Dark Pawns",
      "url": "/archive/history/",
      "note": "Records CircleMUD 1.7 in 1994, 2.2 in December 1995, 3.0pl9 in March 1996, and 3.0pl11 in June 1996."
    },
    {
      "id": "code",
      "title": "Dark Pawns: surviving C credits",
      "url": "https://github.com/zax0rz/darkpawns/blob/42d7252f1722085bea89b5d9ce5e8694d820450f/lib/text/credits",
