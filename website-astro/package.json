{
  "name": "darkpawns-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm run generate:docs && astro dev",
    "generate:project": "python3 scripts/project_activity.py",
    "generate:search": "python3 scripts/gen_search_index.py",
    "build": "npm run generate:docs && npm run generate:project && npm run generate:search && astro build && npm run test:docs",
    "preview": "astro preview",
    "astro": "astro",
    "voice-lint": "python3 scripts/voice_lint.py",
    "test:voice-lint": "python3 -m unittest scripts/test_voice_lint.py",
    "test:search": "python3 -m unittest scripts/test_gen_search_index.py",
    "test:markdown": "node --test src/lib/no-literal-autolinks.test.mjs src/lib/world-text.test.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "test:docs": "node scripts/check-docs.mjs && node scripts/check-command-docs.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "0.42.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.2.2",
    "linkedom": "0.18.12",
    "mermaid": "12.2.0",
    "playwright": "1.58.2",
    "starlight-openapi": "0.27.0",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
