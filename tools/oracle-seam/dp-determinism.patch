+/*
+ * Handle the deterministic-clock control line before normal command queuing.
+ * This keeps the primitive draw-neutral and avoids command history, aliases,
+ * wait-state, and command_interpreter side effects.
+ *
+ * The control only QUEUES its pulses. The game loop runs them at its normal
+ * heartbeat phase (see game_loop), never here: a pumped heartbeat can close a
+ * descriptor (an idle force-rent), and process_input() must not still own the
+ * iterator that describes it when that happens.
+ */
+int process_dpclock_control(char *input)
+{
+  char command[16], action[16], extra[2];
+  unsigned long count;
+
+  if (!dp_clock)
+    return 0;
+
+  if (sscanf(input, "%15s %15s %lu %1s",
+      command, action, &count, extra) != 3)
+    return 0;
+  if (strcmp(command, "~dpclock") || strcmp(action, "pulse"))
+    return 0;
+  if (count == 0 || count > DP_CLOCK_MAX_PENDING)
+    return 0;
+  if (count > DP_CLOCK_MAX_PENDING - dp_pending_pulses)
+    return 0;           /* the queue is full: refuse it, never wrap */
+
+  dp_pending_pulses += count;
+
+  return 1;
+}
+
+/*
+ * Take one queued pulse, if any. The game loop's heartbeat phase drains the
+ * queue through this, exactly once per queued pulse.
+ */
+int dp_seam_take(void)
+{
+  if (!dp_pending_pulses)
+    return 0;
+
+  dp_pending_pulses--;
+
+  return 1;
+}
+
+/*
+ * Self-test for the deterministic-clock seam. DP_SEAM_SELFTEST=1 makes the
+ * binary print a fixed set of observations and exit before booting, so the
+ * queue contract is exercised against the shipped code without a world or a
+ * game loop:
+ *
+ *   control-queues      a valid control queues exactly its count and leaves
+ *                       `pulse` untouched, which is only possible if no
+ *                       heartbeat ran inside input processing;
+ *   drain-once          the drain primitive yields the queued count exactly
+ *                       once and empties the queue;
+ *   overflow-rejected   a control that would push the queue past
+ *                       DP_CLOCK_MAX_PENDING is refused and the total never
+ *                       wraps;
+ *   normal-mode-refused without DP_CLOCK the same line is ordinary input and
+ *                       the queue stays empty;
+ *   invalid-refused     malformed and out-of-range controls are ordinary
+ *                       input too.
+ *
+ * Returns 0 when the self-test was not requested (the process keeps booting).
+ */
+int dp_seam_selftest(void)
+{
+  static const char *invalid[] = {
+    "~dpclock pulse 0",
+    "~dpclock pulse 100001",
+    "~dpclock pulse",
+    "~dpclock pulse 630 extra",
+    "dpclock pulse 630",
+    "~dpclock pause 630",
+    "~dpclock pulse 12x",
+  };
+  unsigned long start_pulse, queued, drained;
+  unsigned int i, accepted = 0;
+  int failed = 0;
+
+  if (!getenv("DP_SEAM_SELFTEST"))
+    return 0;
+
+  /* init_game owns this flag in a real run; the self-test runs before it. */
+  dp_clock = 1;
+  start_pulse = pulse;
+
+  /* Two controls in one input pass accumulate; neither pumps a heartbeat. */
+  if (!process_dpclock_control("~dpclock pulse 630") ||
+      !process_dpclock_control("~dpclock pulse 630"))
+    failed = 1;
+  queued = dp_pending_pulses;
+  if (pulse != start_pulse || queued != 1260)
+    failed = 1;
+  printf("dp-seam-selftest: control-queues queued=%lu heartbeats=%lu\n",
+      queued, pulse - start_pulse);
+
+  /* The drain primitive the game loop uses yields the queue once. */
+  drained = 0;
+  while (dp_seam_take()) {
+    pulse++;
+    drained++;
+  }
+  if (drained != queued || dp_pending_pulses != 0 || dp_seam_take())
+    failed = 1;
+  printf("dp-seam-selftest: drain-once drained=%lu pending=%lu\n",
+      drained, dp_pending_pulses);
+  pulse = start_pulse;
+
+  /* Filling the queue, then refusing the control that would overflow it. */
+  if (!process_dpclock_control("~dpclock pulse 100000") ||
+      process_dpclock_control("~dpclock pulse 1") ||
+      dp_pending_pulses != DP_CLOCK_MAX_PENDING)
+    failed = 1;
+  printf("dp-seam-selftest: overflow-rejected pending=%lu\n",
+      dp_pending_pulses);
+  dp_pending_pulses = 0;
+
+  /* Without DP_CLOCK the control line is ordinary input. */
+  dp_clock = 0;
+  if (process_dpclock_control("~dpclock pulse 630") || dp_pending_pulses != 0)
+    failed = 1;
+  printf("dp-seam-selftest: normal-mode-refused pending=%lu\n",
+      dp_pending_pulses);
+  dp_clock = 1;
+
+  /* Malformed and out-of-range controls are ordinary input as well. */
+  for (i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++)
+    if (process_dpclock_control((char *) invalid[i]))
+      accepted++;
+  if (accepted != 0 || dp_pending_pulses != 0 || pulse != start_pulse)
+    failed = 1;
+  printf("dp-seam-selftest: invalid-refused accepted=%u\n", accepted);
+
+  printf("dp-seam-selftest: result=%s\n", failed ? "fail" : "ok");
+  exit(failed ? 1 : 0);
+}
+
