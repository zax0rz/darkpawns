+/*
+ * Handle the deterministic-clock control line before normal command queuing.
+ * This keeps the primitive draw-neutral and avoids command history, aliases,
+ * wait-state, and command_interpreter side effects.
+ */
+int process_dpclock_control(char *input)
+{
+  char command[16], action[16], extra[2];
+  unsigned long count;
+
+  if (!dp_clock)
+    return 0;
+
+  if (sscanf(input, "%15s %15s %lu %1s",
+      command, action, &count, extra) != 3)
+    return 0;
+  if (strcmp(command, "~dpclock") || strcmp(action, "pulse"))
+    return 0;
+  if (count == 0 || count > 100000)
+    return 0;
+
+  while (count--)
+    heartbeat(++pulse);
+
+  return 1;
+}
